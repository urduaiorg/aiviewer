---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { siteConfig } from '../../data/site.config';

const updated = 'June 22, 2026';
---

<BaseLayout
  title="Terms of Use"
  description="Terms of use for AIViewer.ai content, reviews, tools, advertising, and affiliate links."
>
  <Header />

  <section class="border-b border-zinc-200/70 bg-white dark:border-zinc-800 dark:bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Terms of Use' }]} />
      <div class="max-w-3xl" data-reveal>
        <span class="inline-flex items-center rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400">
          Legal
        </span>
        <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">Terms of Use</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
          These terms govern your use of AIViewer.ai. By using the site, you agree to them.
        </p>
        <p class="mt-4 text-sm text-zinc-400">Last updated: {updated}</p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <article class="mx-auto max-w-3xl rounded-[var(--radius-lg)] border border-zinc-200 bg-white p-7 leading-8 text-zinc-600 shadow-[var(--shadow-card)] dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 md:p-9" data-reveal>
        <h2 class="text-zinc-950 dark:text-zinc-50">Editorial Information, Not Professional Advice</h2>
        <p class="mt-4">
          AIViewer.ai publishes educational and editorial content about AI tools, workflows, and industry trends. Content is provided for general information and should not be treated as legal, financial, medical, security, or professional advice.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Accuracy and Updates</h2>
        <p class="mt-4">
          We work to keep content accurate, but AI tools, prices, terms, and model capabilities change quickly. You should verify important details with the provider before buying, deploying, or relying on a tool.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">External Links</h2>
        <p class="mt-4">
          AIViewer.ai links to third-party websites. We do not control those sites and are not responsible for their content, privacy practices, pricing, availability, or policies.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Advertising and Affiliate Links</h2>
        <p class="mt-4">
          The site may display ads, sponsorships, or affiliate links. We may earn revenue when readers click or buy through certain links. Advertising and affiliate relationships do not transfer responsibility for third-party products to AIViewer.ai.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Acceptable Use</h2>
        <p class="mt-4">
          Do not misuse the site, attempt to disrupt it, scrape it in ways that harm availability, upload malicious content, impersonate others, or use the site to violate laws or third-party rights.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Contact</h2>
        <p class="mt-4">
          For questions about these terms, contact <a href={`mailto:${siteConfig.monetization.contactEmail}`} class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400">{siteConfig.monetization.contactEmail}</a>.
        </p>
      </article>
    </div>
  </section>

  <Footer />
</BaseLayout>
