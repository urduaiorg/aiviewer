---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Download The 2026 Ultimate AI Prompt Cheat Sheet | AIViewer";
const description = "Get the exact, battle-tested AI frameworks used by senior engineers, marketers, and founders to extract maximum value from Claude 4.6 and ChatGPT-5.4.";
---

<BaseLayout title={title} description={description}>
  <style>
    @reference "../styles/global.css";
    
    /* Custom animations for the form */
    @keyframes checkmark {
      0% { stroke-dashoffset: 50px; opacity: 0; }
      100% { stroke-dashoffset: 0; opacity: 1; }
    }
    .animate-checkmark {
      stroke-dasharray: 50px;
      stroke-dashoffset: 50px;
      animation: checkmark 0.6s ease-in-out forwards 0.2s;
    }
  </style>

  <main class="relative min-h-[85vh] flex items-center justify-center py-20 overflow-hidden">
    <!-- Background Gradients -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-indigo-500/10 dark:bg-indigo-500/5 blur-[120px]"></div>
      <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-blue-500/10 dark:bg-blue-500/5 blur-[120px]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Column: Copy & Value Proposition -->
        <div class="lg:col-span-6 lg:pr-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-xs font-bold tracking-widest uppercase mb-6 border border-indigo-100 dark:border-indigo-800/50">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
            </span>
            100% Free Resource
          </div>
          
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-white tracking-tight leading-[1.1] mb-6">
            The 2026 Ultimate <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-blue-600 dark:from-indigo-400 dark:to-blue-400">AI Prompt</span> Cheat Sheet
          </h1>
          
          <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed mb-8 max-w-2xl">
            Stop copying and pasting generic prompts. Get the exact, battle-tested frameworks used by senior engineers, marketers, and founders to extract maximum value from <strong>Claude Opus 4.6</strong> and <strong>ChatGPT-5.4</strong>.
          </p>
          
          <ul class="space-y-5 mb-10">
            {[
              "10 ready-to-use, high-ROI prompt templates.",
              "Advanced frameworks for code review, data analysis, and marketing.",
              "Designed specifically for the newest 2026 frontier models.",
              "Instantly boost your daily productivity and output quality."
            ].map((benefit) => (
              <li class="flex items-start gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center mt-0.5">
                  <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-zinc-700 dark:text-zinc-300 font-medium">{benefit}</span>
              </li>
            ))}
          </ul>
          
          <div class="flex items-center gap-4 text-sm text-zinc-500 dark:text-zinc-500 font-medium">
            <div class="flex -space-x-2">
              <img class="w-8 h-8 rounded-full border-2 border-white dark:border-zinc-950" src="https://i.pravatar.cc/100?img=1" alt="User" width="32" height="32" loading="lazy" />
              <img class="w-8 h-8 rounded-full border-2 border-white dark:border-zinc-950" src="https://i.pravatar.cc/100?img=2" alt="User" width="32" height="32" loading="lazy" />
              <img class="w-8 h-8 rounded-full border-2 border-white dark:border-zinc-950" src="https://i.pravatar.cc/100?img=3" alt="User" width="32" height="32" loading="lazy" />
              <div class="w-8 h-8 rounded-full border-2 border-white dark:border-zinc-950 bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-[0.65rem] text-zinc-600 dark:text-zinc-400 font-bold">
                +10k
              </div>
            </div>
            <span>Downloaded by 10,000+ professionals</span>
          </div>
        </div>

        <!-- Right Column: The Squeeze Form -->
        <div class="lg:col-span-6 flex justify-center lg:justify-end mt-10 lg:mt-0">
          <div class="w-full max-w-md bg-white dark:bg-zinc-900 rounded-[2rem] p-8 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] dark:shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)] border border-zinc-200 dark:border-zinc-800 relative overflow-hidden group">
            
            <!-- Subtle card gradient -->
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 to-transparent dark:from-indigo-900/10 pointer-events-none" aria-hidden="true"></div>
            
            <div class="relative z-10">
              <div id="form-container">
                <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-2 text-center">Where should we send it?</h3>
                <p class="text-sm text-zinc-500 dark:text-zinc-400 text-center mb-8">Enter your email below to get instant access to the cheat sheet.</p>
                
                <form id="lead-magnet-form" class="flex flex-col gap-4">
                  <div>
                    <label for="name" class="sr-only">First Name</label>
                    <div class="relative">
                      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                      </div>
                      <input 
                        type="text" 
                        name="name" 
                        id="name" 
                        placeholder="First Name (optional)" 
                        class="block w-full pl-11 pr-4 py-3.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-600 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all shadow-sm"
                      />
                    </div>
                  </div>

                  <div>
                    <label for="email" class="sr-only">Email Address</label>
                    <div class="relative">
                      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                      </div>
                      <input 
                        type="email" 
                        name="email" 
                        id="email" 
                        required 
                        placeholder="Work Email Address" 
                        class="block w-full pl-11 pr-4 py-3.5 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-600 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all shadow-sm"
                      />
                    </div>
                  </div>

                  <button 
                    type="submit" 
                    id="submit-btn"
                    class="w-full mt-2 py-4 px-6 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-[0_0_20px_rgba(79,70,229,0.3)] hover:shadow-[0_0_25px_rgba(79,70,229,0.5)] transition-all duration-200 flex items-center justify-center gap-2 active:scale-[0.98]"
                  >
                    <span id="btn-text">Get The Free Cheat Sheet</span>
                    <svg id="btn-icon" class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                    <svg id="btn-spinner" class="w-5 h-5 animate-spin hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </button>

                  <p class="text-xs text-center text-zinc-400 dark:text-zinc-500 mt-3">
                    By downloading, you agree to our <a href="#" class="underline hover:text-zinc-700 dark:hover:text-zinc-300">Privacy Policy</a>. No spam, ever.
                  </p>
                </form>
              </div>

              <!-- Success State (Hidden by default) -->
              <div id="success-container" class="hidden flex-col items-center justify-center py-8 text-center">
                <div class="w-20 h-20 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mb-6">
                  <svg class="w-10 h-10 text-green-600 dark:text-green-400 animate-checkmark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" opacity="0" class="animate-checkmark" />
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">You're All Set!</h3>
                <p class="text-zinc-600 dark:text-zinc-400 mb-6">Your download should start automatically. If it doesn't, click the button below.</p>
                
                <a 
                  href="/assets/2026-ultimate-ai-prompt-cheat-sheet.md" 
                  download="2026-Ultimate-AI-Prompt-Cheat-Sheet.md"
                  class="inline-flex items-center justify-center px-6 py-3 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-sm font-semibold rounded-xl hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors shadow-md"
                >
                  <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  Download Manually
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // Lead capture form — subscribes to Beehiiv + triggers download
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('lead-magnet-form');
    const formContainer = document.getElementById('form-container');
    const successContainer = document.getElementById('success-container');

    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const btnSpinner = document.getElementById('btn-spinner');
    const submitBtn = document.getElementById('submit-btn');

    const BEEHIIV_FORM_ID = 'df762eb2-5183-49d6-bb1e-fafb3683f2e0';

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const emailInput = form.querySelector<HTMLInputElement>('[name=email]');
        const email = emailInput?.value?.trim();
        if (!email) return;

        // 1. Show loading state
        if(btnText) btnText.textContent = "Processing...";
        if(btnIcon) btnIcon.classList.add('hidden');
        if(btnSpinner) btnSpinner.classList.remove('hidden');
        if(submitBtn) (submitBtn as HTMLButtonElement).disabled = true;

        // 2. Subscribe via Beehiiv embed endpoint (hidden iframe POST)
        try {
          const beehiivFrame = document.createElement('iframe');
          beehiivFrame.name = 'beehiiv-subscribe';
          beehiivFrame.style.display = 'none';
          document.body.appendChild(beehiivFrame);

          const beehiivForm = document.createElement('form');
          beehiivForm.method = 'POST';
          beehiivForm.action = `https://subscribe-forms.beehiiv.com/${BEEHIIV_FORM_ID}`;
          beehiivForm.target = 'beehiiv-subscribe';

          const emailField = document.createElement('input');
          emailField.type = 'hidden';
          emailField.name = 'email';
          emailField.value = email;
          beehiivForm.appendChild(emailField);

          const utmSource = document.createElement('input');
          utmSource.type = 'hidden';
          utmSource.name = 'utm_source';
          utmSource.value = 'aiviewer-download';
          beehiivForm.appendChild(utmSource);

          document.body.appendChild(beehiivForm);
          beehiivForm.submit();

          // Clean up after submission
          setTimeout(() => {
            beehiivForm.remove();
            beehiivFrame.remove();
          }, 3000);
        } catch {
          // Subscription failed silently — still deliver the download
        }

        // 3. Show success state + trigger download (don't block on subscription)
        setTimeout(() => {
          if(formContainer) formContainer.classList.add('hidden');
          if(successContainer) {
            successContainer.classList.remove('hidden');
            successContainer.classList.add('flex');
          }

          // Trigger the download automatically
          const downloadLink = document.createElement('a');
          downloadLink.href = '/assets/2026-ultimate-ai-prompt-cheat-sheet.md';
          downloadLink.download = '2026-Ultimate-AI-Prompt-Cheat-Sheet.md';
          document.body.appendChild(downloadLink);
          downloadLink.click();
          document.body.removeChild(downloadLink);
        }, 800);
      });
    }
  });
</script>
