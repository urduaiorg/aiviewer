---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { shouldNoindexPath } from '../utils/indexPolicy';
---
<BaseLayout title="Free AI Prompt Template Pack" description="Download 10 editable prompt templates for learning and work, with no email required." noindex={shouldNoindexPath(Astro.url.pathname)}>
  <Header slot="header" />
  <section class="page-container py-12 md:py-20">
    <div class="mx-auto max-w-2xl rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 md:p-10">
      <p class="text-sm font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-300">Free learning resource</p>
      <h1 class="mt-4 text-zinc-950 dark:text-white">AI prompt template pack</h1>
      <p class="mt-5 text-lg leading-8 text-zinc-600 dark:text-zinc-300">Download 10 editable templates for tasks such as code review, lesson planning, research and data analysis. No email or account is required.</p>
      <a href="/assets/2026-ultimate-ai-prompt-cheat-sheet.md" download="AIViewer-Prompt-Templates.md" class="mt-8 inline-flex min-h-12 items-center rounded-xl bg-indigo-700 px-6 py-3 font-semibold text-white hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600">Download the template pack</a>
      <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">Markdown text file. Open it in any text editor.</p>
      <h2 class="mt-10 text-2xl text-zinc-950 dark:text-white">Use one template on a small task</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-6 text-zinc-700 dark:text-zinc-300">
        <li>Replace every placeholder with your task, intended reader and constraints.</li>
        <li>Start with public or fictional material that is safe to share.</li>
        <li>Compare the answer with the input and correct omissions, unsupported claims and calculations.</li>
      </ol>
      <p class="mt-6 text-zinc-600 dark:text-zinc-300">The templates are starting points. Work through <a href="/guides/how-to-verify-an-ai-answer/" class="font-semibold underline">how to verify an AI answer</a> before relying on an output.</p>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
