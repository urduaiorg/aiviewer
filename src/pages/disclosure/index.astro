---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { siteConfig } from '../../data/site.config';

const updated = 'July 25, 2026';
---

<BaseLayout
  title="Advertising and Affiliate Disclosure"
  description="AIViewer.ai disclosure policy for Google ads, affiliate links, sponsorships, related products, and editorial independence."
>
  <Header slot="header" />

  <section class="border-b border-zinc-200/70 bg-white dark:border-zinc-800 dark:bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Disclosure' }]} />
      <div class="max-w-3xl" data-reveal>
        <span class="inline-flex items-center rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400">
          Disclosure
        </span>
        <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">Advertising and affiliate disclosure.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
          AIViewer.ai may earn money from ads, sponsorships, and affiliate links. This page explains how that works and how we protect editorial trust.
        </p>
        <p class="mt-4 text-sm text-zinc-400">Last updated: {updated}</p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <article class="mx-auto max-w-3xl rounded-[var(--radius-lg)] border border-zinc-200 bg-white p-7 leading-8 text-zinc-600 shadow-[var(--shadow-card)] dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 md:p-9" data-reveal>
        <h2 class="text-zinc-950 dark:text-zinc-50">Display Advertising</h2>
        <p class="mt-4">
          AIViewer.ai may display ads served by Google AdSense or other advertising partners on eligible editorial pages. Ads help fund free access to lessons, signals, and practical guides. Embedded YouTube videos may also contain advertising controlled by YouTube or the video owner.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Affiliate Links</h2>
        <p class="mt-4">
          Some outbound links may be affiliate links. If you click an affiliate link and make a purchase, AIViewer.ai may earn a commission at no extra cost to you. Affiliate links are marked with sponsored link attributes where appropriate.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Sponsored Content</h2>
        <p class="mt-4">
          Sponsored placements are labeled. Sponsored content may be produced in collaboration with a partner, but it must still be useful, clear, and relevant to AIViewer readers.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Owned and Related Products</h2>
        <p class="mt-4">
          AIViewer.ai may cover products built by the same founder-led ecosystem, including Impact Glocal Inc. products such as OurScreen. When we cover an owned or related product, we disclose that relationship on the page so readers can evaluate the context.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Editorial Independence</h2>
        <p class="mt-4">
          Payment does not guarantee favorable coverage or placement. AIViewer does not currently publish numerical tool ratings. Our editorial goal is to help readers understand and use AI with better evidence, and we disclose commercial relationships so readers can evaluate the context.
        </p>

        <h2 class="mt-9 text-zinc-950 dark:text-zinc-50">Questions</h2>
        <p class="mt-4">
          For questions about sponsorships, affiliate relationships, or ad placements, contact <a href={`mailto:${siteConfig.monetization.contactEmail}`} class="font-medium text-indigo-600 underline underline-offset-2 dark:text-indigo-400">{siteConfig.monetization.contactEmail}</a>.
        </p>
      </article>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
