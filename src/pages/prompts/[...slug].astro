---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import AuthorBio from '../../components/content/AuthorBio.astro';

export async function getStaticPaths() {
  const entries = await getCollection('prompts');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Prompts', url: '/prompts/' },
  { name: entry.data.title, url: `/prompts/${entry.id}/` }
];
---

<BaseLayout
  title={`${entry.data.title} Prompt | AIViewer`}
  description={entry.data.description}
  type="article"
  publishedDate={entry.data.publishedDate.toISOString()}
>
  <ArticleSchema
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
    publishedDate={entry.data.publishedDate}
  />
  <BreadcrumbSchema
    slot="head"
    items={[
      { name: 'Home', url: '/' },
      { name: 'Prompts', url: '/prompts/' },
      { name: entry.data.title, url: `/prompts/${entry.id}/` },
    ]}
  />
  <div class="page-container py-8 lg:py-12 max-w-4xl mx-auto">
    <Breadcrumbs items={breadcrumbItems} />
    
    <div class="mt-8 mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 dark:bg-indigo-900/30 text-indigo-800 dark:text-indigo-300">
          {entry.data.toolFor}
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 capitalize">
          Role: {entry.data.role.replace('-', ' ')}
        </span>
      </div>
      <h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-zinc-900 dark:text-white mb-4">
        {entry.data.title}
      </h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400">
        {entry.data.description}
      </p>
    </div>

    <article data-pagefind-body class="prose prose-zinc dark:prose-invert prose-lg max-w-none">
      <Content />
    </article>
    <AuthorBio compact />
  </div>
</BaseLayout>
