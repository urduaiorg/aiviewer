---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import CollectionSchema from '../../components/seo/CollectionSchema.astro';
import { roleLabels } from '../../data/site.config';
const prompts = (await getCollection('prompts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const roles = [...new Set(prompts.map((p) => p.data.role))];
const uniqueTools = [...new Set(prompts.map((p) => p.data.toolFor))];
import NewsletterSignup from '../../components/content/NewsletterSignup.astro';
import { shouldNoindexPath } from '../../utils/indexPolicy';
---

<BaseLayout
  title="AI Prompt Library"
  description="A curated library of copy-paste prompts for ChatGPT, Claude, and other AI tools, organized by role and task."
  noindex={shouldNoindexPath(Astro.url.pathname)}
>
  <Fragment slot="head">
    <CollectionSchema
      name="AI Prompt Library"
      description="A curated library of copy-paste prompts for ChatGPT, Claude, and other AI tools, organized by role and task."
      url="/prompts/"
      numberOfItems={prompts.length}
    />
  </Fragment>
  <Header />

  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.22),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.12),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Prompts' }]} />

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end" data-reveal>
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:text-zinc-400">
            Prompt library
          </span>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">Copy-paste prompts that actually work.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Tested prompts for real tasks, organized by role and tool. Grab one, customize it, and get better results from your AI tools in seconds.
          </p>
        </div>

        <div class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.14)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Library</p>
          <div class="mt-5 grid grid-cols-3 gap-4">
            <div>
              <div class="text-3xl font-bold">{prompts.length}</div>
              <p class="mt-1 text-sm text-zinc-400">Prompts</p>
            </div>
            <div>
              <div class="text-3xl font-bold text-[#F0C75E]">{uniqueTools.length}</div>
              <p class="mt-1 text-sm text-zinc-400">AI tools</p>
            </div>
            <div>
              <div class="text-3xl font-bold">{roles.length}</div>
              <p class="mt-1 text-sm text-zinc-400">Roles</p>
            </div>
          </div>
        </div>
      </div>

      {roles.length > 0 && (
        <nav class="mt-10 flex flex-wrap gap-2" data-filter-controls aria-label="Role filters">
          <button class="rounded-full border border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 px-4 py-2 text-sm font-semibold text-indigo-700 dark:text-indigo-300" data-filter="all">
            All roles
          </button>
          {roles.map((role) => (
            <button class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-400 transition-colors hover:border-indigo-200 hover:text-indigo-600" data-filter={role}>
              {roleLabels[role] ?? role}
            </button>
          ))}
        </nav>
      )}
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      {prompts.length === 0 ? (
        <div class="rounded-[1.75rem] border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-8 py-16 text-center">
          <h2 class="text-zinc-950 dark:text-zinc-50">No prompts published yet.</h2>
          <p class="mt-3 text-zinc-500 dark:text-zinc-400">Add Markdown or MDX files to `src/content/prompts` and this library will populate automatically.</p>
        </div>
      ) : (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-prompt-grid>
          {prompts.map((entry) => (
            <a
              href={`/prompts/${entry.id}/`}
              class="prompt-card card-glow group flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
              data-role={entry.data.role}
              data-reveal
            >
              {/* Card header with tool + role badges */}
              <div class="border-b border-zinc-200 dark:border-zinc-800 bg-gradient-to-br from-zinc-50 via-white to-zinc-50 dark:from-zinc-900 dark:via-zinc-800/50 dark:to-zinc-900 px-6 py-5">
                <div class="flex items-center justify-between gap-3">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
                    {entry.data.toolFor}
                  </span>
                  <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">
                    {roleLabels[entry.data.role] ?? entry.data.role}
                  </span>
                </div>
                {/* Decorative prompt icon */}
                <div class="mt-4 flex items-center gap-2 text-zinc-300 dark:text-zinc-600">
                  <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#F0C75E]/15 dark:bg-[#F0C75E]/10">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-[#F0C75E]">
                      <path fill-rule="evenodd" d="M6.28 5.22a.75.75 0 010 1.06L2.56 10l3.72 3.72a.75.75 0 01-1.06 1.06L.97 10.53a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0zm7.44 0a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06L17.44 10l-3.72-3.72a.75.75 0 010-1.06zM11.377 2.011a.75.75 0 01.612.867l-2.5 14.5a.75.75 0 01-1.478-.255l2.5-14.5a.75.75 0 01.866-.612z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500">{entry.data.task}</span>
                </div>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-[1.3rem] leading-snug text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {entry.data.title}
                </h3>
                <p class="mt-3 flex-1 text-[0.95rem] leading-7 text-zinc-600 dark:text-zinc-400">
                  {entry.data.description}
                </p>

                <div class="mt-5 flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 pt-5">
                  <div class="flex flex-wrap gap-2">
                    {entry.data.tags.slice(0, 2).map((tag) => (
                      <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-2.5 py-1 text-xs text-zinc-500 dark:text-zinc-400">{tag}</span>
                    ))}
                  </div>
                  <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400">View prompt</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <script>
    const controls = document.querySelector('[data-filter-controls]');
    const grid = document.querySelector('[data-prompt-grid]');
    if (controls && grid) {
      const buttons = Array.from(controls.querySelectorAll('button[data-filter]'));
      const cards = Array.from(grid.querySelectorAll('.prompt-card'));

      const setFilter = (value: string) => {
        buttons.forEach((button) => {
          const active = (button as HTMLElement).dataset.filter === value;
          if (active) {
            button.className = 'rounded-full border border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 px-4 py-2 text-sm font-semibold text-indigo-700 dark:text-indigo-300';
          } else {
            button.className = 'rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-400 transition-colors hover:border-indigo-200 hover:text-indigo-600';
          }
        });

        cards.forEach((card) => {
          const matches = value === 'all' || (card as HTMLElement).dataset.role === value;
          card.toggleAttribute('hidden', !matches);
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => setFilter((button as HTMLElement).dataset.filter ?? 'all'));
      });
    }
  </script>


  <!-- Newsletter signup -->
  <section class="page-container py-16">
    <NewsletterSignup variant="inline" />
  </section>

  <Footer />
</BaseLayout>
