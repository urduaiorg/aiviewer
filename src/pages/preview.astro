---
/**
 * Component Preview Page — showcases all Phase 2 core components
 * This page is for development preview only. Remove before production.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AuthorBio from '../components/content/AuthorBio.astro';
import PromptBlock from '../components/content/PromptBlock.astro';
import ToolPickBox from '../components/content/ToolPickBox.astro';
import ComparisonTable from '../components/content/ComparisonTable.astro';
import PricingTable from '../components/content/PricingTable.astro';
import ProsCons from '../components/content/ProsCons.astro';
import AdSlot from '../components/content/AdSlot.astro';
import AffiliateLink from '../components/content/AffiliateLink.astro';
import TableOfContents from '../components/content/TableOfContents.astro';
---

<BaseLayout title="Component Preview" description="Phase 2 component showcase">
  <Header />

  <div class="page-container py-12">
    <h1 class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-50 mb-2">Phase 2 — Component Showcase</h1>
    <p class="text-zinc-500 dark:text-zinc-400 mb-12 text-lg">All 9 core content components, ready for editorial pages.</p>

    <div class="grid grid-cols-1 xl:grid-cols-[220px_1fr] gap-12">
      {/* Sidebar TOC */}
      <TableOfContents headings={[
        { depth: 2, slug: 'prompt-block', text: 'Prompt Block' },
        { depth: 2, slug: 'tool-pick-box', text: 'Tool Pick Box' },
        { depth: 2, slug: 'comparison-table', text: 'Comparison Table' },
        { depth: 2, slug: 'pricing-table', text: 'Pricing Table' },
        { depth: 2, slug: 'pros-cons', text: 'Pros & Cons' },
        { depth: 2, slug: 'ad-slot', text: 'Ad Slot' },
        { depth: 2, slug: 'affiliate-link', text: 'Affiliate Link' },
        { depth: 2, slug: 'author-bio', text: 'Author Bio' },
      ]} />

      {/* Main content area */}
      <div class="content-area space-y-16 max-w-none">

        {/* ── Prompt Block ── */}
        <section>
          <h2 id="prompt-block" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Prompt Block</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Copyable prompt display — light and dark variants</p>

          <div class="space-y-6">
            <PromptBlock
              tool="ChatGPT"
              prompt={`You are a curriculum advisor for high school teachers. I teach [SUBJECT] to [GRADE LEVEL] students.\n\nCreate a 4-week lesson plan that integrates AI tools into my existing curriculum. For each week, provide:\n1. Learning objective\n2. AI tool recommendation with specific use case\n3. Student activity (30 min)\n4. Assessment rubric criteria`}
            />

            <PromptBlock
              variant="dark"
              tool="Claude"
              label="Advanced Prompt"
              prompt={`Analyze this business data and provide actionable insights:\n\n<data>\n{{PASTE_DATA_HERE}}\n</data>\n\nFormat your response as:\n- Executive Summary (2 sentences)\n- Key Trends (bullet points)\n- Risk Factors\n- Recommended Actions (prioritized)`}
            />
          </div>
        </section>

        {/* ── Tool Pick Box ── */}
        <section>
          <h2 id="tool-pick-box" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Tool Pick Box</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Wirecutter-style editorial tool recommendation</p>

          <ToolPickBox
            name="Perplexity AI"
            verdict="The best AI search tool for researchers and professionals who need cited, reliable answers fast."
            description="Perplexity combines LLM reasoning with real-time web search, delivering answers with inline citations. Unlike ChatGPT, every claim links back to its source — making it ideal for research, fact-checking, and academic work."
            rating={4.5}
            pricing="freemium"
            bestFor={['Researchers', 'Students', 'Journalists']}
            website="https://perplexity.ai"
            category="Research"
          />
        </section>

        {/* ── Comparison Table ── */}
        <section>
          <h2 id="comparison-table" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Comparison Table</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Side-by-side tool comparison with winner highlight</p>

          <ComparisonTable
            title="AI Writing Tools Compared"
            tools={[
              { name: 'ChatGPT', isWinner: true },
              { name: 'Claude' },
              { name: 'Gemini' },
            ]}
            features={[
              { name: 'Free tier', values: [true, true, true] },
              { name: 'Code generation', values: [true, true, true] },
              { name: 'Web browsing', values: [true, false, true] },
              { name: 'File uploads', values: [true, true, true] },
              { name: 'Output quality', values: [5, 5, 4] },
              { name: 'Speed', values: [4, 4, 5] },
              { name: 'Context window', description: 'Max tokens per conversation', values: ['128K', '200K', '1M'] },
              { name: 'Custom GPTs/bots', values: [true, false, true] },
            ]}
            verdict="ChatGPT wins for versatility and ecosystem, but Claude matches it on output quality with a larger context window. Gemini leads in speed and context length."
          />
        </section>

        {/* ── Pricing Table ── */}
        <section>
          <h2 id="pricing-table" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Pricing Table</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Clean tier display for tool reviews</p>

          <PricingTable
            toolName="ChatGPT"
            tiers={[
              {
                name: 'Free',
                price: '$0',
                description: 'Basic access to GPT-5.3 Instant and limited GPT-5.4',
                features: ['GPT-5.3 Instant unlimited', 'GPT-5.4 (limited)', 'Basic web browsing', 'Mobile app access'],
              },
              {
                name: 'Plus',
                price: '$20',
                period: 'mo',
                description: 'Full access to GPT-5.4, GPT-5.4 Thinking, and advanced features',
                features: ['GPT-5.4 Thinking', 'DALL-E image gen', 'Advanced data analysis', 'Custom GPTs', 'Native computer-use'],
                isRecommended: true,
                cta: 'Get Plus',
                ctaUrl: '#',
              },
              {
                name: 'Team',
                price: '$25',
                period: 'user/mo',
                description: 'For teams needing shared workspace and admin controls',
                features: ['Everything in Plus', 'Higher usage caps', 'Workspace management', 'Admin console', 'No training on data'],
                ctaUrl: '#',
              },
            ]}
            disclaimer="Pricing as of March 2026. Check official website for current rates."
          />
        </section>

        {/* ── Pros & Cons ── */}
        <section>
          <h2 id="pros-cons" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Pros & Cons</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Visual evaluation with balance indicator</p>

          <ProsCons
            toolName="Perplexity AI"
            pros={[
              'Every answer includes inline source citations you can verify',
              'Real-time web search combined with LLM reasoning',
              'Clean, distraction-free interface focused on answers',
              'Excellent for academic research and fact-checking',
              'Free tier is genuinely useful — not just a teaser',
            ]}
            cons={[
              'Pro plan is expensive at $20/month',
              'Cannot generate images or creative content',
              'Sometimes over-cites sources for simple questions',
            ]}
            verdict="Perplexity is the best AI search tool for anyone who needs reliable, cited answers. The free tier covers most use cases. Skip the Pro unless you need file uploads and higher limits."
          />
        </section>

        {/* ── Ad Slot ── */}
        <section>
          <h2 id="ad-slot" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Ad Slot</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Tasteful ad placement with fallback state</p>

          <AdSlot slot="preview-inline-1" size="inline" />
        </section>

        {/* ── Affiliate Link ── */}
        <section>
          <h2 id="affiliate-link" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Affiliate Link</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Branded CTA buttons — 3 variants, 3 sizes</p>

          <div class="space-y-6">
            <div class="flex flex-wrap items-start gap-6">
              <AffiliateLink href="#" text="Try ChatGPT Plus" toolName="ChatGPT" variant="primary" size="lg" />
              <AffiliateLink href="#" text="Get Perplexity Pro" toolName="Perplexity" variant="subtle" size="md" />
              <AffiliateLink href="#" text="Visit Claude" toolName="Claude" variant="outline" size="sm" />
            </div>
          </div>
        </section>

        {/* ── Author Bio ── */}
        <section>
          <h2 id="author-bio" class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-1">Author Bio</h2>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-6">Editorial author card — full and compact variants</p>

          <div class="space-y-8">
            <div class="border border-zinc-200 dark:border-zinc-800 rounded-2xl px-6 overflow-hidden">
              <AuthorBio />
            </div>

            <div class="border border-zinc-200 dark:border-zinc-800 rounded-2xl px-6 overflow-hidden">
              <AuthorBio compact />
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>
