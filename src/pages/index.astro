---
import { getCollection, type CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WebsiteSchema from '../components/seo/WebsiteSchema.astro';
import EditorialCover from '../components/content/EditorialCover.astro';
import {
  GUIDE_FORMATS,
  isPublishedGuide,
  type GuideFormat,
} from '../components/editorial/model';
import { categoryLabels } from '../data/site.config';
import { getReadingTime } from '../utils/readingTime';
import { formatDate } from '../utils/formatDate';
import { shouldNoindexPath } from '../utils/indexPolicy';

type GuideEntry = CollectionEntry<'guides'>;

type GuideDataWithFormat = GuideEntry['data'] & {
  format?: GuideFormat | string;
};

function getGuideFormat(entry: GuideEntry): GuideFormat {
  const format = (entry.data as GuideDataWithFormat).format ?? 'evergreen-foundation';
  return GUIDE_FORMATS.includes(format as GuideFormat)
    ? format as GuideFormat
    : 'evergreen-foundation';
}

function hasLocalCover(entry: GuideEntry): boolean {
  const source = entry.data.coverImage;
  if (/^https?:\/\//.test(source)) return true;
  if (!source.startsWith('/') || source.includes('..')) return false;
  return existsSync(new URL(`../../public${source}`, import.meta.url));
}

function contentDate(entry: GuideEntry): Date {
  return entry.data.updatedDate ?? entry.data.publishedDate;
}

function contentDateLabel(entry: GuideEntry): string {
  const label = formatDate(contentDate(entry));
  return entry.data.updatedDate ? `Updated ${label}` : label;
}

const guides = (await getCollection('guides'))
  .filter(({ data }) => isPublishedGuide(data) && data.publication.index)
  .filter((entry) => !shouldNoindexPath(`/guides/${entry.id}/`))
  .sort((a, b) => contentDate(b).getTime() - contentDate(a).getTime());

const latestLessons = guides
  .filter((entry) => {
    const format = getGuideFormat(entry);
    return format !== 'ai-signal' && format !== 'video-lesson';
  })
  .slice(0, 3);
const videoLessons = guides
  .filter((entry) => getGuideFormat(entry) === 'video-lesson')
  .slice(0, 2);
const aiSignals = guides
  .filter((entry) => getGuideFormat(entry) === 'ai-signal')
  .slice(0, 3);
const practicalGuides = guides
  .filter((entry) => getGuideFormat(entry) === 'practical-workflow')
  .slice(0, 5);

const heroLesson = videoLessons[0] ?? latestLessons[0] ?? guides[0];
const heroIsVideo = heroLesson ? getGuideFormat(heroLesson) === 'video-lesson' : false;
---

<BaseLayout
  title="AIViewer.ai"
  description="Selected AI videos, primary sources, and practical lessons explained in clear English by the AIViewer editorial system from UrduAI."
  monetize={true}
>
  <Fragment slot="head">
    <WebsiteSchema />
  </Fragment>

  <Header />

  <main class="editorial-home">
    <section class="editorial-hero" aria-labelledby="homepage-title">
      <div class="editorial-shell editorial-hero__grid">
        <div class="editorial-hero__copy">
          <h1 id="homepage-title">
            <span>Understand AI.</span>
            <span>Use it well.</span>
          </h1>
          <p>
            Selected videos, primary sources and practical lessons—explained in clear English by the AIViewer editorial system from UrduAI.
          </p>
          <div class="editorial-hero__actions">
            <a class="button button--primary" href="/learn/">
              Explore lessons
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
            <a class="button button--secondary" href="/about/">How AIViewer works</a>
          </div>
          <ul class="hero-points" aria-label="How AIViewer keeps lessons trustworthy">
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10.5 4 4L16 6" /></svg>
              Creator attribution stays intact
            </li>
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10.5 4 4L16 6" /></svg>
              Claims checked against primary sources
            </li>
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10.5 4 4L16 6" /></svg>
              Privacy and access limits kept in view
            </li>
          </ul>
        </div>

        <div class="hero-feature">
          <div class="hero-feature__image">
            <img
              src="/images/editorial/aiviewer-lens-learner.webp"
              alt="A learner taking notes beside a laptop while studying an AI concept"
              width="1600"
              height="901"
              fetchpriority="high"
            />
            {heroLesson && (
              <a
                href={`/guides/${heroLesson.id}/`}
                class="hero-feature__open"
                aria-label={`Open ${heroLesson.data.title}`}
              >
                {heroIsVideo ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m9.2 7.3 7.2 4.7-7.2 4.7z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 12h12M13 7l5 5-5 5" />
                  </svg>
                )}
              </a>
            )}
          </div>

          <div class="hero-feature__body">
            {heroLesson ? (
              <>
                <p class="content-label">{heroIsVideo ? 'Featured video lesson' : 'Featured lesson'}</p>
                <h2>
                  <a href={`/guides/${heroLesson.id}/`}>{heroLesson.data.title}</a>
                </h2>
                <div class="hero-feature__summary">
                  <p>{heroLesson.data.description}</p>
                  <a class="text-link" href={`/guides/${heroLesson.id}/`}>
                    Open lesson
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M4 10h11M11 6l4 4-4 4" />
                    </svg>
                  </a>
                </div>
              </>
            ) : (
              <>
                <p class="content-label">The AIViewer Lens</p>
                <h2>Start with a clearer way to learn AI.</h2>
                <div class="hero-feature__summary">
                  <p>New lessons will appear here as they are prepared for the learning desk.</p>
                  <a class="text-link" href="/learn/">
                    Start learning
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M4 10h11M11 6l4 4-4 4" />
                    </svg>
                  </a>
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="lens-section" aria-labelledby="lens-title">
      <div class="editorial-shell">
        <h2 id="lens-title" class="section-kicker">The AIViewer Lens</h2>
        <ol class="lens-track">
          <li class="lens-step">
            <span class="lens-step__number">1</span>
            <svg viewBox="0 0 36 36" aria-hidden="true">
              <path d="M8 31v-3a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8v3M17 17a6 6 0 1 0 0-12 6 6 0 0 0 0 12" />
            </svg>
            <h3>Creator explains</h3>
            <p>We preserve the original idea, its context and its creator.</p>
          </li>
          <li class="lens-step">
            <span class="lens-step__number">2</span>
            <svg viewBox="0 0 36 36" aria-hidden="true">
              <path d="M7 3h16l5 5v10M23 3v6h6M6 3v29h13M19 25a6 6 0 1 0 12 0 6 6 0 0 0-12 0ZM29.5 29.5 34 34" />
            </svg>
            <h3>Sources verify</h3>
            <p>We look for primary documentation and label what remains uncertain.</p>
          </li>
          <li class="lens-step">
            <span class="lens-step__number">3</span>
            <svg viewBox="0 0 36 36" aria-hidden="true">
              <path d="M29 12V5l-3 3a13 13 0 0 0-21 6M7 24v7l3-3a13 13 0 0 0 21-6M29 5h-7M7 31h7" />
            </svg>
            <h3>What changed</h3>
            <p>We surface updates, access limits and privacy choices that affect the advice.</p>
          </li>
          <li class="lens-step">
            <span class="lens-step__number">4</span>
            <svg viewBox="0 0 36 36" aria-hidden="true">
              <path d="m7 27-2 7 7-2L31 13a4 4 0 0 0-8-8zM20 8l8 8" />
            </svg>
            <h3>You try</h3>
            <p>We turn the lesson into a small, practical step you can test for yourself.</p>
          </li>
        </ol>
        <p class="lens-promise">
          The Lens keeps attribution, source quality, change, privacy and action in the same frame.
        </p>
      </div>
    </section>

    <section class="latest-section section-block" aria-labelledby="latest-title">
      <div class="editorial-shell">
        <div class="section-heading">
          <h2 id="latest-title">Latest Lessons</h2>
          <a class="text-link" href="/learn/">
            View all lessons
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>

        {latestLessons.length ? (
          <div class:list={['latest-grid', `latest-grid--${latestLessons.length}`]}>
            {latestLessons.map((entry, index) => (
              <article class:list={['lesson-card', { 'lesson-card--lead': index === 0 }]}>
                <a href={`/guides/${entry.id}/`} class="lesson-card__link">
                  <div class="lesson-card__media">
                    {hasLocalCover(entry) ? (
                      <img
                        src={entry.data.coverImage}
                        alt=""
                        width="1200"
                        height="630"
                        loading="eager"
                      />
                    ) : (
                      <EditorialCover
                        title={entry.data.title}
                        category={entry.data.category}
                        variant="guide"
                        compact={true}
                        showTitle={false}
                      />
                    )}
                  </div>
                  <div class="lesson-card__body">
                    <p class="content-label">{categoryLabels[entry.data.category] ?? entry.data.category}</p>
                    <h3>{entry.data.title}</h3>
                    <p class="lesson-card__description">{entry.data.description}</p>
                    <p class="lesson-card__meta">
                      <span>{contentDateLabel(entry)}</span>
                      <span aria-hidden="true">·</span>
                      <span>{getReadingTime(entry.body)}</span>
                    </p>
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>New foundation lessons are being prepared for this desk.</p>
            <a class="text-link" href="/learn/">
              Explore the learning desk
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </section>

    <section class="signals-section" aria-labelledby="signals-title">
      <div class="editorial-shell signals-grid">
        <div class="signals-intro">
          <h2 id="signals-title">AI Signals</h2>
          <p>Timely, source-aware explainers on what changed and why it matters.</p>
        </div>

        <div class="signals-list">
          {aiSignals.length ? (
            aiSignals.map((entry) => (
              <article>
                <a href={`/guides/${entry.id}/`}>
                  <span class="signals-list__category">
                    {categoryLabels[entry.data.category] ?? entry.data.category}
                  </span>
                  <strong>{entry.data.title}</strong>
                  <span class="signals-list__date">{contentDateLabel(entry)}</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" />
                  </svg>
                </a>
              </article>
            ))
          ) : (
            <div class="signals-empty">
              <p>New signals will appear here when a source-linked update is ready.</p>
            </div>
          )}
          <a class="text-link text-link--light signals-list__all" href="/signals/">
            View all AI Signals
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="video-section section-block" aria-labelledby="video-title">
      <div class="editorial-shell">
        <div class="section-heading">
          <h2 id="video-title">Learn from standout videos</h2>
          <a class="text-link" href="/video-lessons/">
            View all videos
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>

        {videoLessons.length ? (
          <div class="video-list">
            {videoLessons.map((entry) => (
              <article class="video-row">
                <a href={`/guides/${entry.id}/`} class="video-row__link">
                  <div class="video-row__image">
                    {hasLocalCover(entry) ? (
                      <img src={entry.data.coverImage} alt="" width="1200" height="630" loading="lazy" />
                    ) : (
                      <EditorialCover
                        title={entry.data.title}
                        category={entry.data.category}
                        variant="guide"
                        compact={true}
                        showTitle={false}
                      />
                    )}
                    <span aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d="m9.2 7.3 7.2 4.7-7.2 4.7z" />
                      </svg>
                    </span>
                  </div>
                  <div class="video-row__body">
                    <p class="content-label">Selected video lesson</p>
                    <h3>{entry.data.title}</h3>
                    <p>{entry.data.description}</p>
                    <p class="video-row__meta">
                      <span>{contentDateLabel(entry)}</span>
                      <span aria-hidden="true">·</span>
                      <span>{getReadingTime(entry.body)}</span>
                    </p>
                  </div>
                  <div class="video-row__analysis">
                    <p class="content-label">AIViewer Lens</p>
                    <p>Creator context, source trail, important changes and one practical next step.</p>
                    <span class="text-link">
                      Open lesson
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10h11M11 6l4 4-4 4" />
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state empty-state--video">
            <p>Selected video lessons will appear here after their source trail and learning notes are ready.</p>
            <a class="text-link" href="/video-lessons/">
              Visit video lessons
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </section>

    <section class="practical-section section-block" aria-labelledby="practical-title">
      <div class="editorial-shell">
        <div class="section-heading">
          <h2 id="practical-title">Practical guides</h2>
          <a class="text-link" href="/practical-guides/">
            View all guides
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>

        {practicalGuides.length ? (
          <ol class="practical-list">
            {practicalGuides.map((entry, index) => (
              <li>
                <a href={`/guides/${entry.id}/`}>
                  <span class="practical-list__number">{String(index + 1).padStart(2, '0')}</span>
                  <strong>{entry.data.title}</strong>
                  <span class="practical-list__description">{entry.data.description}</span>
                  <span class="practical-list__time">{getReadingTime(entry.body)}</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M4 10h11M11 6l4 4-4 4" />
                  </svg>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-state empty-state--compact">
            <p>Practical workflows will appear here as they are prepared for publication.</p>
            <a class="text-link" href="/practical-guides/">
              Visit practical guides
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </section>

    <section class="urduai-band" aria-labelledby="urduai-title">
      <div class="editorial-shell urduai-band__grid">
        <div class="urduai-band__mark" aria-hidden="true">
          <svg viewBox="0 0 72 72">
            <path d="M36 3 44 22 63 14 50 30 69 36 50 42 63 58 44 50 36 69 28 50 9 58 22 42 3 36 22 30 9 14 28 22z" />
            <circle cx="36" cy="36" r="13" />
          </svg>
          <p><small>Part of</small><span>Urdu</span><strong>AI</strong></p>
        </div>
        <div class="urduai-band__copy">
          <h2 id="urduai-title">Extending AI literacy in clear English.</h2>
          <p>
            AIViewer is the English learning and verification desk from UrduAI. We turn selected AI videos and primary sources into practical knowledge you can use.
          </p>
          <a href="https://www.urduai.org" target="_blank" rel="noopener noreferrer">
            Learn more about UrduAI
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .editorial-home {
    --paper: #fffdf9;
    --ink: #12120f;
    --muted: #5d5b55;
    --hairline: #e3e0d8;
    --amber: #b97400;
    --amber-bright: #d88a00;
    --amber-soft: #fff8eb;
    --indigo: #37338f;
    min-width: 0;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.5;
  }

  .editorial-shell {
    width: min(100% - 3rem, 1200px);
    margin-inline: auto;
  }

  .editorial-home h1,
  .editorial-home h2,
  .editorial-home h3,
  .editorial-home p {
    margin-top: 0;
  }

  .editorial-home h1,
  .section-heading h2,
  .signals-intro h2,
  .lesson-card h3,
  .video-row h3,
  .hero-feature h2,
  .urduai-band h2 {
    font-family: Georgia, 'Times New Roman', serif;
    letter-spacing: -0.03em;
  }

  /* ---------- Hero ---------- */

  .editorial-hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2.25rem, 4vw, 3.75rem);
  }

  .editorial-hero__grid {
    display: grid;
    grid-template-columns: minmax(17rem, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2.5rem, 5.5vw, 5rem);
    align-items: center;
  }

  .editorial-hero__copy h1 {
    margin-bottom: 1.25rem;
    color: var(--ink);
    font-size: clamp(2.9rem, 5.2vw, 4.5rem);
    font-weight: 500;
    line-height: 1.02;
  }

  .editorial-hero__copy h1 span {
    display: block;
    white-space: nowrap;
  }

  .editorial-hero__copy > p {
    max-width: 33rem;
    margin-bottom: 2rem;
    color: #3c3a34;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.6;
  }

  .editorial-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1.9rem;
  }

  .hero-points {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-points li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .hero-points svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--amber-bright);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.45rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .button svg,
  .text-link svg,
  .urduai-band__copy a svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .button svg {
    margin-left: 0.6rem;
  }

  .button--primary {
    background: var(--ink);
    color: #fff;
  }

  .button--primary:hover {
    background: #34332f;
    transform: translateY(-1px);
  }

  .button--secondary {
    background: transparent;
    color: var(--ink);
  }

  .button--secondary:hover {
    background: #f5f4f1;
  }

  .hero-feature {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(18 18 15 / 0.04), 0 12px 32px -18px rgb(18 18 15 / 0.18);
  }

  .hero-feature__image {
    position: relative;
    aspect-ratio: 16 / 8.5;
    overflow: hidden;
    background: #1f1c18;
  }

  .hero-feature__image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-feature__open {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 2px solid #fff;
    border-radius: 50%;
    background: rgb(8 8 8 / 0.76);
    color: #fff;
    transition: background 150ms ease, transform 150ms ease;
  }

  .hero-feature__open:hover {
    background: #111;
    transform: scale(1.05);
  }

  .hero-feature__open svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .hero-feature__open svg path[d^='m'] {
    fill: currentColor;
    stroke: none;
  }

  .hero-feature__body {
    padding: 1.35rem 1.5rem 1.5rem;
  }

  .content-label {
    margin-bottom: 0.5rem;
    color: var(--amber);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-feature__body h2 {
    margin-bottom: 0.65rem;
    color: var(--ink);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .hero-feature__body h2 a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .hero-feature__body h2 a:hover {
    color: var(--indigo);
  }

  .hero-feature__summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem;
    align-items: end;
  }

  .hero-feature__summary > p {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 0;
    color: var(--muted);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--indigo);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
  }

  .text-link:hover {
    color: #22205f;
  }

  .text-link:hover svg {
    transform: translateX(2px);
  }

  .text-link svg {
    transition: transform 150ms ease;
  }

  /* ---------- Lens ---------- */

  .lens-section {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: #fbf9f4;
  }

  .section-kicker {
    margin-bottom: 1.75rem;
    color: var(--amber);
    font-family: 'Inter', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .lens-track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lens-step {
    position: relative;
    padding-top: 1.5rem;
    border-top: 1px solid #d4cfc4;
  }

  .lens-step__number {
    position: absolute;
    top: -0.8rem;
    left: 0;
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border: 1px solid #e2a43b;
    border-radius: 50%;
    background: var(--paper);
    color: #7b6a45;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .lens-step > svg {
    width: 2.3rem;
    height: 2.3rem;
    margin-bottom: 0.7rem;
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.2;
  }

  .lens-step h3 {
    margin-bottom: 0.45rem;
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .lens-step p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .lens-promise {
    margin: 2rem auto 0;
    color: #4a4840;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.98rem;
    font-style: italic;
    line-height: 1.5;
    text-align: center;
  }

  /* ---------- Section rhythm ---------- */

  .section-block {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  .section-heading h2,
  .signals-intro h2 {
    margin-bottom: 0;
    color: var(--ink);
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    font-weight: 500;
    line-height: 1.05;
  }

  /* ---------- Latest lessons ---------- */

  .latest-section {
    border-bottom: 1px solid var(--hairline);
  }

  .latest-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) repeat(2, minmax(0, 0.9fr));
    gap: 0;
  }

  .latest-grid--2 {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
  }

  .latest-grid--1 {
    grid-template-columns: minmax(0, 1fr);
  }

  .lesson-card {
    min-width: 0;
    padding-inline: 1.15rem;
    border-left: 1px solid var(--hairline);
  }

  .lesson-card:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .lesson-card:last-child {
    padding-right: 0;
  }

  .lesson-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .lesson-card__media {
    width: 100%;
    aspect-ratio: 1.68 / 1;
    overflow: hidden;
    border-radius: 3px;
    background: #eeece8;
  }

  .lesson-card__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88);
    transition: filter 200ms ease, transform 300ms ease;
  }

  .lesson-card--lead .lesson-card__media {
    aspect-ratio: 2.25 / 1;
  }

  .lesson-card__media :global(.editorial-cover) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .lesson-card__link:hover .lesson-card__media > img {
    filter: saturate(1);
    transform: scale(1.02);
  }

  .lesson-card__body {
    padding-top: 1rem;
  }

  .lesson-card h3 {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 0.55rem;
    color: var(--ink);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.18;
    transition: color 150ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .lesson-card--lead h3 {
    font-size: clamp(1.55rem, 2.6vw, 2.1rem);
    -webkit-line-clamp: 2;
  }

  .lesson-card__link:hover h3 {
    color: var(--indigo);
  }

  .lesson-card__description {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 0.8rem;
    color: #504e48;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.92rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .lesson-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0;
    color: #7c786f;
    font-size: 0.76rem;
    line-height: 1.35;
  }

  /* ---------- AI Signals ---------- */

  .signals-section {
    padding-block: clamp(2.25rem, 4.5vw, 3.25rem);
    background: #0b0b0a;
    color: #f5f2e9;
  }

  .signals-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .signals-intro {
    padding-left: 1.35rem;
    border-left: 3px solid #d79720;
  }

  .signals-intro h2 {
    color: #fffdf7;
  }

  .signals-intro p {
    max-width: 16rem;
    margin: 0.8rem 0 0;
    color: #b9b6ae;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .signals-list article {
    border-bottom: 1px solid #33322f;
  }

  .signals-list article:first-child {
    border-top: 1px solid #33322f;
  }

  .signals-list article a {
    display: grid;
    grid-template-columns: minmax(5.5rem, 0.22fr) minmax(0, 1.3fr) auto 1.1rem;
    gap: 1rem;
    align-items: center;
    min-height: 3.6rem;
    padding-block: 0.7rem;
    color: #eeece6;
    text-decoration: none;
  }

  .signals-list__category {
    color: #e2a22e;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .signals-list strong {
    display: -webkit-box;
    overflow: hidden;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .signals-list__date {
    color: #aaa79f;
    font-size: 0.74rem;
    white-space: nowrap;
  }

  .signals-list article svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: #d7d4cc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
    transition: transform 150ms ease;
  }

  .signals-list article a:hover strong {
    color: #f1bd58;
  }

  .signals-list article a:hover svg {
    transform: translateX(3px);
  }

  .signals-list__all {
    justify-content: center;
    margin-top: 1.25rem;
  }

  .text-link--light {
    color: #f2efe7;
  }

  .text-link--light:hover {
    color: #f1bd58;
  }

  .signals-empty {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    border-block: 1px solid #33322f;
  }

  .signals-empty p {
    margin-bottom: 0;
    color: #aaa79f;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.92rem;
  }

  /* ---------- Video lessons ---------- */

  .video-section {
    border-bottom: 1px solid var(--hairline);
  }

  .video-list {
    border-top: 1px solid var(--hairline);
  }

  .video-row {
    border-bottom: 1px solid var(--hairline);
  }

  .video-row__link {
    display: grid;
    grid-template-columns: minmax(13rem, 0.75fr) minmax(0, 0.82fr) minmax(10rem, 0.5fr);
    color: inherit;
    text-decoration: none;
  }

  .video-row__image {
    position: relative;
    min-height: 10.5rem;
    overflow: hidden;
    background: #eceae5;
  }

  .video-row__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88);
    transition: filter 200ms ease, transform 300ms ease;
  }

  .video-row__image :global(.editorial-cover) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .video-row__image > span {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 2px solid #fff;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.72);
    color: #fff;
  }

  .video-row__image svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: currentColor;
  }

  .video-row__body,
  .video-row__analysis {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 1.4rem 1.5rem;
    border-left: 1px solid var(--hairline);
  }

  .video-row h3 {
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-size: 1.32rem;
    font-weight: 500;
    line-height: 1.18;
    transition: color 150ms ease;
  }

  .video-row__body > p:not(.content-label):not(.video-row__meta),
  .video-row__analysis > p:not(.content-label) {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 0.65rem;
    color: var(--muted);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.9rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .video-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    color: #7c786f;
    font-size: 0.75rem;
  }

  .video-row__analysis .text-link {
    margin-top: auto;
  }

  .video-row__link:hover img {
    filter: saturate(1);
    transform: scale(1.02);
  }

  .video-row__link:hover h3 {
    color: var(--indigo);
  }

  /* ---------- Practical guides ---------- */

  .practical-section {
    padding-bottom: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .practical-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
    list-style: none;
  }

  .practical-list li {
    border-bottom: 1px solid var(--hairline);
  }

  .practical-list a {
    display: grid;
    grid-template-columns: 2.4rem minmax(13rem, 0.62fr) minmax(0, 1fr) auto 1.1rem;
    gap: 1rem;
    align-items: center;
    min-height: 3.9rem;
    padding-block: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .practical-list__number {
    color: var(--amber);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .practical-list strong {
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    transition: color 150ms ease;
  }

  .practical-list__description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.88rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .practical-list__time {
    color: #7c786f;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .practical-list svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--indigo);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
    transition: transform 150ms ease;
  }

  .practical-list a:hover strong {
    color: var(--indigo);
  }

  .practical-list a:hover svg {
    transform: translateX(3px);
  }

  /* ---------- Empty states ---------- */

  .empty-state {
    display: flex;
    min-height: 8.5rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 1.75rem;
    border-block: 1px solid var(--hairline);
    background: #faf9f7;
  }

  .empty-state p {
    max-width: 38rem;
    margin-bottom: 0.8rem;
    color: var(--muted);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .empty-state--video {
    min-height: 7rem;
  }

  .empty-state--compact {
    min-height: 5.5rem;
  }

  /* ---------- UrduAI band ---------- */

  .urduai-band {
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid #f0dfbd;
    border-bottom: 1px solid #f0dfbd;
    background: var(--amber-soft);
  }

  .urduai-band__grid {
    display: grid;
    grid-template-columns: minmax(11rem, 0.42fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: center;
  }

  .urduai-band__mark {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .urduai-band__mark svg {
    width: 3.8rem;
    height: 3.8rem;
    flex: 0 0 auto;
    fill: none;
    stroke: #d88a00;
    stroke-width: 1.1;
  }

  .urduai-band__mark p {
    min-width: 5rem;
    margin-bottom: 0;
    color: #4e4a40;
    font-size: 0.8rem;
    line-height: 1.25;
    white-space: nowrap;
  }

  .urduai-band__mark p small {
    display: block;
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .urduai-band__mark p span,
  .urduai-band__mark p strong {
    display: inline-block;
    margin-top: 0.2rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.05em;
  }

  .urduai-band__mark p span {
    color: #33322e;
  }

  .urduai-band__mark p strong {
    color: #d88a00;
  }

  .urduai-band__copy h2 {
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .urduai-band__copy > p {
    max-width: 43rem;
    margin-bottom: 0.75rem;
    color: #57544c;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .urduai-band__copy > a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--indigo);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .urduai-band__copy > a:hover {
    color: #22205f;
  }

  .editorial-home a:focus-visible {
    outline: 3px solid #e6a01d;
    outline-offset: 3px;
  }

  /* ---------- Dark mode ---------- */

  :global([data-theme='dark']) .editorial-home {
    --paper: #0b0b0b;
    --ink: #f5f3ed;
    --muted: #b3b0a8;
    --hairline: #302f2c;
    --amber: #f0ad36;
    --amber-bright: #f0ad36;
    --amber-soft: #18140d;
    --indigo: #aeb7ff;
    background: var(--paper);
    color: var(--ink);
  }

  :global([data-theme='dark']) .editorial-hero__copy > p,
  :global([data-theme='dark']) .lens-promise,
  :global([data-theme='dark']) .lesson-card__description,
  :global([data-theme='dark']) .urduai-band__mark p,
  :global([data-theme='dark']) .urduai-band__copy > p {
    color: #c6c3bb;
  }

  :global([data-theme='dark']) .button--primary {
    border-color: #f5f3ed;
    background: #f5f3ed;
    color: #11110f;
  }

  :global([data-theme='dark']) .button--secondary {
    border-color: #585650;
    color: #f5f3ed;
  }

  :global([data-theme='dark']) .button--secondary:hover {
    background: #20201e;
  }

  :global([data-theme='dark']) .hero-feature {
    background: #101010;
    box-shadow: none;
  }

  :global([data-theme='dark']) .lens-section {
    background: #100f0d;
  }

  :global([data-theme='dark']) .hero-feature__summary > p,
  :global([data-theme='dark']) .video-row__body > p:not(.content-label):not(.video-row__meta),
  :global([data-theme='dark']) .video-row__analysis > p:not(.content-label),
  :global([data-theme='dark']) .practical-list__description,
  :global([data-theme='dark']) .empty-state p {
    color: #b3b0a8;
  }

  :global([data-theme='dark']) .lens-step__number {
    background: var(--paper);
    color: #c3bba9;
  }

  :global([data-theme='dark']) .lesson-card__media,
  :global([data-theme='dark']) .video-row__image {
    background: #191919;
  }

  :global([data-theme='dark']) .signals-section {
    background: #040404;
  }

  :global([data-theme='dark']) .empty-state {
    background: #111;
  }

  :global([data-theme='dark']) .urduai-band {
    border-color: #41351e;
  }

  :global([data-theme='dark']) .urduai-band__mark p span {
    color: #efede7;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 940px) {
    .editorial-hero__grid {
      grid-template-columns: minmax(15rem, 0.75fr) minmax(0, 1.25fr);
      gap: 2rem;
    }

    .lesson-card {
      padding-inline: 0.85rem;
    }

    .video-row__link {
      grid-template-columns: minmax(11rem, 0.72fr) minmax(0, 1fr);
    }

    .video-row__analysis {
      display: none;
    }

    .practical-list a {
      grid-template-columns: 2.4rem minmax(10rem, 0.75fr) minmax(0, 1fr) auto 1.1rem;
      gap: 0.75rem;
    }
  }

  @media (max-width: 760px) {
    .editorial-shell {
      width: min(100% - 2rem, 1200px);
    }

    .editorial-hero {
      padding-block: 2.4rem 2rem;
    }

    .editorial-hero__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .editorial-hero__copy h1 {
      font-size: clamp(2.6rem, 11vw, 3.8rem);
    }

    .editorial-hero__copy > p {
      max-width: 37rem;
    }

    .hero-points {
      gap: 0.6rem;
    }

    .lens-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.25rem;
    }

    .latest-grid {
      grid-template-columns: 1fr;
    }

    .lesson-card,
    .lesson-card:first-child,
    .lesson-card:last-child {
      padding: 1.25rem 0;
      border-top: 1px solid var(--hairline);
      border-left: 0;
    }

    .lesson-card:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .lesson-card__media,
    .lesson-card--lead .lesson-card__media {
      aspect-ratio: 16 / 8;
    }

    .signals-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .signals-intro p {
      max-width: 25rem;
    }

    .signals-list article a {
      grid-template-columns: 5rem minmax(0, 1fr) 1.1rem;
    }

    .signals-list__date {
      display: none;
    }

    .video-row__link {
      grid-template-columns: minmax(9rem, 0.7fr) minmax(0, 1fr);
    }

    .practical-list a {
      grid-template-columns: 2.2rem minmax(0, 1fr) auto 1.1rem;
      min-height: 3.4rem;
    }

    .practical-list__description {
      display: none;
    }

    .urduai-band__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .editorial-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .hero-feature__body {
      padding: 1.1rem 1.15rem 1.25rem;
    }

    .hero-feature__summary {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .lens-track {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.6rem;
    }

    .video-row__link {
      grid-template-columns: 1fr;
    }

    .video-row__image {
      aspect-ratio: 16 / 8;
      min-height: 0;
    }

    .video-row__body {
      border-top: 1px solid var(--hairline);
      border-left: 0;
    }

    .video-row__body,
    .video-row__analysis {
      padding: 1.1rem 1.15rem;
    }

    .practical-list a {
      grid-template-columns: 2.2rem minmax(0, 1fr) 1.1rem;
