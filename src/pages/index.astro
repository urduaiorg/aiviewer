---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WebsiteSchema from '../components/seo/WebsiteSchema.astro';
import EditorialCover from '../components/content/EditorialCover.astro';
import { pricingConfig, categoryLabels } from '../data/site.config';
import { getReadingTime } from '../utils/readingTime';
import { formatDateShort } from '../utils/formatDate';
import NewsletterSignup from '../components/content/NewsletterSignup.astro';
import { shouldNoindexPath } from '../utils/indexPolicy';

// Curate by editorial priority and freshness. Numeric scores remain internal
// until individual evaluations have auditable hands-on evidence.
const allTools = await getCollection('tools', ({ data }) => !data.draft);
const editorialTools = allTools.filter((tool) =>
  tool.id !== 'ourscreen' && !shouldNoindexPath(`/tools/${tool.id}/`)
).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) ||
  (b.data.updatedDate ?? b.data.publishedDate).getTime() - (a.data.updatedDate ?? a.data.publishedDate).getTime()
);
const topTools = editorialTools.slice(0, 6);

// Hero sidebar: first 3 editorial picks
const heroTools = editorialTools.slice(0, 3);

// Pull latest guides — show 5 (1 featured + 4 grid)
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const latestGuides = allGuides
  .filter((guide) => !shouldNoindexPath(`/guides/${guide.id}/`))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 5);
const featuredGuide = latestGuides[0];
const gridGuides = latestGuides.slice(1, 5);

// Dynamic counts for stats
const toolCount = editorialTools.length + 1;
const guideCount = allGuides.filter((guide) => !shouldNoindexPath(`/guides/${guide.id}/`)).length;
---

<BaseLayout
  title="AIViewer.ai"
  description="Find practical AI tools and workflows for students, teachers, creators, small businesses, job seekers, and everyday work."
  monetize={true}
>
  <Fragment slot="head">
    <WebsiteSchema />
  </Fragment>
  <Header />

  <!-- ═══════════════════ HERO — Split Layout ═══════════════════ -->
  <section class="relative overflow-hidden">
    <div class="absolute top-[-20%] right-[-10%] w-[600px] h-[600px] rounded-full bg-indigo-100/40 dark:bg-indigo-900/20 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-[-30%] left-[-15%] w-[500px] h-[500px] rounded-full bg-amber-100/30 dark:bg-amber-900/15 blur-3xl pointer-events-none"></div>

    <div class="page-container relative">
      <div class="pt-16 pb-16 md:pt-20 md:pb-20 grid grid-cols-1 md:grid-cols-[1fr_340px] gap-10 md:gap-14 items-center">
        <!-- Left: Copy -->
        <div>
          <div class="hero-stagger-1 inline-flex items-center gap-2 px-3 py-1.5 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700 rounded-full mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
            <span class="text-xs font-semibold text-amber-700 dark:text-amber-300 tracking-wide uppercase">AI made practical</span>
          </div>

          <h1 class="hero-stagger-2 text-zinc-900 dark:text-zinc-50 mb-4" style="letter-spacing: -0.035em; line-height: 1.08;">
            What do you want<br/>
            <span class="hero-stagger-3 inline-block text-amber-700 dark:text-[#F0C75E]">AI to help with?</span>
          </h1>

          <p class="hero-stagger-4 text-lg md:text-xl text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-xl mb-8">
            Start with current, source-linked guides and transparent tool evaluations—without invented testing claims or pay-to-rank listings.
          </p>

          <div class="hero-stagger-5 flex flex-col sm:flex-row items-start gap-3">
            <a href="/tools/" class="group inline-flex items-center gap-2.5 px-6 py-3.5 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-[0.92rem] font-semibold rounded-xl hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-all duration-200 shadow-lg shadow-zinc-900/10 active:scale-[0.97]">
              Browse Current Tools
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href="/guides/" class="group inline-flex items-center gap-2.5 px-6 py-3.5 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 text-[0.92rem] font-semibold rounded-xl border border-zinc-200 dark:border-zinc-700 hover:border-zinc-300 dark:hover:border-zinc-600 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-all duration-200 shadow-sm active:scale-[0.97]">
              Read Practical Guides
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
          </div>

          <!-- Stats strip -->
          <div class="hero-stagger-6 mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.8rem] text-zinc-400 dark:text-zinc-500">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
              <strong class="text-zinc-600 dark:text-zinc-300">{toolCount}</strong> Tools evaluated
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              <strong class="text-zinc-600 dark:text-zinc-300">{guideCount}</strong> In-depth guides
            </span>
          </div>
        </div>

        <!-- Right: Editor's Picks Mini-Dashboard -->
        <div class="hero-stagger-5 hidden md:block">
          <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-[var(--shadow-card)] overflow-hidden">
            <div class="px-5 py-3.5 border-b border-zinc-100 dark:border-zinc-800 flex items-center justify-between">
              <span class="text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-amber-600 dark:text-amber-400">Editor's Picks</span>
              <a href="/tools/" class="text-[0.72rem] font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 transition-colors">View all</a>
            </div>
            <div class="divide-y divide-zinc-100 dark:divide-zinc-800">
              {heroTools.map((tool, i) => {
                const pricingDisplay = pricingConfig[tool.data.pricing]?.label ?? tool.data.pricing;
                return (
                  <a href={`/tools/${tool.id}/`} class="group flex items-center gap-3.5 px-5 py-3.5 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">
                    <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-100 to-indigo-50 dark:from-indigo-900/40 dark:to-indigo-900/20 flex items-center justify-center">
                      <span class="text-[0.7rem] font-bold text-indigo-600 dark:text-indigo-400">#{i+1}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-[0.85rem] font-semibold text-zinc-900 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">{tool.data.toolName}</p>
                      <p class="text-[0.72rem] text-zinc-400 truncate">{tool.data.bestFor.slice(0,2).join(', ')}</p>
                    </div>
                    <span class="flex-shrink-0 rounded-full bg-zinc-100 px-2 py-1 text-[0.68rem] font-semibold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{pricingDisplay}</span>
                  </a>
                );
              })}
            </div>
            <div class="px-5 py-3 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-800/30">
              <div class="flex items-center gap-1.5 text-[0.72rem] text-zinc-400">
                <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                Part of the <a href="https://www.urduai.org" target="_blank" rel="noopener" class="inline-flex items-baseline" style="font-family: 'Montserrat', sans-serif;"><span class="font-bold text-zinc-600 dark:text-zinc-300">Urdu</span><span class="font-bold" style="color: #F0C75E;">AI</span></a> network · 1M+ community
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 border-t border-zinc-100 dark:border-zinc-800">
    <div class="page-container">
      <div class="flex items-end justify-between mb-10" data-reveal>
        <div>
          <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-3 block">AI Tools</span>
          <h2 class="text-zinc-900 dark:text-zinc-50 mb-3">Research-led. Explained plainly.</h2>
          <p class="text-zinc-500 dark:text-zinc-400 text-lg max-w-xl">We evaluate tools against practical workflows, verify current pricing and limitations, and clearly distinguish hands-on experience from documentation-based research.</p>
        </div>
        <a href="/tools/" class="group hidden sm:inline-flex items-center gap-1.5 text-[0.85rem] font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          View all
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {topTools.map((tool, i) => {
          const pricingDisplay = pricingConfig[tool.data.pricing]?.label ?? tool.data.pricing;
          return (
            <a
              href={`/tools/${tool.id}/`}
              class="card-glow group flex flex-col bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)] overflow-hidden"
              data-reveal
              data-reveal-delay={`${i * 60}`}
            >
              {/* Branded Cover */}
              <div class="h-40 relative overflow-hidden">
                <EditorialCover title={tool.data.title} category={tool.data.category} variant="tool" compact={true} />
              </div>

              <div class="flex flex-col flex-1 p-5">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="text-[1.05rem] font-bold text-zinc-900 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{tool.data.toolName}</h3>
                  <span class="flex-shrink-0 ml-2 rounded-full bg-zinc-100 px-2 py-1 text-[0.68rem] font-semibold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">Editorial pick</span>
                </div>

                <p class="text-[0.8rem] text-zinc-500 dark:text-zinc-400 mb-3 line-clamp-2">{tool.data.bestFor.slice(0,3).join(' · ')}</p>

                <div class="mt-auto pt-3 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between">
                  <span class:list={['text-[0.72rem] font-semibold px-2 py-0.5 rounded-full', pricingConfig[tool.data.pricing]?.color ?? 'bg-zinc-50 text-zinc-600']}>
                    {pricingDisplay}
                  </span>
                  <span class="text-[0.78rem] font-medium text-indigo-600 dark:text-indigo-400 flex items-center gap-1 group-hover:gap-1.5 transition-all">
                    Read evaluation
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <div class="mt-6 text-center sm:hidden" data-reveal>
        <a href="/tools/" class="group inline-flex items-center gap-2 text-[0.85rem] font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          View all tool evaluations
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════ LATEST GUIDES — Editorial Grid ═══════════════════ -->
  <section class="py-14 md:py-20 bg-white dark:bg-[var(--color-bg)] border-t border-zinc-100 dark:border-zinc-800">
    <div class="page-container">
      <div class="flex items-end justify-between mb-10" data-reveal>
        <div>
          <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-3 block">Guides</span>
          <h2 class="text-zinc-900 dark:text-zinc-50">Latest from AIViewer</h2>
        </div>
        <a href="/guides/" class="group hidden sm:inline-flex items-center gap-1.5 text-[0.85rem] font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          View all
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>

      {/* Featured Guide — Hero Card */}
      {featuredGuide && (
        <a href={`/guides/${featuredGuide.id}/`} class="card-glow group grid grid-cols-1 md:grid-cols-[280px_1fr] rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)] mb-4" data-reveal>
          <div class="h-56 md:h-auto relative overflow-hidden">
            <EditorialCover title={featuredGuide.data.title} category={featuredGuide.data.category} variant="guide" layout="hero" showTitle={false} />
          </div>
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2.5 py-0.5 rounded-full">New</span>
              <span class="text-[0.72rem] font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">{categoryLabels[featuredGuide.data.category] ?? featuredGuide.data.category}</span>
            </div>
            <h3 class="text-xl md:text-2xl font-bold text-zinc-900 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-3 leading-tight">
              {featuredGuide.data.title}
            </h3>
            <p class="text-[0.9rem] text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4 line-clamp-2">{featuredGuide.data.description}</p>
            <div class="flex items-center gap-4 text-[0.78rem] text-zinc-400">
              <span>{getReadingTime(featuredGuide.body)}</span>
              <span class="text-zinc-300 dark:text-zinc-600">|</span>
              <span>{formatDateShort(featuredGuide.data.publishedDate)}</span>
            </div>
          </div>
        </a>
      )}

      {/* Supporting Guides Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {gridGuides.map((guide, i) => (
          <a
            href={`/guides/${guide.id}/`}
            class="card-glow group flex flex-col bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]"
            data-reveal
            data-reveal-delay={`${i * 60}`}
          >
            <div class="h-36 relative overflow-hidden">
              <EditorialCover title={guide.data.title} category={guide.data.category} variant="guide" compact={true} />
            </div>
            <div class="p-4 flex-1 flex flex-col">
              <span class="text-[0.65rem] font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 mb-1.5">{categoryLabels[guide.data.category] ?? guide.data.category}</span>
              <h3 class="text-[0.88rem] font-semibold text-zinc-900 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug mb-2 line-clamp-2">
                {guide.data.title}
              </h3>
              <span class="mt-auto text-[0.72rem] text-zinc-400">{getReadingTime(guide.body)}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6 text-center sm:hidden" data-reveal>
        <a href="/guides/" class="group inline-flex items-center gap-1.5 text-[0.85rem] font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          View all guides
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>
    </div>
  </section>


  <section class="py-10 md:py-14 border-t border-zinc-100 dark:border-zinc-800">
    <div class="page-container max-w-3xl mx-auto" data-reveal>
      <NewsletterSignup />
    </div>
  </section>

  <!-- ═══════════════════ WHY AIVIEWER ═══════════════════ -->
  <section class="py-14 md:py-20 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30">
    <div class="page-container">
      <div class="max-w-3xl mx-auto text-center mb-12" data-reveal>
        <h2 class="text-zinc-900 dark:text-zinc-50 mb-4">Why people read AIViewer</h2>
        <p class="text-zinc-500 dark:text-zinc-400 text-lg">We don't write for AI insiders. We write for everyone else.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="text-center" data-reveal data-reveal-delay="0">
          <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7">
              <path d="M2 16c3-8 5 10 8 0s4 8 7-2" stroke="#A5B4FC" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
              <path d="M20 16h10" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="19" cy="16" r="2.5" fill="#F0C75E"/>
              <path d="M30 16l-2.5-2v4z" fill="#4F46E5"/>
            </svg>
          </div>
          <h3 class="text-[0.95rem] font-semibold text-zinc-900 dark:text-zinc-50 mb-2">No jargon</h3>
          <p class="text-[0.85rem] text-zinc-500 dark:text-zinc-400 leading-relaxed">We explain AI in plain language. If a concept is technical, we translate it.</p>
        </div>
        <div class="text-center" data-reveal data-reveal-delay="120">
          <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7">
              <path d="M4 4h24l-8.5 10v7l-7 3V14z" fill="#D1FAE5" stroke="#059669" stroke-width="1.5" stroke-linejoin="round" class="dark:fill-emerald-900/50"/>
              <circle cx="8" cy="3" r="1.2" fill="#D4D4D8"/>
              <circle cx="14" cy="2" r="0.8" fill="#D4D4D8"/>
              <circle cx="22" cy="2.5" r="1.2" fill="#D4D4D8"/>
              <circle cx="16.5" cy="28" r="2" fill="#F0C75E"/>
              <circle cx="16.5" cy="28" r="0.8" fill="#fff"/>
            </svg>
          </div>
          <h3 class="text-[0.95rem] font-semibold text-zinc-900 dark:text-zinc-50 mb-2">No hype</h3>
          <p class="text-[0.85rem] text-zinc-500 dark:text-zinc-400 leading-relaxed">We separate what actually works from what sounds impressive in a press release.</p>
        </div>
        <div class="text-center" data-reveal data-reveal-delay="240">
          <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7">
              <rect x="2" y="10" width="12" height="12" rx="2" fill="#FDE68A" stroke="#D97706" stroke-width="1.2" class="dark:fill-amber-900/50"/>
              <path d="M14 14c1.5-2.5 4.5-2.5 6 0" fill="#FDE68A" stroke="#D97706" stroke-width="1.2" class="dark:fill-amber-900/50"/>
              <rect x="18" y="10" width="12" height="12" rx="2" fill="#F0C75E" stroke="#D97706" stroke-width="1.2" opacity="0.7" stroke-dasharray="3 2"/>
              <path d="M26 6v3M24 7.5h4" stroke="#D97706" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
              <path d="M25 17l2.5 2.5-2.5 2.5" stroke="#4F46E5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M22 19.5h5.5" stroke="#4F46E5" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="text-[0.95rem] font-semibold text-zinc-900 dark:text-zinc-50 mb-2">Actually useful</h3>
          <p class="text-[0.85rem] text-zinc-500 dark:text-zinc-400 leading-relaxed">Every article includes something you can use, test, or apply to your work today.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════ NETWORK CTA ═══════════════════ -->
  <section class="py-16 md:py-20 bg-zinc-900 border-t border-zinc-800">
    <div class="page-container">
      <div class="max-w-2xl mx-auto text-center" data-reveal>
        <div class="inline-flex items-baseline gap-0 mb-5" style="font-family: 'Montserrat', sans-serif;">
          <span class="text-2xl font-extrabold" style="color: #F0C75E;">AI</span>
          <span class="text-2xl font-extrabold text-white">Viewer</span>
        </div>

