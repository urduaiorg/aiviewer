---
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight, BookOpen, Laptop, Play, SlidersHorizontal, Link, Lightbulb, Target, FileText } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WebsiteSchema from '../components/seo/WebsiteSchema.astro';
import EditorialCover from '../components/content/EditorialCover.astro';
import { isPublishedGuide } from '../components/editorial/model';
import { shouldNoindexPath } from '../utils/indexPolicy';
import { getReadingTime } from '../utils/readingTime';
import '../styles/learner-home.css';

const guides = (await getCollection('guides', ({ data }) => isPublishedGuide(data)))
  .filter((entry) => entry.data.publication.index && !entry.data.historical && !shouldNoindexPath(`/guides/${entry.id}/`));
const selected = [
  { id: 'ai-basics-models-assistants-agents', label: 'The basics', outcome: 'Tell models, assistants and agents apart—and know when each is useful.', title: 'AI models, assistants and agents—explained' },
  { id: 'how-to-verify-an-ai-answer', label: 'Practical skills', outcome: 'Turn a confident answer into claims you can check against original sources.', title: 'How to check an AI answer' },
  { id: 'gemini-workspace-cross-app-actions-explained', label: 'AI in practice', outcome: 'Understand connected workflows, their limits and where your approval matters.', title: 'Gemini across Gmail, Docs and Sheets' },
].flatMap((item) => {
  const entry = guides.find((guide) => guide.id === item.id);
  return entry ? [{ ...item, entry }] : [];
});
const paths = [
  { title: 'AI essentials', description: 'Understand the ideas', href: '/learn/', Icon: BookOpen },
  { title: 'Everyday work', description: 'Make useful progress', href: '/practical-guides/', Icon: Laptop },
  { title: 'Learn by watching', description: 'Explore video lessons', href: '/video-lessons/', Icon: Play },
  { title: 'Choosing tools', description: 'Find the right fit', href: '/tools/', Icon: SlidersHorizontal },
];
const principles = [
  { title: 'Start with the source', description: 'Find links to original material.', Icon: Link },
  { title: 'Understand the idea', description: 'Clear English, without the jargon.', Icon: Lightbulb },
  { title: 'Put it into practice', description: 'Small exercises for real tasks.', Icon: Target },
];
---
<BaseLayout title="AIViewer.ai" seoTitle="Learn AI at Your Own Pace | AIViewer" description="Clear explanations, practical AI lessons and free exercises. Build useful skills, one small step at a time." monetize={false}>
  <WebsiteSchema slot="head" />
  <Header slot="header" />
  <div class="learner-home">
    <section class="learn-hero" aria-labelledby="homepage-title">
      <div class="learn-shell learn-hero__grid">
        <div class="learn-hero__copy">
          <p class="learn-eyebrow">A little curiosity goes a long way</p>
          <h1 id="homepage-title">Understand AI.<br />Use it <span>well.</span></h1>
          <p class="learn-hero__intro">Explore clear explanations and practical lessons.<br class="desktop-break" /> Build useful AI skills, one small step at a time.</p>
          <div class="learn-actions">
            <a class="learn-button" href="/guides/ai-basics-models-assistants-agents/">Find your first lesson <ArrowRight size={19} aria-hidden="true" /></a>
            <a class="learn-text-link" href="/guides/">Explore the guides</a>
          </div>
          <p class="learn-hero__note">Start with the basics. Learn at your own pace.</p>
        </div>
        <figure class="learn-hero__art">
          <img src="/images/editorial/learner-home-hero-v1.webp" srcset="/images/editorial/learner-home-hero-v1-800.webp 800w, /images/editorial/learner-home-hero-v1.webp 1600w" sizes="(max-width: 700px) 100vw, 52vw" width="1600" height="1000" fetchpriority="high" alt="An open ivory book forms gentle steps toward a small green plant and an amber sun." />
          <figcaption><strong>Small steps. Useful skills.</strong><span>Your learning starts here.</span></figcaption>
        </figure>
      </div>
    </section>
    <section class="learn-shell learn-paths" aria-labelledby="paths-title">
      <h2 id="paths-title">What would you like to learn?</h2>
      <div class="learn-paths__grid">
        {paths.map(({ title, description, href, Icon }) => (
          <a href={href} class="learn-path">
            <span class="learn-icon"><Icon size={29} strokeWidth={1.6} aria-hidden="true" /></span>
            <span class="learn-path__title">{title}<ArrowRight size={18} aria-hidden="true" /></span>
            <span class="learn-path__description">{description}</span>
          </a>
        ))}
      </div>
    </section>
    <section class="learn-shell learn-lessons" aria-labelledby="lessons-title">
      <div class="learn-section-heading">
        <div><h2 id="lessons-title">A good place to begin</h2><p>Clear starting points for curious minds.</p></div>
        <a class="learn-text-link" href="/guides/">Explore all lessons <ArrowUpRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="learn-lessons__grid">
        {selected.map(({ entry, label, title, outcome }) => (
          <article class="learn-card">
            <a href={`/guides/${entry.id}/`} class="learn-card__link" aria-labelledby={`lesson-${entry.id}`}>
              <div class="learn-card__image"><EditorialCover image={entry.data.coverImage} title={entry.data.title} category={entry.data.category} compact={true} showTitle={false} badge="" /></div>
              <div class="learn-card__copy"><p class="learn-category">{label}</p><h3 id={`lesson-${entry.id}`}>{title}</h3><p class="learn-card__outcome">{outcome}</p><p class="learn-card__meta">{entry.data.format === 'ai-signal' ? 'Explainer' : 'Step-by-step'} <span aria-hidden="true">·</span> {getReadingTime(entry.body ?? '')}<ArrowUpRight size={18} aria-hidden="true" /></p></div>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="learn-practice" aria-labelledby="practice-title">
      <div class="learn-shell learn-practice__grid">
        <img src="/images/editorial/learner-practice-v1.webp" srcset="/images/editorial/learner-practice-v1-800.webp 800w, /images/editorial/learner-practice-v1.webp 1600w" sizes="(max-width: 700px) 100vw, 45vw" alt="An open notebook and pencil in a warm, sunlit workspace, ready for a practical exercise." width="1600" height="900" loading="lazy" decoding="async" />
        <div><p class="learn-eyebrow">Learn by doing</p><h2 id="practice-title">One useful skill.<br />Something you can try today.</h2><p class="learn-practice__description">Follow a practical guide, try the exercise, and take away something you can use.</p><a class="learn-button learn-button--dark" href="/practical-guides/">Explore practical guides <ArrowRight size={19} aria-hidden="true" /></a></div>
      </div>
    </section>
    <section class="learn-shell learn-values" aria-labelledby="values-title">
      <h2 id="values-title">A clearer way to learn.</h2>
      <div class="learn-values__grid">{principles.map(({ title, description, Icon }) => (<div class="learn-value"><span class="learn-icon"><Icon size={27} strokeWidth={1.7} aria-hidden="true" /></span><div><h3>{title}</h3><p>{description}</p></div></div>))}</div>
      <div class="learn-resource"><span class="learn-icon"><FileText size={28} strokeWidth={1.6} aria-hidden="true" /></span><div><h3>Keep something useful.</h3><p>Download practical worksheets and return whenever you need them.</p></div><a class="learn-button learn-button--outline" href="/download/">Browse free resources <ArrowRight size={18} aria-hidden="true" /></a></div>
      <p class="learn-credit">Original illustrations and fictional learning scenes created with AI. <a href="/ai-use/">How AIViewer uses AI</a></p>
    </section>
  </div>
  <Footer slot="footer" compact={true} />
</BaseLayout>
