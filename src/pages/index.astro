---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { pricingConfig, categoryLabels } from '../data/site.config';
import { getReadingTime } from '../utils/readingTime';
import NewsletterSignup from '../components/content/NewsletterSignup.astro';

// Pull featured tools (or all if none featured), sorted by rating
const allTools = await getCollection('tools', ({ data }) => !data.draft);
const featuredTools = allTools
  .filter((t) => t.data.featured)
  .sort((a, b) => b.data.rating - a.data.rating)
  .slice(0, 3);
const displayTools = featuredTools.length > 0 ? featuredTools : allTools.sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);

// Pull latest guides, sorted by date
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const latestGuides = allGuides
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 4);

// Pull featured playbooks for badges
const allPlaybooks = await getCollection('playbooks', ({ data }) => !data.draft);
const featuredPlaybooks = allPlaybooks.filter((p) => p.data.featured);
---

<BaseLayout
  title="AIViewer.ai"
  description="Practical AI knowledge for everyone. Clear guides, tool reviews, and playbooks to help teachers, students, businesses, and communities actually use AI."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "AIViewer.ai",
      "url": "https://aiviewer.ai",
      "description": "Practical AI knowledge for everyone. Clear guides, tool reviews, and playbooks.",
      "publisher": {
        "@type": "Organization",
        "name": "AIViewer.ai",
        "url": "https://aiviewer.ai",
        "logo": { "@type": "ImageObject", "url": "https://aiviewer.ai/og-default.png" }
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "https://aiviewer.ai/?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    })} />
  </Fragment>
  <Header />

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative overflow-hidden">
    <!-- Subtle gradient orbs -->
    <div class="absolute top-[-20%] right-[-10%] w-[600px] h-[600px] rounded-full bg-indigo-100/40 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-[-30%] left-[-15%] w-[500px] h-[500px] rounded-full bg-amber-100/30 blur-3xl pointer-events-none"></div>

    <div class="page-container relative">
      <div class="pt-20 pb-24 md:pt-28 md:pb-32 max-w-3xl">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-amber-50 border border-amber-200 rounded-full mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span class="text-xs font-semibold text-amber-700 tracking-wide uppercase">AI made practical</span>
        </div>

        <h1 class="text-zinc-900 mb-5" style="letter-spacing: -0.035em; line-height: 1.08;">
          Understand AI.<br/>
          <span style="color: #F0C75E;">Actually use it.</span>
        </h1>

        <p class="text-lg md:text-xl text-zinc-500 leading-relaxed max-w-xl mb-10">
          No jargon. No hype. Just clear playbooks, honest tool reviews, and practical guides for people who want AI to work for them.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-3.5">
          <a
            href="/playbooks/"
            class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-zinc-900 text-white text-[0.92rem] font-semibold rounded-xl hover:bg-zinc-800 transition-all duration-200 shadow-lg shadow-zinc-900/10"
          >
            Explore Playbooks
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="/tools/"
            class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-white text-zinc-700 text-[0.92rem] font-semibold rounded-xl border border-zinc-200 hover:border-zinc-300 hover:bg-zinc-50 transition-all duration-200 shadow-sm"
          >
            Browse AI Tools
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

        <!-- Social proof -->
        <div class="mt-10 flex items-center gap-4 text-sm text-zinc-400">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Part of the <a href="https://www.urduai.org" target="_blank" rel="noopener" class="inline-flex items-baseline" style="font-family: 'Montserrat', sans-serif;"><span class="font-bold text-zinc-700">Urdu</span><span class="font-bold" style="color: #F0C75E;">AI</span></a> network
          </span>
          <span class="hidden sm:inline text-zinc-300">|</span>
          <span class="hidden sm:inline">1M+ community</span>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════ PLAYBOOKS SECTION ═══════════════════ -->
  <section class="py-20 md:py-28 bg-white border-t border-zinc-100">
    <div class="page-container">
      <!-- Section header -->
      <div class="max-w-2xl mb-14">
        <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-3 block">Playbooks</span>
        <h2 class="text-zinc-900 mb-4">Pick your role. Get your AI workflow.</h2>
        <p class="text-zinc-500 text-lg">Step-by-step guides built for real work. Each playbook includes tools, prompts, and workflows you can use today.</p>
      </div>

      <!-- Playbook grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Teachers — chalkboard with AI sparkle -->
        <a href="/playbooks/teachers/" class="group relative flex flex-col p-6 bg-white rounded-2xl border hover:border-indigo-200 transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]" style="border-color: #e4e4e7;">
          <span class="absolute top-4 right-4 text-[0.65rem] font-semibold uppercase tracking-wider text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">Most popular</span>
          <div class="w-11 h-11 rounded-xl mb-4">
            <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="4" y="8" width="28" height="20" rx="3" fill="#FEF3C7" stroke="#D97706" stroke-width="1.5"/>
              <line x1="10" y1="15" x2="26" y2="15" stroke="#D97706" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="10" y1="19" x2="22" y2="19" stroke="#D97706" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <line x1="10" y1="23" x2="18" y2="23" stroke="#D97706" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
              <path d="M34 6l1.5 3 3 0.5-2.2 2.1 0.5 3-2.8-1.5-2.8 1.5 0.5-3-2.2-2.1 3-0.5z" fill="#F0C75E"/>
              <circle cx="38" cy="18" r="1.5" fill="#F0C75E" opacity="0.5"/>
              <circle cx="36" cy="24" r="1" fill="#F0C75E" opacity="0.3"/>
            </svg>
          </div>
          <h3 class="text-[1.05rem] font-semibold text-zinc-900 group-hover:text-indigo-600 transition-colors mb-2">Teachers</h3>
          <p class="text-[0.85rem] text-zinc-500 leading-relaxed flex-1">Save 5–10 hours weekly on lesson planning, slides, and grading.</p>
          <div class="mt-4 flex items-center gap-1 text-[0.8rem] font-medium text-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity">View playbook <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></div>
        </a>
        <!-- Students — open book with lightbulb emerging -->
        <a href="/playbooks/students/" class="group relative flex flex-col p-6 bg-white rounded-2xl border hover:border-indigo-200 transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]" style="border-color: #e4e4e7;">
          <div class="w-11 h-11 rounded-xl mb-4">
            <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 32V12a2 2 0 012-2h10l4 4-4 4H8" fill="#EEF2FF" stroke="#6366F1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M38 32V12a2 2 0 00-2-2H26l-4 4 4 4h10" fill="#EEF2FF" stroke="#6366F1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="22" y1="16" x2="22" y2="34" stroke="#6366F1" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.4"/>
              <circle cx="22" cy="8" r="4" fill="#F0C75E" opacity="0.9"/>
              <path d="M22 5v2M20.5 6.5l1.5 1.5M23.5 6.5l-1.5 1.5" stroke="#fff" stroke-width="1" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="text-[1.05rem] font-semibold text-zinc-900 group-hover:text-indigo-600 transition-colors mb-2">Students</h3>
          <p class="text-[0.85rem] text-zinc-500 leading-relaxed flex-1">Research faster, write better papers, and study smarter.</p>
          <div class="mt-4 flex items-center gap-1 text-[0.8rem] font-medium text-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity">View playbook <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></div>
        </a>
        <!-- Small Business — rising bar chart with gear -->
        <a href="/playbooks/small-business/" class="group relative flex flex-col p-6 bg-white rounded-2xl border hover:border-indigo-200 transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]" style="border-color: #e4e4e7;">
          <div class="w-11 h-11 rounded-xl mb-4">
            <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="6" y="26" width="6" height="10" rx="1.5" fill="#E4E4E7"/>
              <rect x="15" y="20" width="6" height="16" rx="1.5" fill="#D4D4D8"/>
              <rect x="24" y="13" width="6" height="23" rx="1.5" fill="#A1A1AA"/>
              <path d="M8 24l8-6 8-5 7-5" stroke="#F0C75E" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 2"/>
              <circle cx="37" cy="10" r="5" fill="none" stroke="#F0C75E" stroke-width="1.5"/>
              <circle cx="37" cy="10" r="1.5" fill="#F0C75E"/>
              <path d="M37 5v1M37 14v1M32 10h1M41 10h1" stroke="#F0C75E" stroke-width="1" stroke-linecap="round" opacity="0.5"/>
            </svg>
          </div>
          <h3 class="text-[1.05rem] font-semibold text-zinc-900 group-hover:text-indigo-600 transition-colors mb-2">Small Business</h3>
          <p class="text-[0.85rem] text-zinc-500 leading-relaxed flex-1">Automate repetitive tasks, draft content, and manage operations.</p>
          <div class="mt-4 flex items-center gap-1 text-[0.8rem] font-medium text-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity">View playbook <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></div>
        </a>
        <!-- NGOs — connected nodes forming upward arrow -->
        <a href="/playbooks/ngos/" class="group relative flex flex-col p-6 bg-white rounded-2xl border hover:border-indigo-200 transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]" style="border-color: #e4e4e7;">
          <div class="w-11 h-11 rounded-xl mb-4">
            <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="10" cy="30" r="4" fill="#D1FAE5" stroke="#059669" stroke-width="1.5"/>
              <circle cx="34" cy="30" r="4" fill="#D1FAE5" stroke="#059669" stroke-width="1.5"/>
              <circle cx="22" cy="14" r="5" fill="#D1FAE5" stroke="#059669" stroke-width="1.5"/>
              <line x1="14" y1="28" x2="18" y2="18" stroke="#059669" stroke-width="1.2" opacity="0.4"/>
              <line x1="30" y1="28" x2="26" y2="18" stroke="#059669" stroke-width="1.2" opacity="0.4"/>
              <line x1="14" y1="30" x2="30" y2="30" stroke="#059669" stroke-width="1.2" opacity="0.4"/>
              <path d="M22 9l2.5 3h-5z" fill="#F0C75E"/>
              <circle cx="22" cy="14" r="1.5" fill="#F0C75E"/>
            </svg>
          </div>
          <h3 class="text-[1.05rem] font-semibold text-zinc-900 group-hover:text-indigo-600 transition-colors mb-2">NGOs</h3>
          <p class="text-[0.85rem] text-zinc-500 leading-relaxed flex-1">Write grants, measure impact, and communicate more effectively.</p>
          <div class="mt-4 flex items-center gap-1 text-[0.8rem] font-medium text-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity">View playbook <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></div>
        </a>
        <!-- Researchers — magnifying glass with data dots -->
        <a href="/playbooks/researchers/" class="group relative flex flex-col p-6 bg-white rounded-2xl border hover:border-indigo-200 transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]" style="border-color: #e4e4e7;">
          <div class="w-11 h-11 rounded-xl mb-4">
            <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="18" r="10" fill="#E0F2FE" stroke="#0284C7" stroke-width="1.5"/>
              <line x1="27" y1="25" x2="36" y2="34" stroke="#0284C7" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="16" cy="16" r="1.5" fill="#0284C7" opacity="0.3"/>
              <circle cx="22" cy="14" r="1" fill="#0284C7" opacity="0.5"/>
              <circle cx="18" cy="21" r="1.2" fill="#0284C7" opacity="0.4"/>
              <circle cx="24" cy="19" r="1.5" fill="#F0C75E"/>
              <circle cx="20" cy="17" r="2" fill="#F0C75E" opacity="0.6"/>
              <path d="M15 14l3 4 2-1.5 3 3 2-2" stroke="#F0C75E" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
            </svg>
          </div>
          <h3 class="text-[1.05rem] font-semibold text-zinc-900 group-hover:text-indigo-600 transition-colors mb-2">Researchers</h3>
          <p class="text-[0.85rem] text-zinc-500 leading-relaxed flex-1">Analyze papers, summarize findings, and speed up lit reviews.</p>
          <div class="mt-4 flex items-center gap-1 text-[0.8rem] font-medium text-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity">View playbook <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></div>
        </a>
        <!-- Creators — pen nib with flowing lines -->
        <a href="/playbooks/content-creators/" class="group relative flex flex-col p-6 bg-white rounded-2xl border hover:border-indigo-200 transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]" style="border-color: #e4e4e7;">
          <div class="w-11 h-11 rounded-xl mb-4">
            <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 36l4-14L28 6l6 6-16 16z" fill="#FFF1F2" stroke="#E11D48" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M12 22l6 6" stroke="#E11D48" stroke-width="1" opacity="0.3"/>
              <circle cx="10" cy="34" r="2" fill="#F0C75E"/>
              <path d="M18 32c4-2 8 1 12-1s6-4 8-3" stroke="#F0C75E" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7"/>
              <path d="M20 36c3-1.5 6 0.5 9-0.5s5-3 7-2" stroke="#F0C75E" stroke-width="1" stroke-linecap="round" fill="none" opacity="0.4"/>
            </svg>
          </div>
          <h3 class="text-[1.05rem] font-semibold text-zinc-900 group-hover:text-indigo-600 transition-colors mb-2">Creators</h3>
          <p class="text-[0.85rem] text-zinc-500 leading-relaxed flex-1">Produce content at scale without losing your voice or quality.</p>
          <div class="mt-4 flex items-center gap-1 text-[0.8rem] font-medium text-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity">View playbook <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></div>
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════ TOOLS SECTION ═══════════════════ -->
  <section class="py-20 md:py-28 border-t border-zinc-100">
    <div class="page-container">
      <div class="max-w-2xl mb-14">
        <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-3 block">AI Tools</span>
        <h2 class="text-zinc-900 mb-4">Honest reviews. No affiliate fluff.</h2>
        <p class="text-zinc-500 text-lg">We test every tool on real tasks and tell you exactly where it works, where it doesn't, and who it's actually for.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {displayTools.map((tool) => {
          const pricingDisplay = pricingConfig[tool.data.pricing]?.label ?? tool.data.pricing;
          const badge = tool.data.featured ? 'Featured Review' : (categoryLabels[tool.data.category] ?? tool.data.category);
          return (
            <a
              href={`/tools/${tool.id}/`}
              class="group flex flex-col p-6 bg-white rounded-2xl border transition-card shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]"
              style="border-color: #e4e4e7;"
            >
              <div class="flex items-start justify-between mb-5">
                <div>
                  <span class="inline-block text-[0.65rem] font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full mb-2.5">
                    {badge}
                  </span>
                  <h3 class="text-xl font-bold text-zinc-900 group-hover:text-indigo-600 transition-colors">{tool.data.toolName}</h3>
                </div>
                <div class="flex items-center gap-1 mt-1">
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <span class="text-sm font-semibold text-zinc-700">{tool.data.rating.toFixed(1)}</span>
                </div>
              </div>

              <p class="text-[0.85rem] text-zinc-500 mb-1.5">Best for:</p>
              <p class="text-[0.85rem] text-zinc-700 font-medium mb-4">{tool.data.bestFor.join(', ')}</p>

              <div class="mt-auto pt-4 border-t border-zinc-100 flex items-center justify-between">
                <span class:list={['text-[0.75rem] font-semibold px-2 py-0.5 rounded-full', pricingConfig[tool.data.pricing]?.color ?? 'bg-zinc-50 text-zinc-600']}>
                  {pricingDisplay}
                </span>
                <span class="text-[0.8rem] font-medium text-indigo-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                  Read review
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </span>
              </div>
            </a>
          );
        })}
      </div>

      <div class="mt-8 text-center">
        <a
          href="/tools/"
          class="inline-flex items-center gap-2 text-[0.85rem] font-medium text-zinc-500 hover:text-zinc-900 transition-colors"
        >
          View all tool reviews
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════ LATEST GUIDES ═══════════════════ -->
  <section class="py-20 md:py-28 bg-white border-t border-zinc-100">
    <div class="page-container">
      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-3 block">Guides</span>
          <h2 class="text-zinc-900">Latest from AIViewer</h2>
        </div>
        <a
          href="/guides/"
          class="hidden sm:inline-flex items-center gap-1.5 text-[0.85rem] font-medium text-zinc-500 hover:text-zinc-900 transition-colors"
        >
          View all
