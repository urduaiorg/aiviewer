---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { categoryLabels, pricingConfig } from '../../data/site.config';

// Fetch all tools to power the quiz recommendations
const allTools = await getCollection('tools', ({ data }) => !data.draft);

// Pre-process tools into a clean JSON object for the client-side script
const toolsData = allTools.map((tool) => ({
  id: tool.id,
  name: tool.data.toolName,
  verdict: tool.data.verdict,
  description: tool.data.description,
  rating: tool.data.rating,
  pricing: tool.data.pricing,
  pricingLabel: pricingConfig[tool.data.pricing]?.label || tool.data.pricing,
  pricingColorText: pricingConfig[tool.data.pricing]?.color.split(' ')[1] || 'text-zinc-600',
  pricingColorBg: pricingConfig[tool.data.pricing]?.color.split(' ')[0] || 'bg-zinc-50',
  bestFor: tool.data.bestFor,
  website: tool.data.website,
  affiliateUrl: tool.data.affiliateUrl,
  category: tool.data.category,
  badge: tool.data.featured ? 'Our Pick' : (categoryLabels[tool.data.category] || tool.data.category),
  url: `/tools/${tool.id}/`
}));
---

<BaseLayout
  title="AI Tool Finder Quiz"
  description="Answer 5 quick questions to find the perfect AI tools for your specific role, budget, and technical level."
>
  <Header />

  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)] min-h-[calc(100vh-4.25rem)] flex flex-col">
    <!-- Background gradients -->
    <div class="absolute inset-x-0 top-0 h-[500px] bg-[radial-gradient(circle_at_top,_rgba(79,70,229,0.08),_transparent_50%),linear-gradient(180deg,rgba(240,199,94,0.05),transparent_75%)] dark:bg-[radial-gradient(circle_at_top,_rgba(79,70,229,0.05),_transparent_50%),linear-gradient(180deg,rgba(240,199,94,0.03),transparent_75%)] pointer-events-none"></div>

    <div class="page-container relative py-12 md:py-16 flex-1 flex flex-col">
      <Breadcrumbs items={[{ label: 'AI Tool Finder' }]} />

      <div class="max-w-2xl mx-auto w-full mt-8 md:mt-12 flex-1 flex flex-col">
        <!-- Header -->
        <div class="text-center mb-10" id="quiz-header" data-reveal>
          <span class="inline-flex items-center gap-2 rounded-full border border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400 mb-4">
            Interactive Quiz
          </span>
          <h1 class="text-3xl md:text-4xl font-bold text-zinc-950 dark:text-zinc-50 mb-4">Find Your Perfect AI Stack</h1>
          <p class="text-lg text-zinc-600 dark:text-zinc-400">Answer 5 quick questions to get personalized tool recommendations based on your needs.</p>
        </div>

        <!-- Quiz Container -->
        <div class="bg-white dark:bg-zinc-900 rounded-[2rem] border border-zinc-200 dark:border-zinc-800 shadow-[var(--shadow-card)] p-6 md:p-10 relative overflow-hidden flex-1 flex flex-col" id="quiz-container" data-reveal data-reveal-delay="100">
          
          <!-- Progress Bar -->
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-zinc-100 dark:bg-zinc-800" id="progress-track">
            <div class="h-full bg-indigo-600 transition-all duration-500 ease-out w-[20%]" id="progress-bar"></div>
          </div>

          <!-- Questions Area -->
          <div id="questions-area" class="flex-1 flex flex-col justify-center">
            <!-- Step 1: Role -->
            <div class="quiz-step active" data-step="1">
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-6 text-center">What best describes your role?</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button class="quiz-option" data-key="role" data-value="creator">✍️ Content Creator / Marketer</button>
                <button class="quiz-option" data-key="role" data-value="developer">💻 Software Developer</button>
                <button class="quiz-option" data-key="role" data-value="student">🎓 Student / Academic</button>
                <button class="quiz-option" data-key="role" data-value="business">🏢 Small Business Owner</button>
                <button class="quiz-option" data-key="role" data-value="designer">🎨 Designer / Artist</button>
                <button class="quiz-option" data-key="role" data-value="general">👤 General Productivity</button>
              </div>
            </div>

            <!-- Step 2: Need -->
            <div class="quiz-step hidden" data-step="2">
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-6 text-center">What is your primary goal?</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button class="quiz-option" data-key="need" data-value="writing">Writing & Copywriting</button>
                <button class="quiz-option" data-key="need" data-value="research">Research & Analysis</button>
                <button class="quiz-option" data-key="need" data-value="coding">Writing Code</button>
                <button class="quiz-option" data-key="need" data-value="design">Creating Images & Video</button>
                <button class="quiz-option" data-key="need" data-value="audio">Voice & Audio</button>
                <button class="quiz-option" data-key="need" data-value="productivity">General Organization</button>
              </div>
            </div>

            <!-- Step 3: Technical Level -->
            <div class="quiz-step hidden" data-step="3">
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-6 text-center">How technical are you?</h2>
              <div class="flex flex-col gap-3">
                <button class="quiz-option text-left" data-key="tech" data-value="beginner">
                  <div class="font-bold">Beginner</div>
                  <div class="text-sm text-zinc-500 dark:text-zinc-400 font-normal mt-1">I want something simple that works out of the box. No setup required.</div>
                </button>
                <button class="quiz-option text-left" data-key="tech" data-value="intermediate">
                  <div class="font-bold">Intermediate</div>
                  <div class="text-sm text-zinc-500 dark:text-zinc-400 font-normal mt-1">I'm comfortable tweaking settings, writing prompts, and connecting apps.</div>
                </button>
                <button class="quiz-option text-left" data-key="tech" data-value="advanced">
                  <div class="font-bold">Advanced</div>
                  <div class="text-sm text-zinc-500 dark:text-zinc-400 font-normal mt-1">I want deep control, APIs, and the absolute best performance possible.</div>
                </button>
              </div>
            </div>

            <!-- Step 4: Budget -->
            <div class="quiz-step hidden" data-step="4">
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-6 text-center">What is your monthly budget?</h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <button class="quiz-option" data-key="budget" data-value="free">
                  <div class="font-bold mb-1">Free only</div>
                  <div class="text-xs text-zinc-500 dark:text-zinc-400 font-normal">$0 / month</div>
                </button>
                <button class="quiz-option" data-key="budget" data-value="low">
                  <div class="font-bold mb-1">Standard</div>
                  <div class="text-xs text-zinc-500 dark:text-zinc-400 font-normal">Up to $20 / month</div>
                </button>
                <button class="quiz-option" data-key="budget" data-value="high">
                  <div class="font-bold mb-1">Premium</div>
                  <div class="text-xs text-zinc-500 dark:text-zinc-400 font-normal">Willing to pay for the best</div>
                </button>
              </div>
            </div>

            <!-- Step 5: Team vs Solo -->
            <div class="quiz-step hidden" data-step="5">
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-6 text-center">Who will be using these tools?</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button class="quiz-option py-8" data-key="team" data-value="solo">
                  <div class="font-bold text-lg mb-2">Just Me</div>
                  <div class="text-sm text-zinc-500 dark:text-zinc-400 font-normal">Individual contributor or freelancer.</div>
                </button>
                <button class="quiz-option py-8" data-key="team" data-value="team">
                  <div class="font-bold text-lg mb-2">My Team</div>
                  <div class="text-sm text-zinc-500 dark:text-zinc-400 font-normal">I need collaboration features and admin controls.</div>
                </button>
              </div>
            </div>
          </div>

          <!-- Controls -->
          <div class="mt-8 flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 pt-6">
            <button id="btn-back" class="hidden text-sm font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" type="button">
              &larr; Back
            </button>
            <div class="text-sm font-medium text-zinc-400" id="step-counter">Step 1 of 5</div>
          </div>
        </div>

        <!-- Results Area (Hidden initially) -->
        <div id="results-area" class="hidden flex-col gap-6 mt-4">
          <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 mb-4">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50 mb-3">Your AI Stack</h2>
            <p class="text-zinc-600 dark:text-zinc-400">Based on your answers, here are the best tools for you.</p>
          </div>

          <div id="results-grid" class="grid grid-cols-1 gap-6">
            <!-- Cards injected via JS -->
          </div>

          <div class="text-center mt-8">
            <button id="btn-restart" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-zinc-700 dark:text-zinc-200 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-all shadow-sm">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Retake Quiz
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />

  <style>
    .quiz-option {
      @apply w-full p-4 md:p-5 rounded-xl border-2 border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/50 text-zinc-700 dark:text-zinc-300 font-semibold transition-all duration-200 text-center hover:border-indigo-300 dark:hover:border-indigo-600 hover:bg-indigo-50/50 dark:hover:bg-indigo-900/20 active:scale-[0.98];
    }
    
    /* Animation classes */
    .fade-in {
      animation: fadeIn 0.4s ease-out forwards;
    }
    .fade-out {
      animation: fadeOut 0.3s ease-out forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes fadeOut {
      from { opacity: 1; transform: translateY(0); }
      to { opacity: 0; transform: translateY(-10px); }
    }
  </style>

  <script is:inline define:vars={{ toolsData }}>
    // We pass the toolsData directly into the client-side script
    document.addEventListener('astro:page-load', () => {
      const state = {
        step: 1,
        answers: {
          role: null,
          need: null,
          tech: null,
          budget: null,
          team: null
        }
      };

      const totalSteps = 5;
      
      const quizContainer = document.getElementById('quiz-container');
      const resultsArea = document.getElementById('results-area');
      const resultsGrid = document.getElementById('results-grid');
      const btnBack = document.getElementById('btn-back');
      const btnRestart = document.getElementById('btn-restart');
      const stepCounter = document.getElementById('step-counter');
      const progressBar = document.getElementById('progress-bar');
      const quizHeader = document.getElementById('quiz-header');

      if (!quizContainer) return; // Prevent errors on other pages if script leaks

      // Initialize
      bindOptions();
      updateUI();

      function bindOptions() {
        document.querySelectorAll('.quiz-option').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const button = e.currentTarget;
            const key = button.getAttribute('data-key');
            const val = button.getAttribute('data-value');
            
            // Visual feedback on click
            button.classList.add('border-indigo-600', 'dark:border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/30');
            
            // Save answer and proceed
            setTimeout(() => {
              state.answers[key] = val;
              nextStep();
            }, 250);
          });
        });

        btnBack?.addEventListener('click', prevStep);
        btnRestart?.addEventListener('click', restartQuiz);
      }

      function nextStep() {
        if (state.step < totalSteps) {
          transitionStep(state.step, state.step + 1);
          state.step++;
          updateUI();
        } else {
          showResults();
        }
      }

      function prevStep() {
        if (state.step > 1) {
          transitionStep(state.step, state.step - 1);
          state.step--;
          updateUI();
        }
      }

      function restartQuiz() {
        state.step = 1;
        state.answers = { role: null, need: null, tech: null, budget: null, team: null };
        
        // Reset styles
        document.querySelectorAll('.quiz-option').forEach(btn => {
          btn.classList.remove('border-indigo-600', 'dark:border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/30');
        });

        resultsArea.classList.add('hidden');
        quizHeader.classList.remove('hidden');
        quizContainer.classList.remove('hidden');
        
        document.querySelectorAll('.quiz-step').forEach(el => {
          el.classList.add('hidden');
          el.classList.remove('active', 'fade-in', 'fade-out');
        });
        
        document.querySelector('[data-step="1"]').classList.remove('hidden');
        document.querySelector('[data-step="1"]').classList.add('active', 'fade-in');
        
        updateUI();
      }

      function transitionStep(oldStep, newStep) {
        const oldEl = document.querySelector(`[data-step="${oldStep}"]`);
        const newEl = document.querySelector(`[data-step="${newStep}"]`);
        
        oldEl.classList.remove('fade-in');
        oldEl.classList.add('fade-out');
        
        setTimeout(() => {
          oldEl.classList.add('hidden');
          oldEl.classList.remove('active', 'fade-out');
          
          newEl.classList.remove('hidden');
          newEl.classList.add('active', 'fade-in');
        }, 300);
      }

      function updateUI() {
        stepCounter.textContent = `Step ${state.step} of ${totalSteps}`;
        progressBar.style.width = `${(state.step / totalSteps) * 100}%`;
        
        if (state.step > 1) {
          btnBack.classList.remove('hidden');
        } else {
          btnBack.classList.add('hidden');
        }
      }

      function getRecommendations() {
        // Scoring logic based on answers
        let scoredTools = toolsData.map(tool => {
          let score = 0;
          
          // Role matching (loose matching via category/bestFor)
          if (state.answers.role === 'developer' && tool.category === 'coding') score += 5;
          if (state.answers.role === 'designer' && tool.category === 'design') score += 5;
          if (state.answers.role === 'creator' && ['video', 'writing', 'design'].includes(tool.category)) score += 3;
          if (state.answers.role === 'student' && ['research', 'writing', 'education'].includes(tool.category)) score += 4;
          
          // Need matching (strong matching)
          if (state.answers.need === tool.category) score += 6;
          
          // Budget matching
          if (state.answers.budget === 'free') {
            if (tool.pricing === 'free') score += 5;
            if (tool.pricing === 'freemium') score += 2;
            if (tool.pricing === 'paid') score -= 10; // Penalize paid if they want free
          } else if (state.answers.budget === 'high' && tool.pricing === 'paid') {
            score += 2; // High budget users don't mind paid tools
          }

          // Technical matching
          if (state.answers.tech === 'beginner' && tool.id === 'midjourney') score -= 3; // Midjourney is hard for beginners
          if (state.answers.tech === 'beginner' && tool.id === 'chatgpt') score += 3; // ChatGPT is easy

          // Add base rating to resolve ties
          score += tool.rating;

          return { ...tool, score };
        });

        // Sort by score descending
        scoredTools.sort((a, b) => b.score - a.score);
        
        // Return top 3
        return scoredTools.slice(0, 3);
      }

      function showResults() {
        const topTools = getRecommendations();
        
        quizContainer.classList.add('hidden');
        quizHeader.classList.add('hidden');
        resultsArea.classList.remove('hidden');
        resultsArea.classList.add('fade-in');

        // Render cards (matching ToolPickBox style)
        resultsGrid.innerHTML = topTools.map(tool => {
          // Generate stars
          const fullStars = Math.floor(tool.rating);
          const hasHalf = tool.rating % 1 >= 0.5;
          const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
          
          let starsHtml = '';
          for(let i=0; i<fullStars; i++) starsHtml += `<svg class="w-3 h-3 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
          if(hasHalf) starsHtml += `<svg class="w-3 h-3 text-amber-400" viewBox="0 0 20 20"><defs><linearGradient id="half-star"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="#E4E4E7"/></linearGradient></defs><path fill="url(#half-star)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
          for(let i=0; i<emptyStars; i++) starsHtml += `<svg class="w-3 h-3 text-zinc-200 dark:text-zinc-700" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;

          const bestForTags = tool.bestFor.slice(0, 3).map(b => `<span class="text-[0.7rem] text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">${b}</span>`).join('');

          return `
            <div class="relative bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 shadow-sm overflow-hidden text-left transition-transform hover:-translate-y-1 hover:shadow-lg">
              <div class="h-[3px] bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-400" aria-hidden="true"></div>
              <div class="p-6 sm:p-7">
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-wider bg-indigo-600 text-white shadow-sm">
                    <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    ${tool.badge}
                  </span>
                </div>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">${tool.name}</h3>
                    <p class="mt-1.5 text-[0.82rem] text-zinc-500 dark:text-zinc-400 max-w-md">${tool.verdict}</p>
                  </div>
                  <div class="shrink-0 text-right">
                    <div class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-50 leading-none">${tool.rating.toFixed(1)}</div>
                    <div class="mt-1 flex items-center gap-px">${starsHtml}</div>
                  </div>
                </div>
                <div class="my-5 border-t border-dashed border-zinc-200 dark:border-zinc-700"></div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="text-[0.6rem] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1">Pricing</p>
                    <span class="inline-flex px-2 py-0.5 rounded-md text-[0.72rem] font-semibold capitalize ${tool.pricingColorBg} ${tool.pricingColorText}">${tool.pricingLabel}</span>
                  </div>
                  <div>
                    <p class="text-[0.6rem] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1">Best for</p>
                    <div class="flex flex-wrap gap-1">${bestForTags}</div>
                  </div>
                </div>
                <p class="mt-5 text-[0.82rem] text-zinc-500 dark:text-zinc-400">${tool.description}</p>
                <div class="mt-5 flex items-center gap-3">
                  <a href="${tool.url}" class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white text-[0.82rem] font-semibold rounded-xl hover:bg-indigo-700 transition-colors shadow-sm">
                    Read Review
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                  </a>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }
    });
  </script>
</BaseLayout>
