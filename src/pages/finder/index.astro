---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolFinder from '../../components/ui/ToolFinder.jsx';

const title = "AI Tool Finder Quiz (2026)";
const description = "Answer 5 quick questions and we'll match you with the exact AI tool for your workflow and budget.";
---

<BaseLayout title={title} description={description}>
  <div className="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div className="text-center mb-12">
      <h1 className="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-5xl border-b-0">
        AI Tool Finder Quiz
      </h1>
      <p className="mt-4 text-xl text-gray-500 dark:text-gray-400">
        Stop guessing. Tell us your role, your goal, and your budget, and our routing engine will recommend the exact AI tool you need in 2026.
      </p>
    </div>

    {/* React Island for the dynamic quiz */}
    <ToolFinder client:load />

  </div>
</BaseLayout>
