---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import ReviewSchema from '../../components/seo/ReviewSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import ProsCons from '../../components/content/ProsCons.astro';
import ToolPickBox from '../../components/content/ToolPickBox.astro';
import PricingTable from '../../components/content/PricingTable.astro';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import AuthorBio from '../../components/content/AuthorBio.astro';
import NewsletterSignup from '../../components/content/NewsletterSignup.astro';
import ReadingProgress from '../../components/content/ReadingProgress.astro';
import RelatedContent from '../../components/content/RelatedContent.astro';
import StillRecommended from '../../components/content/StillRecommended.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadingTime } from '../../utils/readingTime';
import { categoryLabels, pricingConfig } from '../../data/site.config';
import { slugifyTag } from '../../utils/slugifyTag';

export async function getStaticPaths() {
  const tools = await getCollection('tools', ({ data }) => !data.draft);
  return tools.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedEntries = (await getCollection('tools', ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== entry.id && candidate.data.category === entry.data.category)
  .slice(0, 3);

// Parse FAQ headings into FAQSchema format
const faqs = [];
let inFaqSection = false;
let currentQuestion = '';

for (const heading of headings) {
  if (heading.depth === 2 && heading.text.toLowerCase().includes('frequently asked questions')) {
    inFaqSection = true;
    continue;
  }
  if (inFaqSection && heading.depth === 2) {
    break; // Hit a new H2 section, end of FAQs
  }
  if (inFaqSection && heading.depth === 3) {
    // We found a question. The answer would be the text following it.
    // Astro's `headings` doesn't provide the paragraph text directly, so we need to extract it from the body
    currentQuestion = heading.text;
    
    // We do a simple regex extraction from the raw body for now
    const questionRegex = new RegExp(`### ${currentQuestion}\\s*\\n+([^#]+)`, 'i');
    const match = entry.body?.match(questionRegex);
    if (match && match[1]) {
      faqs.push({
        question: currentQuestion,
        answer: match[1].trim()
      });
    }
  }
}

const verdict =
  entry.data.rating >= 4.5
    ? `${entry.data.toolName} is one of the strongest options in ${entry.data.category} if your priorities match its core strengths.`
    : `${entry.data.toolName} has a clear use case, but you should match it carefully to your workflow before paying for it.`;

function inferPricingTiers() {
  const baseFeatures = entry.data.bestFor.slice(0, 3).map((item) => `Best for ${item.toLowerCase()}`);
  const paidMatch = entry.data.pricingDetails.match(/\$[\d]+(?:\/[a-zA-Z.]+)?|\$[\d]+/g);
  const primaryPaidPrice = paidMatch?.[0] ?? (entry.data.pricing === 'enterprise' ? 'Custom' : '$20');

  if (entry.data.pricing === 'free') {
    return [
      {
        name: 'Free',
        price: '$0',
        description: entry.data.pricingDetails,
        features: ['Core workflow access', ...baseFeatures],
        isRecommended: true,
      },
    ];
  }

  if (entry.data.pricing === 'freemium') {
    return [
      {
        name: 'Free',
        price: '$0',
        description: `Start using ${entry.data.toolName} before you commit.`,
        features: ['Core access with usage limits', baseFeatures[0] ?? 'Basic workflow support', 'Good for testing fit'],
      },
      {
        name: 'Paid',
        price: primaryPaidPrice,
        period: primaryPaidPrice.includes('/mo') ? undefined : 'mo',
        description: entry.data.pricingDetails,
        features: ['Higher limits and priority access', baseFeatures[1] ?? 'Expanded workflow coverage', baseFeatures[2] ?? 'Better for daily use'],
        isRecommended: true,
        cta: `Try ${entry.data.toolName}`,
        ctaUrl: entry.data.website,
      },
    ];
  }

  if (entry.data.pricing === 'enterprise') {
    return [
      {
        name: 'Enterprise',
        price: 'Custom',
        description: entry.data.pricingDetails,
        features: ['Custom procurement', 'Admin and compliance controls', ...baseFeatures.slice(0, 2)],
        isRecommended: true,
        cta: 'Contact sales',
        ctaUrl: entry.data.website,
      },
    ];
  }

  return [
    {
      name: 'Paid',
      price: primaryPaidPrice,
      period: primaryPaidPrice.includes('/mo') ? undefined : 'mo',
      description: entry.data.pricingDetails,
      features: ['Full product access', ...baseFeatures, 'Best for committed users'],
      isRecommended: true,
      cta: `Visit ${entry.data.toolName}`,
      ctaUrl: entry.data.website,
    },
  ];
}

const comparisonCandidates = [entry, ...relatedEntries.slice(0, 2)];
const comparisonTools = comparisonCandidates.map((candidate, index) => ({
  name: candidate.data.toolName,
  isWinner: index === 0,
}));
const comparisonFeatures = [
  { name: 'Rating', values: comparisonCandidates.map((candidate) => Math.max(1, Math.min(5, Math.round(candidate.data.rating)))) },
  { name: 'Pricing', values: comparisonCandidates.map((candidate) => pricingConfig[candidate.data.pricing]?.label ?? candidate.data.pricing) },
  { name: 'Best for', values: comparisonCandidates.map((candidate) => candidate.data.bestFor[0] ?? 'General use') },
  { name: 'Featured review', values: comparisonCandidates.map((candidate) => candidate.data.featured) },
  { name: 'Workflow breadth', description: 'Based on best-for range', values: comparisonCandidates.map((candidate) => Math.max(1, Math.min(5, candidate.data.bestFor.length + 1))) },
  { name: 'Editorial confidence', description: 'Derived from review score', values: comparisonCandidates.map((candidate) => Math.max(1, Math.min(5, Math.round(candidate.data.rating)))) },
];
const pricingTiers = inferPricingTiers();
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedDate={entry.data.publishedDate.toISOString()}
  updatedDate={entry.data.updatedDate?.toISOString()}
>
  <ReviewSchema
    slot="head"
    itemName={entry.data.toolName}
    itemImage={entry.data.coverImage}
    description={entry.data.description}
    ratingValue={entry.data.rating}
    datePublished={entry.data.publishedDate}
  />
  <BreadcrumbSchema
    slot="head"
    items={[
      { name: 'Home', url: '/' },
      { name: 'Tools', url: '/tools/' },
      { name: entry.data.toolName, url: `/tools/${entry.id}/` },
    ]}
  />
  {faqs.length > 0 && <FAQSchema slot="head" faqs={faqs} />}
  <Header />
  <ReadingProgress />

  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.12),_transparent_42%),radial-gradient(circle_at_bottom_right,_rgba(240,199,94,0.18),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.06),_transparent_42%),radial-gradient(circle_at_bottom_right,_rgba(240,199,94,0.08),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Tools', href: '/tools/' }, { label: entry.data.toolName }]} />

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="max-w-3xl" data-reveal>
          <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
              {entry.data.category}
            </span>
            <span>{formatDate(entry.data.publishedDate)}</span>
            <span aria-hidden="true">·</span>
            <span>{getReadingTime(entry.body)}</span>
          </div>

          <h1 class="mt-5 max-w-3xl text-zinc-950 dark:text-zinc-50">{entry.data.title}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">{entry.data.description}</p>

          <div class="mt-4">
            <StillRecommended
              lastVerifiedDate={entry.data.updatedDate ?? entry.data.publishedDate}
              toolName={entry.data.toolName}
            />
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">Rating</p>
              <p class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-50">{entry.data.rating.toFixed(1)} / 5</p>
            </div>
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">Pricing</p>
              <p class="mt-2 text-base font-semibold capitalize text-zinc-950 dark:text-zinc-50">{entry.data.pricing}</p>
            </div>
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">Best for</p>
              <p class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-50">{entry.data.bestFor[0] ?? 'General use'}</p>
            </div>
          </div>
        </div>

        <aside class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.14)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Quick facts</p>
          <div class="mt-5 space-y-5">
            <div>
              <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Pricing details</p>
              <p class="mt-2 text-sm leading-6 text-zinc-100">{entry.data.pricingDetails}</p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Website</p>
              <a href={entry.data.website} target="_blank" rel="noopener" class="mt-2 inline-flex text-sm font-medium text-[#F0C75E] hover:text-white">
                Visit official site
              </a>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Tags</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {entry.data.tags.map((tag) => (
                  <a href={`/tags/${slugifyTag(tag)}/`} class="rounded-full border border-white/10 px-3 py-1 text-xs text-zinc-300 transition-colors hover:border-white/30 hover:text-white">{tag}</a>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <div class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="min-w-0 space-y-8">
          <ToolPickBox
            name={entry.data.toolName}
            verdict={verdict}
            description={entry.data.description}
            rating={entry.data.rating}
            pricing={entry.data.pricing}
            bestFor={entry.data.bestFor}
            website={entry.data.website}
            affiliateUrl={entry.data.affiliateUrl}
            category={entry.data.category}
            badge={entry.data.featured ? 'Featured Review' : 'Reviewed Tool'}
          />

          <ProsCons pros={entry.data.pros} cons={entry.data.cons} toolName={entry.data.toolName} verdict={verdict} />

          <PricingTable
            toolName={entry.data.toolName}
            tiers={pricingTiers}
            disclaimer={`Pricing is based on the current ${categoryLabels[entry.data.category] ?? entry.data.category} offer described in the review frontmatter: ${entry.data.pricingDetails}`}
          />

          {comparisonTools.length > 1 && (
            <ComparisonTable
              title={`${categoryLabels[entry.data.category] ?? entry.data.category} alternatives`}
              tools={comparisonTools}
              features={comparisonFeatures}
              verdict={`${entry.data.toolName} remains our lead pick in this set when you want ${entry.data.bestFor[0]?.toLowerCase() ?? 'a strong general workflow'}, but the alternatives may fit better if pricing model or category emphasis matters more.`}
            />
          )}

          <article data-pagefind-body class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-6 py-8 shadow-[var(--shadow-card)] md:px-10 md:py-10">
            <div class="prose dark:prose-invert max-w-none prose-headings:scroll-mt-24">
              <Content />
            </div>
            <AuthorBio compact />
            <NewsletterSignup variant="inline" />
          </article>
        </div>

        <TableOfContents headings={headings} label="Review outline" />
      </div>
    </div>
  </section>

  {relatedEntries.length > 0 && (
    <section class="border-t border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="page-container py-12 md:py-16">
        <div class="mb-8" data-reveal>
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Same category</p>
          <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">More {entry.data.category} tools.</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {relatedEntries.map((candidate) => (
            <a
              href={`/tools/${candidate.id}/`}
              class="group rounded-[1.4rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
            >
              <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-400">{candidate.data.pricing}</p>
                <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">{candidate.data.rating.toFixed(1)}</p>
              </div>
              <h3 class="mt-3 text-xl text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">{candidate.data.toolName}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{candidate.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <RelatedContent
    currentCollection="tools"
    currentId={entry.id}
    tags={entry.data.tags}
    toolName={entry.data.toolName}
  />

  <Footer />
</BaseLayout>
