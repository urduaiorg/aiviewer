---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import EditorialCover from '../../components/content/EditorialCover.astro';
import CollectionSchema from '../../components/seo/CollectionSchema.astro';
import { categoryLabels, pricingConfig } from '../../data/site.config';
import { shouldNoindexPath } from '../../utils/indexPolicy';

/**
 * Category descriptions — editorial-grade copy for each tool category.
 * Every description positions AIViewer as the authority and speaks
 * directly to what the reader cares about.
 */
const categoryDescriptions: Record<string, string> = {
  writing:
    'AI writing tools that draft, edit, and refine content across formats. From long-form articles to emails, these tools handle the heavy lifting so you can focus on ideas.',
  design:
    'AI design tools that generate visuals, edit images, and build layouts without traditional design skills. Create professional-quality graphics in minutes.',
  research:
    'AI research tools that surface answers, synthesize sources, and accelerate the path from question to insight. Spend less time searching, more time thinking.',
  coding:
    'AI coding tools that write, debug, and refactor code alongside you. From autocomplete to full-app generation, these assistants change how software gets built.',
  video:
    'AI video tools that generate, edit, and enhance footage with minimal manual effort. Turn scripts into scenes, raw clips into polished productions.',
  audio:
    'AI audio tools that clone voices, generate speech, transcribe recordings, and produce music. Studio-quality sound without the studio.',
  productivity:
    'AI productivity tools that automate repetitive tasks, organize information, and keep you focused on work that matters. Less busywork, more output.',
  education:
    'AI education tools that personalize learning, generate curricula, and make complex subjects accessible. Built for teachers, students, and lifelong learners.',
  data:
    'AI data tools that clean, analyze, and visualize datasets without requiring deep technical expertise. Turn raw numbers into clear, actionable insight.',
  translation:
    'AI translation tools that convert text and speech across languages with increasing accuracy and nuance. Break language barriers at scale.',
  presentation:
    'AI presentation tools that build slides, suggest layouts, and transform outlines into polished decks. Spend time on your message, not on formatting.',
  business:
    'AI business tools that streamline operations, generate reports, and support decision-making across teams. Enterprise capability without enterprise complexity.',
};

/**
 * Meta descriptions — tighter than page descriptions,
 * optimized for SERP click-through.
 */
const categoryMetaDescriptions: Record<string, string> = {
  writing:
    'Honest reviews of AI writing tools. Compare features, pricing, and real-world performance to find the right fit for your content workflow.',
  design:
    'In-depth reviews of AI design tools. Compare image generators, editors, and layout builders by quality, pricing, and ease of use.',
  research:
    'Expert reviews of AI research tools. Compare AI-powered search, synthesis, and analysis platforms by accuracy, depth, and pricing.',
  coding:
    'Detailed reviews of AI coding tools. Compare code assistants, debuggers, and generators by capability, language support, and pricing.',
  video:
    'Thorough reviews of AI video tools. Compare generators, editors, and enhancers by output quality, speed, and pricing.',
  audio:
    'Comprehensive reviews of AI audio tools. Compare voice generators, transcription services, and music creators by quality and pricing.',
  productivity:
    'Practical reviews of AI productivity tools. Compare automation platforms, organizers, and assistants by real workflow impact and pricing.',
  education:
    'Detailed reviews of AI education tools. Compare learning platforms, tutoring assistants, and curriculum generators by effectiveness and pricing.',
  data:
    'Expert reviews of AI data tools. Compare analytics platforms, visualization builders, and data cleaners by capability and pricing.',
  translation:
    'In-depth reviews of AI translation tools. Compare real-time translators, document converters, and localization platforms by accuracy and pricing.',
  presentation:
    'Honest reviews of AI presentation tools. Compare slide builders, layout engines, and design assistants by output quality and pricing.',
  business:
    'Thorough reviews of AI business tools. Compare operations platforms, report generators, and decision-support systems by ROI and pricing.',
};

export const getStaticPaths: GetStaticPaths = async () => {
  const allTools = await getCollection('tools', ({ data }) => !data.draft);

  // Group tools by category
  const grouped = new Map<string, typeof allTools>();
  for (const tool of allTools) {
    const cat = tool.data.category;
    if (!grouped.has(cat)) grouped.set(cat, []);
    grouped.get(cat)!.push(tool);
  }

  // One path per category that actually has tools
  return [...grouped.entries()]
    .filter(([category]) => !shouldNoindexPath(`/tools/${category}/`))
    .map(([category, tools]) => ({
    params: { category },
    props: {
      tools: tools.sort(
        (a, b) =>
          b.data.rating - a.data.rating ||
          b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
      ),
      allCategories: [...grouped.keys()],
    },
  }));
};

const { category } = Astro.params;
const { tools, allCategories } = Astro.props;

const label = categoryLabels[category!] ?? category;
const pageTitle = `${label} AI Tools`;
const pageDescription =
  categoryDescriptions[category!] ??
  `Browse reviewed ${label.toLowerCase()} AI tools with ratings, pricing breakdowns, and honest verdicts.`;
const metaDescription =
  categoryMetaDescriptions[category!] ??
  `Browse ${tools.length} reviewed ${label.toLowerCase()} AI tools on AIViewer.ai. Compare ratings, pricing, and real-world performance.`;
const relatedCategories = allCategories.filter((c: string) => c !== category);
---

<BaseLayout title={pageTitle} description={metaDescription} noindex={shouldNoindexPath(Astro.url.pathname)}>
  <Fragment slot="head">
    <BreadcrumbSchema
      items={[
        { name: 'Home', url: '/' },
        { name: 'Tools', url: '/tools/' },
        { name: `${label} AI Tools`, url: `/tools/${category}/` },
      ]}
    />
    <CollectionSchema
      name={pageTitle}
      description={metaDescription}
      url={`/tools/${category}/`}
      numberOfItems={tools.length}
    />
  </Fragment>
  <Header />

  {/* ── Hero section ─────────────────────────────────── */}
  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.22),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.12),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs
        items={[
          { label: 'Tools', href: '/tools/' },
          { label: `${label} AI Tools` },
        ]}
      />

      <div class="max-w-3xl" data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:text-zinc-400">
          {label} category
        </span>
        <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">{pageTitle}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
          {pageDescription}
        </p>
        <div class="mt-6 flex items-center gap-4">
          <span class="inline-flex items-center gap-2 rounded-full bg-zinc-100 dark:bg-zinc-800 px-4 py-2 text-sm font-semibold text-zinc-700 dark:text-zinc-300">
            <span class="text-lg font-bold text-[#F0C75E]">{tools.length}</span>
            {tools.length === 1 ? 'tool reviewed' : 'tools reviewed'}
          </span>
          <a
            href="/tools/"
            class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors"
          >
            &larr; All tools
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Tool cards grid ──────────────────────────────── */}
  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      {tools.length === 0 ? (
        <div class="rounded-[1.75rem] border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-8 py-16 text-center">
          <h2 class="text-zinc-950 dark:text-zinc-50">No reviews in this category yet.</h2>
          <p class="mt-3 text-zinc-500 dark:text-zinc-400">
            Check back soon — new tool evaluations are published regularly.
          </p>
        </div>
      ) : (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {tools.map((entry: any, i: number) => (
            <a
              href={`/tools/${entry.id}/`}
              class="tool-card card-glow group flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
              data-category={entry.data.category}
              data-reveal
              data-reveal-delay={`${i * 80}`}
            >
              <div class="border-b border-zinc-200 dark:border-zinc-800">
                <EditorialCover
                  title={entry.data.toolName}
                  subtitle={categoryLabels[entry.data.category] ?? entry.data.category}
                  category={entry.data.category}
                  variant="tool"
                  badge={pricingConfig[entry.data.pricing]?.label ?? entry.data.pricing}
                  compact={true}
                  showTitle={false}
                />
              </div>

              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <span class="inline-flex rounded-full bg-zinc-100 dark:bg-zinc-800 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-zinc-600 dark:text-zinc-400">
                      {categoryLabels[entry.data.category] ?? entry.data.category}
                    </span>
                    <h3 class="mt-4 text-[1.3rem] text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600">
                      {entry.data.toolName}
                    </h3>
                  </div>
                  <div class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-semibold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">Evaluation</div>
                </div>

                <p class="mt-4 flex-1 text-[0.95rem] leading-7 text-zinc-600 dark:text-zinc-400">
                  {entry.data.description}
                </p>

                <div class="mt-5 flex flex-wrap gap-2">
                  {entry.data.bestFor.slice(0, 3).map((item: string) => (
                    <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-2.5 py-1 text-xs text-zinc-500 dark:text-zinc-400">
                      {item}
                    </span>
                  ))}
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 pt-5">
                  <span
                    class:list={[
                      'rounded-full px-3 py-1 text-xs font-semibold',
                      pricingConfig[entry.data.pricing]?.color ?? 'bg-zinc-100 text-zinc-700',
                    ]}
                  >
                    {pricingConfig[entry.data.pricing]?.label ?? entry.data.pricing}
                  </span>
                  <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400">
                    Read evaluation
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  {/* ── Related categories ───────────────────────────── */}
  {relatedCategories.length > 0 && (
    <section class="border-t border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="page-container py-12 md:py-16">
        <h2 class="text-zinc-950 dark:text-zinc-50">Explore other categories</h2>
        <p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-400">
          Browse AI tools across every discipline — find the right tool for any task.
        </p>
        <nav class="mt-8 flex flex-wrap gap-2" aria-label="Related tool categories">
          {relatedCategories.map((cat: string) => (
            <a
              href={`/tools/${cat}/`}
              class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-400 transition-colors hover:border-indigo-200 dark:hover:border-indigo-700 hover:text-indigo-600 dark:hover:text-indigo-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/20"
            >
              {categoryLabels[cat] ?? cat}
            </a>
          ))}
        </nav>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>
