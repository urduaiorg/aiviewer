---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---
<BaseLayout title="Follow AIViewer Lessons" description="Follow AIViewer's practical AI lessons through RSS or browse the free learning library.">
  <Header slot="header" />
  <section class="page-container py-12 md:py-20">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-zinc-950 dark:text-white">Follow new lessons</h1>
      <p class="mt-6 text-lg leading-8 text-zinc-600 dark:text-zinc-300">AIViewer focuses on practical lessons you can return to. Our publishing target is one useful lesson or substantial refresh each week.</p>
      <h2 class="mt-10 text-2xl text-zinc-950 dark:text-white">Use the RSS feed</h2>
      <p class="mt-4 leading-7 text-zinc-600 dark:text-zinc-300">Copy the feed address below into your RSS reader. New published lessons will appear there without an email subscription.</p>
      <a href="/rss.xml" class="mt-5 inline-block break-all rounded-lg border border-zinc-300 p-4 font-semibold text-indigo-700 underline dark:border-zinc-700 dark:text-indigo-300">https://aiviewer.ai/rss.xml</a>
      <p class="mt-6 text-zinc-600 dark:text-zinc-300">Email signup is currently unavailable. You can access every lesson and download without subscribing.</p>
      <a href="/learn/" class="mt-8 inline-flex min-h-12 items-center rounded-xl bg-indigo-700 px-6 py-3 font-semibold text-white">Browse the learning library</a>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
