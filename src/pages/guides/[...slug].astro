---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import AuthorBio from '../../components/content/AuthorBio.astro';
import NewsletterSignup from '../../components/content/NewsletterSignup.astro';
import ReadingProgress from '../../components/content/ReadingProgress.astro';
import RelatedContent from '../../components/content/RelatedContent.astro';
import ShareButtons from '../../components/content/ShareButtons.astro';
import VideoLessonLead from '../../components/content/VideoLessonLead.astro';
import AIViewerLens from '../../components/editorial/AIViewerLens.astro';
import PrivacyAwareVideoEmbed from '../../components/editorial/PrivacyAwareVideoEmbed.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadingTime } from '../../utils/readingTime';
import { siteConfig } from '../../data/site.config';
import editorialImageProvenance from '../../data/editorial-image-provenance.json';
import { shouldNoindexPath } from '../../utils/indexPolicy';
import { GUIDE_FORMAT_INFO, isPublishedGuide } from '../../components/editorial/model';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => isPublishedGuide(data));
  return guides.filter((entry) => !shouldNoindexPath(`/guides/${entry.id}/`)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const formatInfo = GUIDE_FORMAT_INFO[entry.data.format];
const isVideoLesson = entry.data.format === 'video-lesson' && Boolean(entry.data.video);
const generatedCoverProvenance = editorialImageProvenance.find(
  (record) => record.asset === entry.data.coverImage,
);
const pageNoindex = !entry.data.publication.index || shouldNoindexPath(Astro.url.pathname);
const relatedEntries = (await getCollection('guides', ({ data }) => isPublishedGuide(data)))
  .filter((candidate) =>
    candidate.id !== entry.id &&
    candidate.data.publication.index &&
    !shouldNoindexPath(`/guides/${candidate.id}/`)
  )
  .sort((a, b) => {
    const aFormatMatch = a.data.format === entry.data.format ? 1 : 0;
    const bFormatMatch = b.data.format === entry.data.format ? 1 : 0;
    if (aFormatMatch !== bFormatMatch) return bFormatMatch - aFormatMatch;
    return b.data.publishedDate.getTime() - a.data.publishedDate.getTime();
  })
  .slice(0, 3);

// Parse FAQ headings into FAQSchema format
const faqs = [];
let inFaqSection = false;
let currentQuestion = '';

for (const heading of headings) {
  if (heading.depth === 2 && heading.text.toLowerCase().includes('frequently asked questions')) {
    inFaqSection = true;
    continue;
  }
  if (inFaqSection && heading.depth === 2) {
    break; // Hit a new H2 section, end of FAQs
  }
  if (inFaqSection && heading.depth === 3) {
    currentQuestion = heading.text;
    const questionRegex = new RegExp(`### ${currentQuestion}\\s*\\n+([^#]+)`, 'i');
    const match = entry.body?.match(questionRegex);
    if (match && match[1]) {
      faqs.push({
        question: currentQuestion,
        answer: match[1].trim()
      });
    }
  }
}
---

<BaseLayout
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  type="article"
  publishedDate={entry.data.publishedDate.toISOString()}
  updatedDate={entry.data.updatedDate?.toISOString()}
  monetize={entry.data.publication.monetize}
  noindex={pageNoindex}
>
  <ArticleSchema
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
    image={entry.data.coverImage}
    publishedDate={entry.data.publishedDate}
    updatedDate={entry.data.updatedDate}
    format={entry.data.format}
    learningOutcome={entry.data.learningOutcome}
    evidenceSources={entry.data.evidence?.sources}
    video={entry.data.video}
  />
  <BreadcrumbSchema
    slot="head"
    items={[
      { name: 'Home', url: '/' },
      { name: formatInfo.pluralLabel, url: formatInfo.href },
      { name: entry.data.title, url: `/guides/${entry.id}/` },
    ]}
  />
  {faqs.length > 0 && <FAQSchema slot="head" faqs={faqs} />}
  <Fragment slot="header">
    <Header />
    <ReadingProgress />
  </Fragment>

  <div>
    <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top,_rgba(240,199,94,0.16),_transparent_40%),linear-gradient(180deg,rgba(79,70,229,0.08),transparent_75%)] dark:bg-[radial-gradient(circle_at_top,_rgba(240,199,94,0.07),_transparent_40%),linear-gradient(180deg,rgba(79,70,229,0.05),transparent_75%)]"></div>
      <div class="page-container relative py-12 md:py-16">
        <Breadcrumbs items={[{ label: formatInfo.pluralLabel, href: formatInfo.href }, { label: entry.data.title }]} />

        <div class="max-w-3xl" data-reveal>
          <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
              {formatInfo.label}
            </span>
            <span class="capitalize">{entry.data.category}</span>
            <a href="/about/" class="font-medium text-zinc-600 dark:text-zinc-300 hover:text-indigo-600 dark:hover:text-indigo-400">AIViewer</a>
            <a href="/ai-use/" class="text-zinc-500 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400">AI-assisted publication</a>
            <span>{formatDate(entry.data.publishedDate)}</span>
            {entry.data.updatedDate && entry.data.updatedDate.getTime() !== entry.data.publishedDate.getTime() && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-900/20 px-2.5 py-0.5 text-[0.7rem] font-medium text-emerald-700 dark:text-emerald-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                Updated {formatDate(entry.data.updatedDate)}
              </span>
            )}
            {entry.data.factCheckedAt && (
              <span>Sources checked {formatDate(entry.data.factCheckedAt)}</span>
            )}
            <span aria-hidden="true">·</span>
            <span>{getReadingTime(entry.body)}</span>
          </div>

          <h1 class="mt-5 max-w-3xl text-zinc-950 dark:text-zinc-50">{entry.data.title}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">{entry.data.description}</p>

          <div class="mt-8 flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-3 py-1 text-sm text-zinc-600 dark:text-zinc-300">{tag}</span>
            ))}
            {entry.data.relatedPlaybook && !shouldNoindexPath(`/playbooks/${entry.data.relatedPlaybook}/`) && (
              <a href={`/playbooks/${entry.data.relatedPlaybook}/`} class="rounded-full border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-sm font-medium text-indigo-700 dark:text-indigo-400">
                Related playbook
              </a>
            )}
          </div>

          <div class="mt-5">
            <ShareButtons title={entry.data.title} url={`${siteConfig.url}${Astro.url.pathname}`} />
          </div>

          {generatedCoverProvenance && (
            <figure class="mt-8 overflow-hidden rounded-[1.5rem] border border-zinc-200 bg-zinc-100 shadow-[var(--shadow-card)] dark:border-zinc-800 dark:bg-zinc-900">
              <img
                src={entry.data.coverImage}
                alt={generatedCoverProvenance.altText}
                width={generatedCoverProvenance.width}
                height={generatedCoverProvenance.height}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="h-auto w-full object-cover"
              />
              <figcaption class="border-t border-zinc-200 bg-white px-4 py-2 text-xs text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
                {generatedCoverProvenance.disclosure}.
              </figcaption>
            </figure>
          )}
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-bg)]">
      <div class="page-container py-12 md:py-16">
        <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_16rem] xl:gap-12">
          <TableOfContents headings={headings} label="Guide outline" compact />

          <article data-pagefind-body class="min-w-0 rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-6 py-8 shadow-[var(--shadow-card)] md:px-10 md:py-10 xl:order-1">
            {isVideoLesson && entry.data.video ? (
              <Fragment>
                <VideoLessonLead
                  summary={entry.data.lensSummary ?? entry.data.description}
                  learningOutcome={entry.data.learningOutcome}
                />
                <PrivacyAwareVideoEmbed
                  youtubeId={entry.data.video.youtubeId}
                  title={entry.data.video.title}
                  creatorName={entry.data.video.creatorName}
                  creatorUrl={entry.data.video.creatorUrl}
                  poster={entry.data.coverImage}
                />
                <AIViewerLens
                  format={entry.data.format}
                  summary="Sources, limitations, review dates, and AI-use notes for this lesson."
                  nextAction={entry.data.nextAction}
                  factCheckedAt={entry.data.factCheckedAt}
                  reviewDueAt={entry.data.reviewDueAt}
                  evidence={entry.data.evidence}
                  aiUse={entry.data.aiUse}
                />
              </Fragment>
            ) : (
              <AIViewerLens
                format={entry.data.format}
                summary={entry.data.lensSummary ?? entry.data.description}
                learningOutcome={entry.data.learningOutcome}
                nextAction={entry.data.nextAction}
                factCheckedAt={entry.data.factCheckedAt}
                reviewDueAt={entry.data.reviewDueAt}
                evidence={entry.data.evidence}
                aiUse={entry.data.aiUse}
              />
            )}
            <div class="prose article-prose dark:prose-invert prose-headings:scroll-mt-24">
              <Content />
            </div>
            <AuthorBio compact variant="publisher" disclosure={entry.data.aiUse.disclosure} />
            <NewsletterSignup variant="inline" />
          </article>
        </div>
      </div>
    </section>

    {relatedEntries.length > 0 && (
      <section class="border-t border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
        <div class="page-container py-12 md:py-16">
          <div class="mb-8" data-reveal>
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Continue reading</p>
            <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">More {formatInfo.collectionLabel}.</h2>
          </div>
          <div class="grid gap-5 md:grid-cols-3">
            {relatedEntries.map((candidate) => (
              <a
                href={`/guides/${candidate.id}/`}
                class="group rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
              >
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-400">{GUIDE_FORMAT_INFO[candidate.data.format].label}</p>
                <h3 class="mt-3 text-xl text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">{candidate.data.title}</h3>
                <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{candidate.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <RelatedContent
      currentCollection="guides"
      currentId={entry.id}
      tags={entry.data.tags}
    />
  </div>

  <Footer slot="footer" />
</BaseLayout>
