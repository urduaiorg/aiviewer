---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import AuthorBio from '../../components/content/AuthorBio.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedEntries = (await getCollection('guides', ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== entry.id && candidate.data.category === entry.data.category)
  .slice(0, 3);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedDate={entry.data.publishedDate.toISOString()}
  updatedDate={entry.data.updatedDate?.toISOString()}
>
  <ArticleSchema
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
    image={entry.data.coverImage}
    publishedDate={entry.data.publishedDate}
    updatedDate={entry.data.updatedDate}
  />
  <BreadcrumbSchema
    slot="head"
    items={[
      { name: 'Home', url: '/' },
      { name: 'Guides', url: '/guides/' },
      { name: entry.data.title, url: `/guides/${entry.id}/` },
    ]}
  />
  <Header />

  <section class="relative overflow-hidden border-b border-zinc-200/70 bg-white">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top,_rgba(240,199,94,0.16),_transparent_40%),linear-gradient(180deg,rgba(79,70,229,0.08),transparent_75%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Guides', href: '/guides/' }, { label: entry.data.title }]} />

      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500">
          <span class="rounded-full bg-indigo-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600">
            {entry.data.category}
          </span>
          <span>{formatDate(entry.data.publishedDate)}</span>
          <span aria-hidden="true">·</span>
          <span>{getReadingTime(entry.body)}</span>
        </div>

        <h1 class="mt-5 max-w-3xl text-zinc-950">{entry.data.title}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600">{entry.data.description}</p>

        <div class="mt-8 flex flex-wrap gap-2">
          {entry.data.tags.map((tag) => (
            <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-sm text-zinc-600">{tag}</span>
          ))}
          {entry.data.relatedPlaybook && (
            <a href={`/playbooks/${entry.data.relatedPlaybook}/`} class="rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700">
              Related playbook
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <div class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_16rem]">
        <article data-pagefind-body class="min-w-0 rounded-[1.75rem] border border-zinc-200 bg-white px-6 py-8 shadow-[var(--shadow-card)] md:px-10 md:py-10">
          <div class="prose max-w-none prose-headings:scroll-mt-24">
            <Content />
          </div>
          <AuthorBio compact />
        </article>

        <TableOfContents headings={headings} label="Guide outline" />
      </div>
    </div>
  </section>

  {relatedEntries.length > 0 && (
    <section class="border-t border-zinc-200/70 bg-white">
      <div class="page-container py-12 md:py-16">
        <div class="mb-8">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600">Continue reading</p>
          <h2 class="mt-2 text-zinc-950">More in {entry.data.category}.</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {relatedEntries.map((candidate) => (
            <a
              href={`/guides/${candidate.id}/`}
              class="group rounded-[1.4rem] border border-zinc-200 bg-white p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-400">{candidate.data.category}</p>
              <h3 class="mt-3 text-xl text-zinc-950 group-hover:text-indigo-600">{candidate.data.title}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-600">{candidate.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>
