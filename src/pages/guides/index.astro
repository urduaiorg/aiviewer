---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { formatDateShort } from '../../utils/formatDate';
import { categoryLabels } from '../../data/site.config';
import { getReadingTime } from '../../utils/readingTime';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const featuredGuide = guides.find((entry) => entry.data.featured) ?? guides[0];
const categories = [...new Set(guides.map((entry) => entry.data.category))];
---

<BaseLayout
  title="AI Guides"
  description="Explore practical AI guides for education, business, healthcare, research, and general literacy with an editorial magazine feel."
>
  <Header />

  <section class="relative overflow-hidden border-b border-zinc-200/70 bg-white">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.18),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.08),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Guides' }]} />

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600">
          Editorial library
        </span>
        <h1 class="mt-5 text-zinc-950">Guides for understanding where AI actually fits.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600">
          Sector-aware explainers, tactical walkthroughs, and practical framing for readers who need clarity before adoption.
        </p>
      </div>
    </div>
  </section>

  {featuredGuide && (
    <section class="border-b border-zinc-200/70 bg-[linear-gradient(180deg,#fff,rgba(244,244,245,0.75))]">
      <div class="page-container py-10 md:py-14">
        <a
          href={`/guides/${featuredGuide.id}/`}
          class="group grid gap-7 rounded-[1.8rem] border border-zinc-200 bg-white p-7 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)] lg:grid-cols-[minmax(0,1fr)_18rem]"
        >
          <div>
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600">Featured guide</p>
            <h2 class="mt-3 text-zinc-950 group-hover:text-indigo-600">{featuredGuide.data.title}</h2>
            <p class="mt-4 max-w-2xl text-[0.98rem] leading-7 text-zinc-600">{featuredGuide.data.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {featuredGuide.data.tags.slice(0, 4).map((tag) => (
                <span class="rounded-full bg-zinc-100 px-3 py-1 text-xs font-medium text-zinc-600">{tag}</span>
              ))}
            </div>
          </div>

          <div class="rounded-[1.4rem] bg-zinc-950 p-6 text-white">
            <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Category</p>
            <div class="mt-2 text-xl font-semibold capitalize text-white">{featuredGuide.data.category}</div>
            <p class="mt-6 text-xs uppercase tracking-[0.14em] text-zinc-500">Collection spread</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {categories.map((category) => (
                <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-zinc-300">{category}</span>
              ))}
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      {categories.length > 0 && (
        <nav class="mb-8 flex flex-wrap gap-2" aria-label="Category filters" data-filter-controls>
          <button class="rounded-full border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700" data-filter="all">
            All categories
          </button>
          {categories.map((category) => (
            <button class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium capitalize text-zinc-600 transition-colors hover:border-indigo-200 hover:text-indigo-600" data-filter={category}>
              {categoryLabels[category] ?? category}
            </button>
          ))}
        </nav>
      )}

      {guides.length === 0 ? (
        <div class="rounded-[1.75rem] border border-dashed border-zinc-300 bg-white px-8 py-16 text-center">
          <h2 class="text-zinc-950">No guides published yet.</h2>
          <p class="mt-3 text-zinc-500">Add Markdown or MDX files to `src/content/guides` and this guide index will populate automatically.</p>
        </div>
      ) : (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-guide-grid>
          {guides.map((entry, index) => (
            <a
              href={`/guides/${entry.id}/`}
              class:list={[
                'guide-card group flex h-full flex-col rounded-[1.55rem] border border-zinc-200 bg-white p-6 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]',
                index % 4 === 0 ? 'xl:col-span-2' : '',
              ]}
              data-category={entry.data.category}
            >
              <div class="flex items-start justify-between gap-4">
                <span class="inline-flex rounded-full bg-zinc-100 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-zinc-600">
                  {entry.data.category}
                </span>
                <span class="text-xs font-medium text-zinc-400">{formatDateShort(entry.data.publishedDate)}</span>
              </div>

              <h3 class="mt-5 text-[1.35rem] text-zinc-950 group-hover:text-indigo-600">{entry.data.title}</h3>
              <p class="mt-3 flex-1 text-[0.95rem] leading-7 text-zinc-600">{entry.data.description}</p>

              <div class="mt-auto pt-5 flex items-center justify-between border-t border-zinc-100">
                <div class="flex flex-wrap gap-2">
                  {entry.data.tags.slice(0, 3).map((tag) => (
                    <span class="rounded-full border border-zinc-200 px-2.5 py-1 text-xs text-zinc-500">{tag}</span>
                  ))}
                </div>
                <span class="text-xs font-medium text-zinc-400">{getReadingTime(entry.body)}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <script>
    const controls = document.querySelector('[data-filter-controls]');
    const grid = document.querySelector('[data-guide-grid]');
    if (controls && grid) {
      const buttons = Array.from(controls.querySelectorAll('button[data-filter]'));
      const cards = Array.from(grid.querySelectorAll('.guide-card'));

      const setFilter = (value: string) => {
        buttons.forEach((button) => {
          const active = (button as HTMLElement).dataset.filter === value;
          button.classList.toggle('border-indigo-200', active);
          button.classList.toggle('bg-indigo-50', active);
          button.classList.toggle('text-indigo-700', active);
          button.classList.toggle('font-semibold', active);
          button.classList.toggle('border-zinc-200', !active);
          button.classList.toggle('bg-white', !active);
          button.classList.toggle('text-zinc-600', !active);
          button.classList.toggle('font-medium', !active);
        });

        cards.forEach((card) => {
          const matches = value === 'all' || (card as HTMLElement).dataset.category === value;
          card.toggleAttribute('hidden', !matches);
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => setFilter((button as HTMLElement).dataset.filter ?? 'all'));
      });
    }
  </script>

  <Footer />
</BaseLayout>
