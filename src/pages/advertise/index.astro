---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Advertise with AIViewer | Reach AI Enthusiasts"
  description="Partner with AIViewer to reach a highly engaged audience of professionals, educators, and creators looking for the best AI tools."
>
  <div class="page-container py-12 lg:py-20 max-w-4xl mx-auto">
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-zinc-900 dark:text-white mb-6">
        Reach the Next Generation of <span class="text-indigo-600 dark:text-indigo-400">AI Adopters</span>
      </h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto">
        AIViewer is the premier destination for professionals looking to integrate AI into their workflows. Partner with us to showcase your tool to a highly engaged, high-intent audience.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 text-center">
        <div class="text-4xl font-bold text-zinc-900 dark:text-white mb-2">500k+</div>
        <div class="text-sm font-medium text-zinc-500 uppercase tracking-wide">Monthly Readers</div>
      </div>
      <div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 text-center">
        <div class="text-4xl font-bold text-zinc-900 dark:text-white mb-2">120k+</div>
        <div class="text-sm font-medium text-zinc-500 uppercase tracking-wide">Newsletter Subs</div>
      </div>
      <div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 text-center">
        <div class="text-4xl font-bold text-zinc-900 dark:text-white mb-2">4.8%</div>
        <div class="text-sm font-medium text-zinc-500 uppercase tracking-wide">Avg. Click-Through</div>
      </div>
    </div>

    <div class="bg-zinc-50 dark:bg-zinc-800/50 rounded-3xl p-8 lg:p-12 mb-16 border border-zinc-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-8">Advertising Opportunities</h2>
      
      <div class="space-y-8">
        <div class="flex flex-col md:flex-row gap-6 items-start">
          <div class="bg-indigo-100 dark:bg-indigo-900/30 p-4 rounded-xl text-indigo-600 dark:text-indigo-400 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Newsletter Sponsorship</h3>
            <p class="text-zinc-600 dark:text-zinc-400">Reach our highly engaged audience directly in their inbox. Our weekly newsletter covers the latest AI tools and trends, boasting an open rate of over 45%.</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row gap-6 items-start">
          <div class="bg-indigo-100 dark:bg-indigo-900/30 p-4 rounded-xl text-indigo-600 dark:text-indigo-400 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Site-wide Display Ads</h3>
            <p class="text-zinc-600 dark:text-zinc-400">Premium placement across AIViewer.ai, including homepage banners, inline article slots, and sidebar sticky ads designed to respect user experience while delivering high visibility.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Get in Touch</h2>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 mb-8">
        Interested in partnering? Email our partnerships team for our media kit and current rates.
      </p>
      <a href="mailto:partnerships@aiviewer.ai" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-indigo-600 rounded-full hover:bg-indigo-700 transition-colors shadow-lg shadow-indigo-600/20">
        Email partnerships@aiviewer.ai
      </a>
    </div>
  </div>
</BaseLayout>
