---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
---

<BaseLayout
  title="Advertise with AIViewer"
  description="Partner with AIViewer.ai to reach a highly engaged audience of professionals, educators, and creators evaluating AI tools."
>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.12),_transparent_42%),radial-gradient(circle_at_bottom_right,_rgba(240,199,94,0.18),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.06),_transparent_42%),radial-gradient(circle_at_bottom_right,_rgba(240,199,94,0.08),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Advertise' }]} />

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end" data-reveal>
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:text-zinc-400">
            Partnerships
          </span>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">Reach the people evaluating their next AI tool.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Part of a 1M+ community network. Our readers are professionals, educators, and creators actively researching AI solutions. They come to AIViewer to make decisions.
          </p>
        </div>

        <!-- Stats card -->
        <div class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.14)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Our reach</p>
          <div class="mt-5 grid grid-cols-3 gap-4">
            <div>
              <div class="text-3xl font-bold text-[#F0C75E]">1M+</div>
              <p class="mt-1 text-sm text-zinc-400">Community</p>
            </div>
            <div>
              <div class="text-3xl font-bold">50K+</div>
              <p class="mt-1 text-sm text-zinc-400">Subscribers</p>
            </div>
            <div>
              <div class="text-3xl font-bold">50K+</div>
              <p class="mt-1 text-sm text-zinc-400">App downloads</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Opportunities -->
  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <div class="mb-10" data-reveal>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Formats</p>
        <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Advertising opportunities.</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-reveal>
        <!-- Sponsored Review -->
        <div class="flex flex-col rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 dark:bg-indigo-900/30 mb-5">
            <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
          </div>
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Premium</p>
          <h3 class="mt-3 text-xl font-bold text-zinc-950 dark:text-zinc-50">Sponsored Review</h3>
          <p class="mt-3 flex-1 text-[0.95rem] leading-7 text-zinc-600 dark:text-zinc-400">
            Full editorial review of your tool in our signature format. Honest, thorough, and structured to help readers decide. Clearly labeled as sponsored.
          </p>
          <div class="mt-6 border-t border-zinc-100 dark:border-zinc-800 pt-5">
            <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400">Highest engagement format</span>
          </div>
        </div>

        <!-- Newsletter Sponsorship -->
        <div class="flex flex-col rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 dark:bg-amber-900/30 mb-5">
            <svg class="h-6 w-6 text-[#F0C75E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Direct reach</p>
          <h3 class="mt-3 text-xl font-bold text-zinc-950 dark:text-zinc-50">Newsletter Sponsorship</h3>
          <p class="mt-3 flex-1 text-[0.95rem] leading-7 text-zinc-600 dark:text-zinc-400">
            Dedicated placement in our weekly digest reaching 50K+ subscribers. Your message lands with readers who actively seek AI tool recommendations.
          </p>
          <div class="mt-6 border-t border-zinc-100 dark:border-zinc-800 pt-5">
            <span class="text-sm font-semibold text-[#F0C75E]">50K+ subscribers</span>
          </div>
        </div>

        <!-- Display Ads -->
        <div class="flex flex-col rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 dark:bg-emerald-900/30 mb-5">
            <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Visibility</p>
          <h3 class="mt-3 text-xl font-bold text-zinc-950 dark:text-zinc-50">Site-wide Display</h3>
          <p class="mt-3 flex-1 text-[0.95rem] leading-7 text-zinc-600 dark:text-zinc-400">
            Inline article slots, sidebar placements, and homepage banners. Non-intrusive, on-brand formats designed to respect the reading experience.
          </p>
          <div class="mt-6 border-t border-zinc-100 dark:border-zinc-800 pt-5">
            <span class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">Multiple placements</span>
          </div>
        </div>
      </div>

      <!-- Why AIViewer -->
      <div class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]" data-reveal>
        <div class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)] md:p-9">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Why AIViewer</p>
          <h2 class="mt-3 text-zinc-950 dark:text-zinc-50">High-intent readers, not passive scrollers.</h2>
          <div class="mt-6 space-y-5 text-[0.98rem] leading-8 text-zinc-600 dark:text-zinc-400">
            <p>
              Our audience comes to evaluate. They read tool reviews to compare options, follow playbooks to implement workflows, and use our prompt library to get results.
            </p>
            <p>
              That means your ad reaches people at the decision stage, not the awareness stage. They're ready to click, try, and buy.
            </p>
          </div>
        </div>

        <div class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-700 bg-zinc-950 p-7 text-white shadow-[0_24px_80px_rgba(9,9,11,0.14)] md:p-9">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Who reads AIViewer</p>
          <div class="mt-6 space-y-4">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between">
                <span class="text-sm text-zinc-300">Professionals & teams</span>
                <span class="text-xs font-semibold rounded-full bg-[#F0C75E]/10 border border-[#F0C75E]/30 px-2.5 py-0.5 text-[#F0C75E]">Core</span>
              </div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between">
                <span class="text-sm text-zinc-300">Educators & researchers</span>
                <span class="text-xs font-semibold rounded-full bg-[#F0C75E]/10 border border-[#F0C75E]/30 px-2.5 py-0.5 text-[#F0C75E]">Core</span>
              </div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between">
                <span class="text-sm text-zinc-300">Creators & freelancers</span>
                <span class="text-xs font-semibold rounded-full bg-white/5 border border-white/10 px-2.5 py-0.5 text-zinc-400">Growing</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8 shadow-[var(--shadow-card)] text-center md:p-12" data-reveal>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400 mb-3">Get started</p>
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-950 dark:text-zinc-50 mb-4">Ready to reach our audience?</h2>
        <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto mb-8">
          Email our partnerships team for our media kit and current rates.
        </p>
        <a href="mailto:hi@aiviewer.ai" class="group inline-flex items-center justify-center gap-2 rounded-full bg-indigo-600 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-indigo-600/20 transition-all duration-200 hover:bg-indigo-700 active:scale-[0.97]">
          hi@aiviewer.ai
          <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
