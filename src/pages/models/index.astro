---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import WebsiteSchema from '../../components/seo/WebsiteSchema.astro';
import { siteConfig } from '../../data/site.config';
import modelCatalogSnapshot from '../../data/model-catalog.snapshot.json';

// ── Build-time data from snapshot ──
const models = Array.isArray(modelCatalogSnapshot.models) ? modelCatalogSnapshot.models : [];

// Compute summary stats from the snapshot
const totalModels = models.length;
const providerSet = new Set(models.map((m) => m.provider));
const totalProviders = providerSet.size;

const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
const recentLaunches = models.filter((m) => {
  if (!m.releaseDate) return false;
  return new Date(m.releaseDate) >= thirtyDaysAgo;
}).length;

const inputPrices = models
  .map((m) => m.inputPricePerMillion)
  .filter((p): p is number => p !== null && p !== undefined && !Number.isNaN(Number(p)));
const lowestInputPrice = inputPrices.length > 0 ? Math.min(...inputPrices) : null;

// Build provider list sorted by model count
const providerMap = new Map<string, { provider: string; providerLabel: string; modelCount: number; latestReleaseAt: string | null }>();
for (const m of models) {
  const existing = providerMap.get(m.provider);
  if (existing) {
    existing.modelCount++;
    if (m.releaseDate && (!existing.latestReleaseAt || m.releaseDate > existing.latestReleaseAt)) {
      existing.latestReleaseAt = m.releaseDate;
    }
  } else {
    providerMap.set(m.provider, {
      provider: m.provider,
      providerLabel: m.providerLabel,
      modelCount: 1,
      latestReleaseAt: m.releaseDate ?? null,
    });
  }
}
const providers = [...providerMap.values()].sort((a, b) => b.modelCount - a.modelCount);

// Latest releases (sorted by date, top 6)
const latestReleases = [...models]
  .filter((m) => m.releaseDate)
  .sort((a, b) => new Date(b.releaseDate!).getTime() - new Date(a.releaseDate!).getTime())
  .slice(0, 6);

// Last sync time
const lastSyncTimes = models.map((m) => m.lastSeenAt).filter(Boolean) as string[];
const lastSyncedAt = lastSyncTimes.length > 0 ? lastSyncTimes.sort().reverse()[0] : null;

// Benchmarked count
const benchmarkedModels = models.filter((m) => m.benchmarkScore !== null && m.benchmarkScore !== undefined).length;

// Format helpers
function formatNumber(value: number | null | undefined) {
  if (value === null || value === undefined || Number.isNaN(Number(value))) return '--';
  return new Intl.NumberFormat('en-US').format(Number(value));
}
function formatMoneyPerMillion(value: number | null | undefined) {
  if (value === null || value === undefined || Number.isNaN(Number(value))) return 'TBD';
  const numeric = Number(value);
  const decimals = numeric >= 10 ? 0 : numeric >= 1 ? 2 : 3;
  return `$${numeric.toFixed(decimals)}/M`;
}
function formatDate(value: string | null | undefined) {
  if (!value) return 'Unknown';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Unknown';
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
}

const API_DASHBOARD_URL = `${siteConfig.api.workerBase}/api/dashboard`;
---

<BaseLayout
  title="AI Model Tracker | AIViewer"
  description="Track AI model launches, pricing, context windows, and benchmark snapshots across OpenAI, Anthropic, Google, xAI, Mistral, Qwen, Perplexity, Kimi, and more."
>
  <Fragment slot="head">
    <WebsiteSchema />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "AI Model Tracker — Frontier Models Catalog",
      "description": "Live catalog of frontier AI models with pricing, context windows, and capability snapshots.",
      "url": "https://aiviewer.ai/models/",
      "numberOfItems": totalModels,
      "itemListElement": models.slice(0, 30).map((m, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": m.name,
        "url": `https://aiviewer.ai/models/${m.slug}/`,
      })),
    })} />
  </Fragment>

  <Header />

  <main class="pt-28 pb-24">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="absolute inset-x-0 top-0 h-80 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.22),_transparent_36%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.10),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_36%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_38%)]"></div>
      <div class="page-container relative py-12 md:py-16">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Live catalog
          </div>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">Track what changed across the frontier model market.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Follow launches, pricing, context windows, and benchmark snapshots without mixing everything into a fake universal score.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Release tracking</span>
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Pricing snapshots</span>
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Capability coverage</span>
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Benchmark context</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Dashboard -->
    <section class="bg-[var(--color-bg)]">
      <div class="page-container py-10 md:py-14">
        <div id="models-dashboard" class="relative space-y-8" data-api-url={API_DASHBOARD_URL}>

          <!-- Stats row -->
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4" data-reveal>
            <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Tracked models</p>
              <div class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50" data-stat="models">{formatNumber(totalModels)}</div>
              <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Models actively covered in the live catalog.</p>
            </div>
            <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Providers</p>
              <div class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50" data-stat="providers">{formatNumber(totalProviders)}</div>
              <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Major labs and platforms tracked in one place.</p>
            </div>
            <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Recent launches</p>
              <div class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50" data-stat="launches">{formatNumber(recentLaunches)}</div>
              <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Models first seen in the last 30 days.</p>
            </div>
            <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Cheapest input</p>
              <div class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50" data-stat="price">{formatMoneyPerMillion(lowestInputPrice)}</div>
              <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Lowest listed input rate per million tokens.</p>
            </div>
          </div>

          <!-- Coverage + Methodology -->
          <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]" data-reveal data-reveal-delay="80">
            <div class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Coverage</p>
                  <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Filter the market by provider.</h2>
                  <p class="mt-2 max-w-2xl text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                    Use these filters to isolate releases and model cards by lab. The dataset is refreshed from structured sources and benchmark rows stay clearly labeled.
                  </p>
                </div>
                {lastSyncedAt && (
                  <div class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-4 py-2 text-sm text-zinc-500 dark:text-zinc-400">
                    Last sync: <span class="font-semibold text-zinc-700 dark:text-zinc-200">{formatDate(lastSyncedAt)}</span>
                  </div>
                )}
              </div>
              <div id="provider-filters" class="mt-6 flex flex-wrap gap-2">
                <button class="rounded-full border border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 px-4 py-2 text-sm font-semibold text-indigo-700 dark:text-indigo-300 transition-colors" data-provider-filter="all">
                  All providers <span class="text-xs opacity-70">({totalModels})</span>
                </button>
                {providers.map((p) => (
                  <button class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-2 text-sm text-zinc-600 dark:text-zinc-400 transition-colors hover:border-indigo-200 hover:text-indigo-600" data-provider-filter={p.provider}>
                    {p.providerLabel} <span class="text-xs opacity-70">({p.modelCount})</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.18)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Methodology</p>
              <h2 class="mt-2 text-white">Fresh facts, explicit limits.</h2>
              <div class="mt-5 space-y-3 text-sm leading-7 text-zinc-300">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div class="font-semibold text-white">OpenRouter API</div>
                  <p class="mt-1 text-sm leading-6 text-zinc-300">Primary source for pricing, context windows, and capability flags across providers.</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div class="font-semibold text-white">AIViewer editorial layer</div>
                  <p class="mt-1 text-sm leading-6 text-zinc-300">Strengths, watchouts, and contextual summaries written by humans, not auto-generated rankings.</p>
                </div>
                <p class="pt-1 text-xs text-zinc-400">AIViewer keeps pricing, capabilities, and benchmark rows separate so the data stays interpretable.</p>
              </div>
            </div>
          </div>

          <!-- Latest Releases + Provider Coverage -->
          <div class="grid gap-4 xl:grid-cols-[minmax(0,1.2fr)_22rem]" data-reveal data-reveal-delay="160">
            <section class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Latest releases</p>
                  <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">What changed most recently.</h2>
                </div>
                <p class="text-sm text-zinc-500 dark:text-zinc-400">
                  Active filter: <span id="active-provider-label" class="font-semibold text-zinc-700 dark:text-zinc-200">All providers</span>
                </p>
              </div>
              <div id="release-list" class="mt-6 grid gap-4 md:grid-cols-2">
                {latestReleases.map((release) => (
                  <article class="release-card rounded-[1.4rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/50 p-5" data-provider={release.provider}>
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <span class="inline-flex rounded-full bg-white dark:bg-zinc-900 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
                          {release.providerLabel}
                        </span>
                        <h3 class="mt-3 text-lg text-zinc-950 dark:text-zinc-50">{release.name}</h3>
                      </div>
                      <span class="text-xs text-zinc-400">{formatDate(release.releaseDate)}</span>
                    </div>
                    <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{(release.description ?? `${release.name} is part of the live tracked catalog.`).slice(0, 180)}...</p>
                    <div class="mt-4 flex flex-wrap gap-2">
                      <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">Context: {formatNumber(release.contextWindow)} tokens</span>
                      <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">Input: {formatMoneyPerMillion(release.inputPricePerMillion)}</span>
                      <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">Output: {formatMoneyPerMillion(release.outputPricePerMillion)}</span>
                    </div>
                    <div class="mt-4">
                      <a href={`/models/${release.slug}/`} class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
                        Open model page
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>

            <aside class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Provider spread</p>
              <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Coverage by company.</h2>
              <div class="mt-6 space-y-3">
                {providers.map((p) => (
                  <div class="provider-coverage-card rounded-2xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50/60 dark:bg-indigo-900/20 p-4" data-provider={p.provider}>
                    <div class="flex items-center justify-between gap-3">
                      <div>
                        <div class="font-semibold text-indigo-700 dark:text-indigo-300">{p.providerLabel}</div>
                        <div class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Latest release: {formatDate(p.latestReleaseAt)}</div>
                      </div>
                      <div class="text-right">
                        <div class="text-2xl font-bold text-zinc-950 dark:text-zinc-50">{p.modelCount}</div>
                        <div class="text-xs text-zinc-400">models</div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </aside>
          </div>

          <!-- Model Grid -->
          <section class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]" data-reveal data-reveal-delay="240">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Tracked models</p>
                <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Catalog view for decision-making.</h2>
                <p id="models-subtitle" class="mt-2 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                  Showing {totalModels} models across all providers.
                </p>
              </div>
              <div class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-4 py-2 text-sm text-zinc-500 dark:text-zinc-400">
                Benchmarked models: <span class="font-semibold text-zinc-700 dark:text-zinc-200">{benchmarkedModels}</span>
              </div>
            </div>
            <div id="model-grid" class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {models.map((model) => {
                const capabilityTags = [
                  model.supportsToolUse ? 'Tool use' : null,
                  model.supportsVision ? 'Vision' : null,
                  model.supportsAudio ? 'Audio' : null,
                  model.supportsReasoning ? 'Reasoning' : null,
                ].filter(Boolean);
                return (
                  <article class="model-card flex h-full flex-col rounded-[1.5rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/50 p-5" data-provider={model.provider}>
                    <div class="flex items-start justify-between gap-4">
                      <div class="min-w-0">
                        <span class="inline-flex rounded-full bg-white dark:bg-zinc-900 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
                          {model.providerLabel}
                        </span>
                        <h3 class="mt-3 text-xl text-zinc-950 dark:text-zinc-50">{model.name}</h3>
                      </div>
                      <span class="text-xs text-zinc-400">{formatDate(model.releaseDate)}</span>
                    </div>
                    <p class="mt-3 flex-1 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{(model.description ?? 'No editorial summary stored yet for this model.').slice(0, 200)}...</p>
                    <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
                      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
                        <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Context</div>
                        <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">{formatNumber(model.contextWindow)} tokens</div>
                      </div>
                      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
                        <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Benchmark</div>
                        <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">
                          {model.benchmarkScore !== null && model.benchmarkScore !== undefined
                            ? `${model.benchmarkName ?? 'Tracked score'}: ${formatNumber(model.benchmarkScore)}`
                            : 'Not listed yet'}
                        </div>
                      </div>
                      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
                        <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Input</div>
                        <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">{formatMoneyPerMillion(model.inputPricePerMillion)}</div>
                      </div>
                      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
                        <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Output</div>
                        <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">{formatMoneyPerMillion(model.outputPricePerMillion)}</div>
                      </div>
                    </div>
                    <div class="mt-5 flex flex-wrap gap-2">
                      {(capabilityTags.length > 0 ? capabilityTags : ['Capability flags pending']).map((tag) => (
                        <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">{tag}</span>
                      ))}
                    </div>
                    <div class="mt-5 border-t border-zinc-200 dark:border-zinc-800 pt-4 text-xs text-zinc-400">
                      <div>Last refreshed {formatDate(model.lastSeenAt)}</div>
                      <a href={`/models/${model.slug}/`} class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
                        Open model page
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Client-side provider filter — purely progressive enhancement on top of SSG content
  function initFilters() {
    const filterContainer = document.getElementById('provider-filters');
    const releaseList = document.getElementById('release-list');
    const modelGrid = document.getElementById('model-grid');
    const subtitleEl = document.getElementById('models-subtitle');
    const providerLabel = document.getElementById('active-provider-label');
    if (!filterContainer) return;

    let activeProvider = 'all';

    function applyFilter() {
      // Update filter button styles
      filterContainer!.querySelectorAll('[data-provider-filter]').forEach((btn) => {
        const val = btn.getAttribute('data-provider-filter');
        const isActive = val === activeProvider;
        const base = 'rounded-full border px-4 py-2 text-sm transition-colors';
        btn.className = isActive
          ? `${base} border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 font-semibold`
          : `${base} border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:border-indigo-200 hover:text-indigo-600`;
      });

      // Filter release cards
      if (releaseList) {
        releaseList.querySelectorAll('.release-card').forEach((card) => {
          const cardProvider = (card as HTMLElement).dataset.provider;
          (card as HTMLElement).style.display = (activeProvider === 'all' || cardProvider === activeProvider) ? '' : 'none';
        });
      }

      // Filter model cards
      let visibleCount = 0;
      if (modelGrid) {
        modelGrid.querySelectorAll('.model-card').forEach((card) => {
          const cardProvider = (card as HTMLElement).dataset.provider;
          const show = activeProvider === 'all' || cardProvider === activeProvider;
          (card as HTMLElement).style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });
      }

      // Update subtitle and active label
      const label = activeProvider === 'all' ? 'all providers' : (filterContainer!.querySelector(`[data-provider-filter="${activeProvider}"]`)?.textContent?.trim().split('(')[0]?.trim() ?? activeProvider);
      if (subtitleEl) subtitleEl.textContent = `Showing ${visibleCount} models for ${label.toLowerCase()}.`;
      if (providerLabel) providerLabel.textContent = activeProvider === 'all' ? 'All providers' : label;

      // Highlight provider coverage cards
      document.querySelectorAll('.provider-coverage-card').forEach((card) => {
        const cardProvider = (card as HTMLElement).dataset.provider;
        const isActive = activeProvider === 'all' || cardProvider === activeProvider;
        if (isActive) {
          card.className = card.className.replace(/border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950\/50/g, 'border-indigo-200 dark:border-indigo-800 bg-indigo-50/60 dark:bg-indigo-900/20');
          card.querySelector('div > div:first-child > div:first-child')?.classList.replace('text-zinc-900', 'text-indigo-700');
        } else {
          card.className = card.className.replace(/border-indigo-200 dark:border-indigo-800 bg-indigo-50\/60 dark:bg-indigo-900\/20/g, 'border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50');
        }
      });
    }

    filterContainer.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-provider-filter]');
      if (!btn) return;
      activeProvider = btn.getAttribute('data-provider-filter') || 'all';
      applyFilter();
    });
  }

  document.addEventListener('DOMContentLoaded', initFilters);
  document.addEventListener('astro:page-load', initFilters);
</script>
