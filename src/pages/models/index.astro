---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import WebsiteSchema from '../../components/seo/WebsiteSchema.astro';
---

<BaseLayout
  title="AI Model Tracker | AIViewer"
  description="Track AI model launches, pricing, context windows, and benchmark snapshots across OpenAI, Anthropic, Google, xAI, Mistral, Qwen, Perplexity, Kimi, and more."
>
  <Fragment slot="head">
    <WebsiteSchema />
  </Fragment>

  <Header />

  <main class="pt-28 pb-24">
    <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="absolute inset-x-0 top-0 h-80 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.22),_transparent_36%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.10),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_36%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_38%)]"></div>
      <div class="page-container relative py-12 md:py-16">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Live catalog
          </div>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">Track what changed across the frontier model market.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Follow launches, pricing, context windows, and benchmark snapshots without mixing everything into a fake universal score.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Release tracking</span>
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Pricing snapshots</span>
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Capability coverage</span>
            <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-900/70 px-3 py-1">Benchmark context</span>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-bg)]">
      <div class="page-container py-10 md:py-14">
        <div
          id="models-dashboard"
          class="relative"
          data-api-url="https://aiviewer-benchmark-api.qaisar-roonjha.workers.dev/api/dashboard"
        >
          <div id="dashboard-loading" class="absolute inset-0 z-20 flex min-h-[420px] flex-col items-center justify-center rounded-[2rem] border border-zinc-200 dark:border-zinc-800 bg-white/88 dark:bg-zinc-950/88 backdrop-blur-sm">
            <svg class="mb-4 h-9 w-9 animate-spin text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.37 0 0 5.37 0 12h4zm2 5.29A7.95 7.95 0 014 12H0c0 3.04 1.14 5.82 3 7.94l3-2.65z"></path>
            </svg>
            <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">Syncing the latest catalog from the edge...</p>
          </div>

          <div id="dashboard-error" class="hidden rounded-[2rem] border border-red-200 dark:border-red-900/50 bg-red-50/70 dark:bg-red-950/20 p-8 text-center">
            <h2 class="text-xl text-zinc-950 dark:text-zinc-50">Could not load live model data.</h2>
            <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
              The tracker could not reach the Worker API. Retry in a moment or confirm the Worker deployment is live.
            </p>
            <button
              id="dashboard-retry"
              class="mt-5 inline-flex items-center rounded-full bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-zinc-800 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100"
            >
              Retry request
            </button>
          </div>

          <div id="dashboard-content" class="space-y-8">
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
              <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Tracked models</p>
                <div id="stat-models" class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50">--</div>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Models actively covered in the live catalog.</p>
              </div>
              <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Providers</p>
                <div id="stat-providers" class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50">--</div>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Major labs and platforms tracked in one place.</p>
              </div>
              <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Recent launches</p>
                <div id="stat-launches" class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50">--</div>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Models first seen in the last 30 days.</p>
              </div>
              <div class="rounded-[1.6rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">Cheapest input</p>
                <div id="stat-price" class="mt-3 text-4xl font-bold text-zinc-950 dark:text-zinc-50">--</div>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Lowest listed input rate per million tokens.</p>
              </div>
            </div>

            <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
              <div class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Coverage</p>
                    <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Filter the market by provider.</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                      Use these filters to isolate releases and model cards by lab. The dataset is refreshed from structured sources and benchmark rows stay clearly labeled.
                    </p>
                  </div>
                  <div class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-4 py-2 text-sm text-zinc-500 dark:text-zinc-400">
                    Last sync: <span id="summary-last-sync" class="font-semibold text-zinc-700 dark:text-zinc-200">--</span>
                  </div>
                </div>
                <div id="provider-filters" class="mt-6 flex flex-wrap gap-2"></div>
              </div>

              <div class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.18)]">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Methodology</p>
                <h2 class="mt-2 text-white">Fresh facts, explicit limits.</h2>
                <div id="source-list" class="mt-5 space-y-3 text-sm leading-7 text-zinc-300"></div>
              </div>
            </div>

            <div class="grid gap-4 xl:grid-cols-[minmax(0,1.2fr)_22rem]">
              <section class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
                <div class="flex flex-wrap items-end justify-between gap-4">
                  <div>
                    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Latest releases</p>
                    <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">What changed most recently.</h2>
                  </div>
                  <p class="text-sm text-zinc-500 dark:text-zinc-400">
                    Active filter: <span id="active-provider-label" class="font-semibold text-zinc-700 dark:text-zinc-200">All providers</span>
                  </p>
                </div>
                <div id="release-list" class="mt-6 grid gap-4 md:grid-cols-2"></div>
              </section>

              <aside class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Provider spread</p>
                <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Coverage by company.</h2>
                <div id="provider-coverage-list" class="mt-6 space-y-3"></div>
              </aside>
            </div>

            <section class="rounded-[1.8rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 shadow-[var(--shadow-card)]">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Tracked models</p>
                  <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Catalog view for decision-making.</h2>
                  <p id="models-subtitle" class="mt-2 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                    Models are shown with release timing, pricing, capabilities, and any available benchmark context.
                  </p>
                </div>
                <div class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-4 py-2 text-sm text-zinc-500 dark:text-zinc-400">
                  Benchmarked models: <span id="benchmarked-count" class="font-semibold text-zinc-700 dark:text-zinc-200">--</span>
                </div>
              </div>
              <div id="model-grid" class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
            </section>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const dashboardRoot = document.getElementById('models-dashboard');
  const loadingState = document.getElementById('dashboard-loading');
  const errorState = document.getElementById('dashboard-error');
  const retryButton = document.getElementById('dashboard-retry');

  const state = {
    dashboard: null,
    activeProvider: 'all',
  };

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function formatNumber(value) {
    if (value === null || value === undefined || Number.isNaN(Number(value))) {
      return '--';
    }
    return new Intl.NumberFormat('en-US').format(Number(value));
  }

  function formatMoneyPerMillion(value) {
    if (value === null || value === undefined || Number.isNaN(Number(value))) {
      return 'TBD';
    }

    const numeric = Number(value);
    const decimals = numeric >= 10 ? 0 : numeric >= 1 ? 2 : 3;
    return `$${numeric.toFixed(decimals)}/M`;
  }

  function formatDate(value) {
    if (!value) return 'Unknown';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return 'Unknown';
    return new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(date);
  }

  function formatRelative(value) {
    if (!value) return 'Unknown';

    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return 'Unknown';

    const diffMs = date.getTime() - Date.now();
    const diffHours = Math.round(diffMs / (1000 * 60 * 60));
    const formatter = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });

    if (Math.abs(diffHours) < 24) {
      return formatter.format(diffHours, 'hour');
    }

    const diffDays = Math.round(diffHours / 24);
    if (Math.abs(diffDays) < 30) {
      return formatter.format(diffDays, 'day');
    }

    const diffMonths = Math.round(diffDays / 30);
    return formatter.format(diffMonths, 'month');
  }

  function setText(id, value) {
    const node = document.getElementById(id);
    if (node) {
      node.textContent = value;
    }
  }

  function getActiveProviderLabel() {
    if (!state.dashboard || state.activeProvider === 'all') {
      return 'All providers';
    }

    const match = (state.dashboard.providers || []).find((provider) => provider.provider === state.activeProvider);
    return match ? match.providerLabel : 'All providers';
  }

  function getFilteredModels() {
    const models = state.dashboard?.models || [];
    if (state.activeProvider === 'all') {
      return models;
    }
    return models.filter((model) => model.provider === state.activeProvider);
  }

  function getFilteredReleases() {
    const releases = state.dashboard?.latestReleases || [];
    if (state.activeProvider === 'all') {
      return releases;
    }
    return releases.filter((release) => release.provider === state.activeProvider);
  }

  function renderSummary() {
    const summary = state.dashboard?.summary;
    if (!summary) return;

    setText('stat-models', formatNumber(summary.totalModels));
    setText('stat-providers', formatNumber(summary.totalProviders));
    setText('stat-launches', formatNumber(summary.recentLaunches));
    setText('stat-price', formatMoneyPerMillion(summary.lowestInputPricePerMillion));
    setText('summary-last-sync', formatRelative(summary.lastSyncedAt));
    setText('benchmarked-count', formatNumber(summary.benchmarkedModels));
  }

  function renderSources() {
    const sourceList = document.getElementById('source-list');
    if (!sourceList) return;

    const sources = state.dashboard?.sources || [];
    sourceList.innerHTML = sources.map((source) => `
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
        <div class="font-semibold text-white">${escapeHtml(source.label)}</div>
        <p class="mt-1 text-sm leading-6 text-zinc-300">${escapeHtml(source.purpose)}</p>
      </div>
    `).join('') + `
      <p class="pt-1 text-xs text-zinc-400">AIViewer keeps pricing, capabilities, and benchmark rows separate so the data stays interpretable.</p>
    `;
  }

  function renderProviderFilters() {
    const container = document.getElementById('provider-filters');
    if (!container) return;

    const providers = state.dashboard?.providers || [];
    const buttons = [
      {
        provider: 'all',
        providerLabel: 'All providers',
        modelCount: state.dashboard?.summary?.totalModels || 0,
      },
      ...providers,
    ];

    container.innerHTML = buttons.map((provider) => {
      const active = provider.provider === state.activeProvider;
      const base = 'rounded-full border px-4 py-2 text-sm transition-colors';
      const classes = active
        ? `${base} border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 font-semibold`
        : `${base} border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:border-indigo-200 hover:text-indigo-600`;

      return `
        <button class="${classes}" data-provider-filter="${escapeHtml(provider.provider)}">
          ${escapeHtml(provider.providerLabel)} <span class="text-xs opacity-70">(${formatNumber(provider.modelCount)})</span>
        </button>
      `;
    }).join('');

    container.querySelectorAll('[data-provider-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        state.activeProvider = button.getAttribute('data-provider-filter') || 'all';
        renderDashboardSlices();
      });
    });
  }

  function renderProviderCoverage() {
    const container = document.getElementById('provider-coverage-list');
    if (!container) return;

    const providers = state.dashboard?.providers || [];
    container.innerHTML = providers.map((provider) => {
      const active = provider.provider === state.activeProvider || state.activeProvider === 'all';
      return `
        <div class="rounded-2xl border ${active ? 'border-indigo-200 dark:border-indigo-800 bg-indigo-50/60 dark:bg-indigo-900/20' : 'border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50'} p-4">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="font-semibold ${active ? 'text-indigo-700 dark:text-indigo-300' : 'text-zinc-900 dark:text-zinc-50'}">${escapeHtml(provider.providerLabel)}</div>
              <div class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Latest release: ${formatDate(provider.latestReleaseAt)}</div>
            </div>
            <div class="text-right">
              <div class="text-2xl font-bold text-zinc-950 dark:text-zinc-50">${formatNumber(provider.modelCount)}</div>
              <div class="text-xs text-zinc-400">models</div>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function renderReleases() {
    const container = document.getElementById('release-list');
    if (!container) return;

    const releases = getFilteredReleases();
    setText('active-provider-label', getActiveProviderLabel());

    if (releases.length === 0) {
      container.innerHTML = `
        <div class="rounded-[1.4rem] border border-dashed border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 p-6 text-sm text-zinc-500 dark:text-zinc-400 md:col-span-2">
          No releases match the current provider filter yet.
        </div>
      `;
      return;
    }

    container.innerHTML = releases.map((release) => `
      <article class="rounded-[1.4rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/50 p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <span class="inline-flex rounded-full bg-white dark:bg-zinc-900 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
              ${escapeHtml(release.providerLabel)}
            </span>
            <h3 class="mt-3 text-lg text-zinc-950 dark:text-zinc-50">${escapeHtml(release.title)}</h3>
          </div>
          <span class="text-xs text-zinc-400">${formatDate(release.releasedAt)}</span>
        </div>
        <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400">${escapeHtml(release.summary || `${release.name} is part of the live tracked catalog.`)}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">Context: ${formatNumber(release.contextWindow)} tokens</span>
          <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">Input: ${formatMoneyPerMillion(release.inputPricePerMillion)}</span>
          <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">Output: ${formatMoneyPerMillion(release.outputPricePerMillion)}</span>
        </div>
        <div class="mt-4">
          <a href="/models/${escapeHtml(release.slug)}/" class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
            Open model page
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </article>
    `).join('');
  }

  function renderModels() {
    const container = document.getElementById('model-grid');
    if (!container) return;

    const models = getFilteredModels();
    setText('models-subtitle', `Showing ${formatNumber(models.length)} models for ${getActiveProviderLabel().toLowerCase()}.`);

    if (models.length === 0) {
      container.innerHTML = `
        <div class="rounded-[1.4rem] border border-dashed border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 p-6 text-sm text-zinc-500 dark:text-zinc-400 md:col-span-2 xl:col-span-3">
          No tracked models match the current provider filter.
        </div>
      `;
      return;
    }

    container.innerHTML = models.map((model) => {
      const capabilityTags = [
        model.supportsToolUse ? 'Tool use' : null,
        model.supportsVision ? 'Vision' : null,
        model.supportsAudio ? 'Audio' : null,
        model.supportsReasoning ? 'Reasoning' : null,
      ].filter(Boolean);

      return `
        <article class="flex h-full flex-col rounded-[1.5rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/50 p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <span class="inline-flex rounded-full bg-white dark:bg-zinc-900 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
                ${escapeHtml(model.providerLabel)}
              </span>
              <h3 class="mt-3 text-xl text-zinc-950 dark:text-zinc-50">${escapeHtml(model.name)}</h3>
            </div>
            <span class="text-xs text-zinc-400">${formatDate(model.releaseDate)}</span>
          </div>

          <p class="mt-3 flex-1 text-sm leading-7 text-zinc-600 dark:text-zinc-400">${escapeHtml(model.description || 'No editorial summary stored yet for this model.')}</p>

          <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
              <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Context</div>
              <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">${formatNumber(model.contextWindow)} tokens</div>
            </div>
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
              <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Benchmark</div>
              <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">${model.benchmarkScore !== null && model.benchmarkScore !== undefined ? escapeHtml(model.benchmarkName || 'Tracked score') + ': ' + formatNumber(model.benchmarkScore) : 'Not listed yet'}</div>
            </div>
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
              <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Input</div>
              <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">${formatMoneyPerMillion(model.inputPricePerMillion)}</div>
            </div>
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-3">
              <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Output</div>
              <div class="mt-1 font-semibold text-zinc-900 dark:text-zinc-50">${formatMoneyPerMillion(model.outputPricePerMillion)}</div>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap gap-2">
            ${(capabilityTags.length > 0 ? capabilityTags : ['Capability flags pending']).map((tag) => `
              <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-3 py-1 text-xs text-zinc-500 dark:text-zinc-400">${escapeHtml(tag)}</span>
            `).join('')}
          </div>

          <div class="mt-5 border-t border-zinc-200 dark:border-zinc-800 pt-4 text-xs text-zinc-400">
            <div>Last refreshed ${formatRelative(model.lastSeenAt)}</div>
            <a href="/models/${escapeHtml(model.slug)}/" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
              Open model page
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </article>
      `;
    }).join('');
  }

  function renderDashboardSlices() {
    renderSummary();
    renderSources();
    renderProviderFilters();
    renderProviderCoverage();
    renderReleases();
    renderModels();
  }

  async function loadDashboard() {
    const apiUrl = dashboardRoot?.getAttribute('data-api-url');
    if (!apiUrl) return;

    if (errorState) {
      errorState.classList.add('hidden');
    }
    if (loadingState) {
      loadingState.classList.remove('hidden');
    }

    try {
      const response = await fetch(apiUrl);
      if (!response.ok) {
        throw new Error(`Dashboard request failed with ${response.status}`);
      }

      const payload = await response.json();
      if (!payload.success || !payload.dashboard) {
        throw new Error('Worker returned an unexpected payload');
      }

      state.dashboard = payload.dashboard;
      renderDashboardSlices();
    } catch (error) {
      console.error(error);
      if (errorState) {
        errorState.classList.remove('hidden');
      }
    } finally {
      if (loadingState) {
        loadingState.classList.add('hidden');
      }
    }
  }

  if (retryButton) {
    retryButton.addEventListener('click', loadDashboard);
  }

  document.addEventListener('DOMContentLoaded', loadDashboard);
  document.addEventListener('astro:page-load', loadDashboard);
</script>
