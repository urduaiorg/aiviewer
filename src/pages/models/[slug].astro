---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import WebsiteSchema from '../../components/seo/WebsiteSchema.astro';
import NewsletterSignup from '../../components/content/NewsletterSignup.astro';
import FreshnessIndicator from '../../components/content/FreshnessIndicator.astro';
import WhatChanged from '../../components/content/WhatChanged.astro';
import { formatDate } from '../../utils/formatDate';
import { generateComparisonPairs, comparisonSlug } from '../../utils/comparisonPairs';
import { shouldNoindexPath } from '../../utils/indexPolicy';
import modelCatalogSnapshot from '../../data/model-catalog.snapshot.json';

interface ModelRecord {
  id: string;
  slug: string;
  name: string;
  provider: string;
  providerLabel: string;
  modelFamily?: string | null;
  description?: string | null;
  releaseDate?: string | null;
  contextWindow?: number | null;
  maxOutputTokens?: number | null;
  supportsToolUse?: boolean;
  supportsVision?: boolean;
  supportsAudio?: boolean;
  supportsReasoning?: boolean;
  inputPricePerMillion?: number | null;
  outputPricePerMillion?: number | null;
  cachedInputPricePerMillion?: number | null;
  currency?: string | null;
  benchmarkName?: string | null;
  benchmarkScore?: number | null;
  lastSeenAt?: string | null;
  providerWebsiteUrl?: string | null;
  strengths?: string[];
  watchouts?: string[];
  releaseHistory?: {
    eventType: string;
    title: string;
    summary?: string | null;
    sourceUrl?: string | null;
    releasedAt?: string | null;
  }[];
  relatedModels?: ModelRecord[];
  pricingHistory?: {
    inputPricePerMillion?: number | null;
    outputPricePerMillion?: number | null;
    cachedInputPricePerMillion?: number | null;
    recordedAt?: string | null;
  }[];
}

export async function getStaticPaths() {
  const models = Array.isArray(modelCatalogSnapshot.models) ? modelCatalogSnapshot.models : [];

  return models.filter((model) => !shouldNoindexPath(`/models/${model.slug}/`)).map((model) => ({
    params: { slug: model.slug },
    props: { modelSummary: model },
  }));
}

const { modelSummary } = Astro.props as { modelSummary: ModelRecord };

const model = {
  strengths: [],
  watchouts: [],
  releaseHistory: [],
  relatedModels: [],
  pricingHistory: [],
  ...modelSummary,
};

const publishedDate = model.releaseDate ? new Date(model.releaseDate) : null;
const lastSeenDate = model.lastSeenAt ? new Date(model.lastSeenAt) : null;
const capabilityFlags = [
  model.supportsToolUse ? 'Tool use' : null,
  model.supportsVision ? 'Vision' : null,
  model.supportsAudio ? 'Audio' : null,
  model.supportsReasoning ? 'Reasoning' : null,
].filter(Boolean);

function formatPrice(value?: number | null) {
  if (value === null || value === undefined) return 'TBD';
  const decimals = value >= 10 ? 0 : value >= 1 ? 2 : 3;
  return `$${value.toFixed(decimals)}/M`;
}

function formatCount(value?: number | null) {
  if (value === null || value === undefined) return 'Unknown';
  return new Intl.NumberFormat('en-US').format(value);
}

function formatMaybeDate(value?: string | null) {
  if (!value) return 'Unknown';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Unknown';
  return formatDate(date);
}

const timeline = model.releaseHistory.length > 0
  ? model.releaseHistory
  : [{
      eventType: 'release',
      title: `${model.name} is in the tracked catalog`,
      summary: model.description,
      sourceUrl: model.providerWebsiteUrl ?? null,
      releasedAt: model.releaseDate ?? null,
    }];

// Build pricing change history for WhatChanged
const whatChangedItems: { type: 'launch' | 'price' | 'capability' | 'release'; description: string; date?: string | null; detail?: string | null }[] = [];
if (model.releaseDate) {
  whatChangedItems.push({ type: 'launch', description: `${model.providerLabel} launched ${model.name}`, date: model.releaseDate });
}
if (model.pricingHistory && model.pricingHistory.length > 1) {
  for (let i = 0; i < model.pricingHistory.length - 1; i++) {
    const newer = model.pricingHistory[i];
    const older = model.pricingHistory[i + 1];
    if (newer.outputPricePerMillion != null && older.outputPricePerMillion != null && newer.outputPricePerMillion !== older.outputPricePerMillion) {
      whatChangedItems.push({
        type: 'price',
        description: `Output price changed`,
        detail: `$${older.outputPricePerMillion}/M → $${newer.outputPricePerMillion}/M`,
        date: newer.recordedAt,
      });
    }
  }
}
for (const event of model.releaseHistory) {
  if (event.eventType !== 'release') {
    whatChangedItems.push({ type: 'release', description: event.title, date: event.releasedAt });
  }
}

// Generate comparison links for this model
const allModels = Array.isArray(modelCatalogSnapshot.models) ? modelCatalogSnapshot.models : [];
const allPairs = generateComparisonPairs(allModels);
const modelPairs = allPairs
  .filter((p) => p.slugA === model.slug || p.slugB === model.slug)
  .slice(0, 6);
---

<BaseLayout
  title={`${model.name} | Model Tracker`}
  description={model.description ?? `Catalog snapshot for ${model.name}, including pricing, context window, capability flags, and release history.`}
  canonicalUrl={`https://aiviewer.ai/models/${model.slug}/`}
  noindex={shouldNoindexPath(Astro.url.pathname)}
>
  <Fragment slot="head">
    <WebsiteSchema />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": model.name,
      "description": model.description ?? `Catalog snapshot for ${model.name}.`,
      "url": `https://aiviewer.ai/models/${model.slug}/`,
      "datePublished": model.releaseDate ?? undefined,
      "dateModified": model.lastSeenAt ?? model.releaseDate ?? undefined,
      "author": { "@type": "Organization", "name": "AIViewer.ai", "url": "https://aiviewer.ai" },
      "publisher": { "@type": "Organization", "name": "AIViewer.ai", "url": "https://aiviewer.ai" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": `https://aiviewer.ai/models/${model.slug}/` },
      "about": {
        "@type": "SoftwareApplication",
        "name": model.name,
        "applicationCategory": "AI Model",
        "operatingSystem": "Cloud",
        ...(model.providerLabel && { "author": { "@type": "Organization", "name": model.providerLabel } }),
        ...(model.inputPricePerMillion !== null && model.inputPricePerMillion !== undefined && {
          "offers": {
            "@type": "Offer",
            "price": model.inputPricePerMillion,
            "priceCurrency": "USD",
            "description": `$${model.inputPricePerMillion}/M input tokens`,
          }
        }),
      },
    })} />
  </Fragment>

  <Header />

  <main class="pt-28 pb-24">
    <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="absolute inset-x-0 top-0 h-80 bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.12),_transparent_40%),radial-gradient(circle_at_top_right,_rgba(240,199,94,0.18),_transparent_36%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.06),_transparent_40%),radial-gradient(circle_at_top_right,_rgba(240,199,94,0.08),_transparent_36%)]"></div>
      <div class="page-container relative py-12 md:py-16">
        <Breadcrumbs items={[{ label: 'Models', href: '/models/' }, { label: model.name }]} />

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
          <div class="max-w-3xl">
            <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
              <span class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
                {model.providerLabel}
              </span>
              {publishedDate && <span>Released {formatDate(publishedDate)}</span>}
              {lastSeenDate && (
                <>
                  <span aria-hidden="true">·</span>
                  <FreshnessIndicator date={lastSeenDate} label="Snapshot updated" />
                </>
              )}
            </div>

            <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">{model.name}</h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
              {model.description ?? `${model.name} is in the AIViewer catalog snapshot. Use this page to review pricing, context, modality support, and nearby alternatives.`}
            </p>

            <div class="mt-8 flex flex-wrap gap-2">
              {capabilityFlags.length > 0 ? capabilityFlags.map((flag) => (
                <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-1 text-xs text-zinc-600 dark:text-zinc-400">{flag}</span>
              )) : (
                <span class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-1 text-xs text-zinc-600 dark:text-zinc-400">Text-first snapshot</span>
              )}
            </div>
          </div>

          <aside class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.18)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">At a glance</p>
            <div class="mt-5 space-y-5">
              <div>
                <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Context window</p>
                <p class="mt-2 text-base font-semibold text-white">{formatCount(model.contextWindow)} tokens</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Input price</p>
                <p class="mt-2 text-base font-semibold text-white">{formatPrice(model.inputPricePerMillion)}</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Output price</p>
                <p class="mt-2 text-base font-semibold text-white">{formatPrice(model.outputPricePerMillion)}</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Max output</p>
                <p class="mt-2 text-base font-semibold text-white">{formatCount(model.maxOutputTokens)} tokens</p>
              </div>
              {model.providerWebsiteUrl && (
                <div>
                  <p class="text-xs uppercase tracking-[0.14em] text-zinc-500">Provider</p>
                  <a href={model.providerWebsiteUrl} target="_blank" rel="noopener" class="mt-2 inline-flex text-sm font-medium text-[#F0C75E] hover:text-white">
                    Visit official site
                  </a>
                </div>
              )}
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-bg)]">
      <div class="page-container py-12 md:py-16">
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Why it stands out</p>
            <div class="mt-5 space-y-4">
              {model.strengths.length > 0 ? model.strengths.map((item) => (
                <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 p-4 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                  {item}
                </div>
              )) : (
                <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 p-4 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                  AIViewer has not added custom strengths for this model yet. Use the catalog snapshot and related models below for context.
                </div>
              )}
            </div>
          </div>

          <div class="rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-amber-600 dark:text-amber-400">What to watch</p>
            <div class="mt-5 space-y-4">
              {model.watchouts.length > 0 ? model.watchouts.map((item) => (
                <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 p-4 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                  {item}
                </div>
              )) : (
                <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 p-4 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                  No custom cautions are stored yet. Compare pricing, output cost, and capability flags before standardizing on this model.
                </div>
              )}
            </div>
          </div>
        </div>

        <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.2fr)_20rem]">
          <section class="rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Release timeline</p>
                <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Tracked events for {model.name}.</h2>
              </div>
              <a href="/models/" class="text-sm font-medium text-indigo-600 dark:text-indigo-400">Back to model tracker</a>
            </div>

            <div class="mt-6 space-y-4">
              {timeline.map((event) => (
                <article class="rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/50 p-5">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">{event.eventType}</p>
                      <h3 class="mt-2 text-lg text-zinc-950 dark:text-zinc-50">{event.title}</h3>
                    </div>
                    <span class="text-xs text-zinc-400">{formatMaybeDate(event.releasedAt)}</span>
                  </div>
                  {event.summary && <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{event.summary}</p>}
                  {event.sourceUrl && (
                    <a href={event.sourceUrl} target="_blank" rel="noopener" class="mt-4 inline-flex text-sm font-medium text-indigo-600 dark:text-indigo-400">
                      View source
                    </a>
                  )}
                </article>
              ))}
            </div>
          </section>

          <aside class="rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Catalog snapshot</p>
            <div class="mt-5 space-y-4">
              <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 p-4">
                <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Cached input</div>
                <div class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-50">{formatPrice(model.cachedInputPricePerMillion)}</div>
              </div>
              <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 p-4">
                <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Benchmark</div>
                <div class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-50">
                  {model.benchmarkScore !== null && model.benchmarkScore !== undefined
                    ? `${model.benchmarkName ?? 'Tracked benchmark'}: ${new Intl.NumberFormat('en-US').format(model.benchmarkScore)}`
                    : 'Benchmark data not populated yet'}
                </div>
              </div>
              <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 p-4">
                <div class="text-xs uppercase tracking-[0.14em] text-zinc-400">Model family</div>
                <div class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-50">{model.modelFamily ?? 'General purpose'}</div>
              </div>
            </div>
          </aside>
        </div>

        <section class="mt-6 rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Nearby alternatives</p>
              <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">Other {model.providerLabel} models worth checking.</h2>
            </div>
            <a href="/finder/" class="text-sm font-medium text-indigo-600 dark:text-indigo-400">Need a recommendation instead?</a>
          </div>

          <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {model.relatedModels.length > 0 ? model.relatedModels.map((related) => (
              <a href={`/models/${related.slug}/`} class="group flex h-full flex-col rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/50 p-5 transition-colors hover:border-indigo-200 dark:hover:border-indigo-800">
                <span class="rounded-full bg-white dark:bg-zinc-900 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">{related.providerLabel}</span>
                <h3 class="mt-4 text-lg text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">{related.name}</h3>
                <p class="mt-3 flex-1 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{related.description?.slice(0, 140) ?? 'No description stored yet.'}</p>
                <div class="mt-4 grid grid-cols-2 gap-3 text-xs text-zinc-500 dark:text-zinc-400">
                  <div>Input {formatPrice(related.inputPricePerMillion)}</div>
                  <div>Context {formatCount(related.contextWindow)}</div>
                </div>
              </a>
            )) : (
              <div class="rounded-[var(--radius-lg)] border border-dashed border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 p-6 text-sm text-zinc-500 dark:text-zinc-400 md:col-span-2 xl:col-span-4">
                No related models are stored for this provider yet.
              </div>
            )}
          </div>
        </section>

        {whatChangedItems.length > 0 && (
          <div class="mt-6">
            <WhatChanged changes={whatChangedItems} limit={4} />
          </div>
        )}

        {modelPairs.length > 0 && (
          <section class="mt-6 rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-7 shadow-[var(--shadow-card)]">
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Compare</p>
                <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">See how {model.name} stacks up.</h2>
              </div>
              <a href="/compare/" class="text-sm font-medium text-indigo-600 dark:text-indigo-400">All comparisons</a>
            </div>
            <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {modelPairs.map((pair) => {
                const otherName = pair.slugA === model.slug ? pair.nameB : pair.nameA;
                const slug = comparisonSlug(pair.slugA, pair.slugB);
                return (
                  <a
                    href={`/compare/${slug}/`}
                    class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-950/50 p-4 transition-colors hover:border-indigo-200 dark:hover:border-indigo-800"
                  >
                    <p class="text-sm font-semibold text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-300">
                      vs {otherName}
                    </p>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
                      Side-by-side pricing, context, and capabilities
                    </p>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <div class="mt-6">
          <NewsletterSignup
            heading="Stay ahead of model releases."
            subtitle="Get the sharpest changes in tools, model launches, and decision-ready AI guidance without the hype cycle."
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
