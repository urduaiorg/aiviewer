---
/**
 * Tags Index — Discover content by topic across every collection.
 *
 * Aggregates tags from all five content collections (playbooks, tools,
 * guides, reports, prompts) and presents them as a weighted tag cloud
 * with article counts. Links to individual /tags/[tag]/ pages.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import CollectionSchema from '../../components/seo/CollectionSchema.astro';
import { slugifyTag } from '../../utils/slugifyTag';
import { shouldNoindexPath } from '../../utils/indexPolicy';

// ── Gather all tags across every collection ──────────────────────
const [playbooks, tools, guides, reports, prompts] = await Promise.all([
  getCollection('playbooks', ({ data }) => !data.draft),
  getCollection('tools', ({ data }) => !data.draft),
  getCollection('guides', ({ data }) => !data.draft),
  getCollection('reports', ({ data }) => !data.draft),
  getCollection('prompts', ({ data }) => !data.draft),
]);

const tagMap = new Map<string, { count: number; display: string; collections: Set<string> }>();

const addTags = (entries: { data: { tags: string[] } }[], collectionName: string) => {
  for (const entry of entries) {
    for (const tag of entry.data.tags) {
      const lower = tag.toLowerCase();
      const existing = tagMap.get(lower);
      if (existing) {
        existing.count++;
        existing.collections.add(collectionName);
      } else {
        // Keep first-seen casing as display name (e.g. "ChatGPT", "UI/UX")
        tagMap.set(lower, { count: 1, display: tag, collections: new Set([collectionName]) });
      }
    }
  }
};

addTags(playbooks, 'playbooks');
addTags(tools, 'tools');
addTags(guides, 'guides');
addTags(reports, 'reports');
addTags(prompts, 'prompts');

// Sort tags by count (desc), then alphabetically
const sortedTags = [...tagMap.entries()]
  .sort((a, b) => b[1].count - a[1].count || a[0].localeCompare(b[0]));

const totalTags = sortedTags.length;
const totalContent = playbooks.length + tools.length + guides.length + reports.length + prompts.length;
const maxCount = sortedTags.length > 0 ? sortedTags[0][1].count : 1;

// ── Collection color config for badges ───────────────────────────
const collectionColors: Record<string, string> = {
  playbooks: 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300',
  tools: 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300',
  guides: 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300',
  reports: 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300',
  prompts: 'bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300',
};

// ── Size tiers for tag cloud ─────────────────────────────────────
function getTagSize(count: number): string {
  const ratio = count / maxCount;
  if (ratio >= 0.75) return 'text-xl md:text-2xl font-bold';
  if (ratio >= 0.5) return 'text-lg md:text-xl font-semibold';
  if (ratio >= 0.3) return 'text-base md:text-lg font-medium';
  return 'text-sm font-medium';
}
---

<BaseLayout
  title="Tags"
  description="Browse all topics covered on AIViewer.ai — AI tools, prompting, education, coding, design, business, and more."
  noindex={shouldNoindexPath(Astro.url.pathname)}
>
  <Fragment slot="head">
    <CollectionSchema
      name="Tags"
      description="Browse all topics covered on AIViewer.ai — AI tools, prompting, education, coding, design, business, and more."
      url="/tags/"
      numberOfItems={totalTags}
    />
  </Fragment>
  <Header />

  <!-- ── Hero ── -->
  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.18),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.1),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Tags' }]} />

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end" data-reveal>
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:text-zinc-400">
            Topic index
          </span>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">Every topic, one map.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Browse by subject across playbooks, tool reviews, guides, reports, and prompt templates. The bigger the tag, the more content behind it.
          </p>
        </div>

        <div class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.14)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Coverage</p>
          <div class="mt-5 grid grid-cols-2 gap-4">
            <div>
              <div class="text-3xl font-bold text-[#F0C75E]">{totalTags}</div>
              <p class="mt-1 text-sm text-zinc-400">Topics</p>
            </div>
            <div>
              <div class="text-3xl font-bold">{totalContent}</div>
              <p class="mt-1 text-sm text-zinc-400">Articles</p>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {Object.entries(collectionColors).map(([name, color]) => (
              <span class:list={['rounded-full px-2 py-0.5 text-[0.6rem] font-medium capitalize', color]}>
                {name}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Tag Cloud ── -->
  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-20">

      {/* Weighted tag cloud */}
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-4 md:gap-x-5 md:gap-y-5" data-reveal>
        {sortedTags.map(([key, { count, display }]) => (
          <a
            href={`/tags/${slugifyTag(key)}/`}
            class:list={[
              'group inline-flex items-baseline gap-1.5 rounded-lg transition-colors duration-200 hover:text-indigo-600 dark:hover:text-indigo-400',
              getTagSize(count),
              'text-zinc-700 dark:text-zinc-300',
            ]}
          >
            <span class="transition-transform duration-200 group-hover:translate-x-0.5">{display}</span>
            <sup class="text-[0.6rem] font-normal text-zinc-400 dark:text-zinc-500 tabular-nums">{count}</sup>
          </a>
        ))}
      </div>

      {/* Grouped list — sorted A → Z */}
      <div class="mt-16 border-t border-zinc-200 dark:border-zinc-800 pt-12 md:mt-20 md:pt-16" data-reveal>
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">All topics A – Z</h2>

        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {[...tagMap.entries()]
            .sort((a, b) => a[0].localeCompare(b[0]))
            .map(([key, { count, display, collections }]) => (
              <a
                href={`/tags/${slugifyTag(key)}/`}
                class="group flex items-center justify-between gap-3 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 py-3 transition-all duration-200 hover:border-indigo-200 dark:hover:border-indigo-700 hover:shadow-sm"
              >
                <div class="min-w-0">
                  <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate block">{display}</span>
                  <div class="mt-1 flex flex-wrap gap-1">
                    {[...collections].map((c) => (
                      <span class:list={['rounded px-1.5 py-0.5 text-[0.55rem] font-medium capitalize', collectionColors[c] ?? 'bg-zinc-100 text-zinc-600']}>
                        {c}
                      </span>
                    ))}
                  </div>
                </div>
                <span class="shrink-0 rounded-full bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-xs font-semibold tabular-nums text-zinc-500 dark:text-zinc-400">
                  {count}
                </span>
              </a>
            ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
