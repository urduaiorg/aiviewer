---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FreshnessIndicator from '../../components/content/FreshnessIndicator.astro';
import NewsletterSignup from '../../components/content/NewsletterSignup.astro';
import { detectRecentLaunches, type ChangeEntry } from '../../utils/snapshotDiff';
import modelCatalogSnapshot from '../../data/model-catalog.snapshot.json';

const models = Array.isArray(modelCatalogSnapshot.models) ? modelCatalogSnapshot.models : [];

// Detect recent launches (60-day window)
const recentLaunches = detectRecentLaunches(models, 60);

// Build the changes timeline from launch data
const changes: ChangeEntry[] = [...recentLaunches];

// Sort by date descending
changes.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const lastSyncTimes = models.map((m) => m.lastSeenAt).filter(Boolean) as string[];
const lastSyncedAt = lastSyncTimes.length > 0 ? lastSyncTimes.sort().reverse()[0] : null;

const typeConfig: Record<string, { label: string; color: string; bgColor: string }> = {
  launch: { label: 'Launch', color: 'bg-indigo-500', bgColor: 'bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800' },
  'price-change': { label: 'Pricing', color: 'bg-emerald-500', bgColor: 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800' },
  'capability-change': { label: 'Capability', color: 'bg-amber-500', bgColor: 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800' },
};

const title = 'AI Model Changes | AIViewer';
const description = 'Track what changed in the AI model landscape — new launches, pricing shifts, and capability updates across OpenAI, Anthropic, Google, and more.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <BreadcrumbSchema items={[
      { name: 'Home', url: '/' },
      { name: 'Changes', url: '/changes/' },
    ]} />
  </Fragment>

  <Header />

  <main class="pt-28 pb-24">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="absolute inset-x-0 top-0 h-80 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.18),_transparent_36%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.12),_transparent_40%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_36%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_40%)]"></div>
      <div class="page-container relative py-12 md:py-16">
        <Breadcrumbs items={[{ label: 'Changes' }]} />

        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">
            <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
            Live feed
          </div>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">What changed in the AI model market.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Model launches, pricing shifts, and capability upgrades — tracked automatically so you can make faster decisions.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            {lastSyncedAt && <FreshnessIndicator date={lastSyncedAt} label="Last sync" />}
            <span class="text-xs text-zinc-400">
              {changes.length} events tracked
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Changes timeline -->
    <section class="bg-[var(--color-bg)]">
      <div class="page-container py-12 md:py-16">

        <!-- Filter buttons -->
        <div class="flex flex-wrap gap-2 mb-8" id="change-filters">
          <button data-filter="all" class="change-filter-btn active rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 px-4 py-1.5 text-xs font-semibold transition-colors">
            All
          </button>
          <button data-filter="launch" class="change-filter-btn rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 px-4 py-1.5 text-xs font-semibold transition-colors hover:border-indigo-200 dark:hover:border-indigo-800">
            Launches
          </button>
          <button data-filter="price-change" class="change-filter-btn rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 px-4 py-1.5 text-xs font-semibold transition-colors hover:border-emerald-200 dark:hover:border-emerald-800">
            Pricing
          </button>
          <button data-filter="capability-change" class="change-filter-btn rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 px-4 py-1.5 text-xs font-semibold transition-colors hover:border-amber-200 dark:hover:border-amber-800">
            Capabilities
          </button>
        </div>

        <!-- Timeline entries -->
        <div class="space-y-4" id="changes-list">
          {changes.map((change, idx) => {
            const config = typeConfig[change.changeType] || typeConfig.launch;
            const formattedDate = new Date(change.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            const isMajor = change.magnitude === 'major';

            return (
              <article
                class:list={[
                  'change-entry rounded-[1.4rem] border bg-white dark:bg-zinc-900 transition-all',
                  isMajor ? 'border-zinc-200 dark:border-zinc-800 p-6 shadow-[var(--shadow-card)]' : 'border-zinc-200 dark:border-zinc-800 p-5',
                ]}
                data-change-type={change.changeType}
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-3">
                    <div class={`mt-1 w-2.5 h-2.5 rounded-full ${config.color} flex-shrink-0`}></div>
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <span class={`rounded-full border px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-wider ${config.bgColor}`}>
                          {config.label}
                        </span>
                        {isMajor && (
                          <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-[0.6rem] font-semibold text-zinc-500 dark:text-zinc-400">
                            Major
                          </span>
                        )}
                      </div>
                      <p class:list={[
                        'mt-2 text-zinc-950 dark:text-zinc-50',
                        isMajor ? 'text-lg font-semibold' : 'text-sm font-medium',
                      ]}>
                        {change.description}
                      </p>
                      {change.detail && (
                        <p class="mt-1 text-xs font-mono text-zinc-500 dark:text-zinc-400">
                          {change.detail}
                        </p>
                      )}
                      <a href={`/models/${change.slug}/`} class="mt-2 inline-flex text-xs font-semibold text-indigo-600 dark:text-indigo-400">
                        View model profile
                      </a>
                    </div>
                  </div>
                  <span class="text-xs text-zinc-400 dark:text-zinc-500 whitespace-nowrap">
                    {formattedDate}
                  </span>
                </div>
              </article>
            );
          })}

          {changes.length === 0 && (
            <div class="rounded-[1.4rem] border border-dashed border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-950/50 p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
              No recent changes detected in the catalog. Check back when the next model launches or pricing shifts.
            </div>
          )}
        </div>

        <!-- Mid-feed newsletter -->
        <div class="mt-10">
          <NewsletterSignup
            heading="Never miss a model change."
            subtitle="Weekly digest of launches, price drops, and capability upgrades across the AI model market."
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  function initChangeFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.change-filter-btn');
    const entries = document.querySelectorAll<HTMLElement>('.change-entry');

    if (buttons.length === 0 || entries.length === 0) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        // Update active state
        buttons.forEach((b) => {
          if (b === btn) {
            b.classList.add('active');
            b.classList.remove('bg-white', 'dark:bg-zinc-900', 'text-zinc-600', 'dark:text-zinc-400');
            b.classList.add('bg-zinc-900', 'dark:bg-white', 'text-white', 'dark:text-zinc-900');
          } else {
            b.classList.remove('active');
            b.classList.add('bg-white', 'dark:bg-zinc-900', 'text-zinc-600', 'dark:text-zinc-400');
            b.classList.remove('bg-zinc-900', 'dark:bg-white', 'text-white', 'dark:text-zinc-900');
          }
        });

        // Filter entries
        entries.forEach((entry) => {
          if (filter === 'all' || entry.dataset.changeType === filter) {
            entry.style.display = '';
          } else {
            entry.style.display = 'none';
          }
        });
      });
    });
  }

  initChangeFilters();
  document.addEventListener('astro:page-load', initChangeFilters);
</script>
