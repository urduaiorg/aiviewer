---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadingTime } from '../../utils/readingTime';
import AuthorBio from '../../components/content/AuthorBio.astro';
import NewsletterSignup from '../../components/content/NewsletterSignup.astro';
import ReadingProgress from '../../components/content/ReadingProgress.astro';
import RelatedContent from '../../components/content/RelatedContent.astro';
import ShareButtons from '../../components/content/ShareButtons.astro';
import { siteConfig, roleLabels, difficultyConfig } from '../../data/site.config';
import { slugifyTag } from '../../utils/slugifyTag';
import { shouldNoindexPath } from '../../utils/indexPolicy';

export async function getStaticPaths() {
  const playbooks = await getCollection('playbooks', ({ data }) => !data.draft);
  return playbooks.filter((entry) => !shouldNoindexPath(`/playbooks/${entry.id}/`)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedEntries = (await getCollection('playbooks', ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== entry.id && candidate.data.role === entry.data.role)
  .slice(0, 3);

// Parse FAQ headings into FAQSchema format
const faqs = [];
let inFaqSection = false;
let currentQuestion = '';

for (const heading of headings) {
  if (heading.depth === 2 && heading.text.toLowerCase().includes('frequently asked questions')) {
    inFaqSection = true;
    continue;
  }
  if (inFaqSection && heading.depth === 2) {
    break; // Hit a new H2 section, end of FAQs
  }
  if (inFaqSection && heading.depth === 3) {
    currentQuestion = heading.text;
    const questionRegex = new RegExp(`### ${currentQuestion}\\s*\\n+([^#]+)`, 'i');
    const match = entry.body?.match(questionRegex);
    if (match && match[1]) {
      faqs.push({
        question: currentQuestion,
        answer: match[1].trim()
      });
    }
  }
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  type="article"
  publishedDate={entry.data.publishedDate.toISOString()}
  updatedDate={entry.data.updatedDate?.toISOString()}
  noindex={shouldNoindexPath(Astro.url.pathname)}
>
  <ArticleSchema
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
  ogImage={entry.data.coverImage}
    image={entry.data.coverImage}
    publishedDate={entry.data.publishedDate}
    updatedDate={entry.data.updatedDate}
  />
  <BreadcrumbSchema
    slot="head"
    items={[
      { name: 'Home', url: '/' },
      { name: 'Playbooks', url: '/playbooks/' },
      { name: entry.data.title, url: `/playbooks/${entry.id}/` },
    ]}
  />
  {faqs.length > 0 && <FAQSchema slot="head" faqs={faqs} />}
  <Header />
  <ReadingProgress />

  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top,_rgba(79,70,229,0.12),_transparent_42%),linear-gradient(180deg,rgba(240,199,94,0.15),transparent_75%)] dark:bg-[radial-gradient(circle_at_top,_rgba(79,70,229,0.06),_transparent_42%),linear-gradient(180deg,rgba(240,199,94,0.07),transparent_75%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'Playbooks', href: '/playbooks/' }, { label: entry.data.title }]} />

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_19rem]">
        <div class="max-w-3xl" data-reveal>
          <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
              {roleLabels[entry.data.role] ?? entry.data.role}
            </span>
            <span>{formatDate(entry.data.publishedDate)}</span>
            {entry.data.updatedDate && entry.data.updatedDate.getTime() !== entry.data.publishedDate.getTime() && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-900/20 px-2.5 py-0.5 text-[0.7rem] font-medium text-emerald-700 dark:text-emerald-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                Updated {formatDate(entry.data.updatedDate)}
              </span>
            )}
            <span aria-hidden="true">·</span>
            <span>{getReadingTime(entry.body)}</span>
          </div>

          <h1 class="mt-5 max-w-3xl text-zinc-950 dark:text-zinc-50">{entry.data.title}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">{entry.data.description}</p>

          <div class="mt-5">
            <ShareButtons title={entry.data.title} url={`${siteConfig.url}${Astro.url.pathname}`} />
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">Difficulty</p>
              <p class="mt-2 text-base font-semibold capitalize text-zinc-950 dark:text-zinc-50">{entry.data.difficulty}</p>
            </div>
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">Time to complete</p>
              <p class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-50">{entry.data.timeToComplete}</p>
            </div>
            <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-5 py-4">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">Workflows</p>
              <p class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-50">{entry.data.workflows}</p>
            </div>
          </div>
        </div>

        <aside class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.14)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Tools used</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {entry.data.toolsUsed.map((tool) => (
              <span class="rounded-full bg-white/10 px-3 py-1.5 text-sm text-zinc-100">{tool}</span>
            ))}
          </div>
          <div class="mt-6 border-t border-white/10 pt-6">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Tags</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {entry.data.tags.map((tag) => (
                <a href={`/tags/${slugifyTag(tag)}/`} class="rounded-full border border-white/10 px-3 py-1 text-xs text-zinc-300 transition-colors hover:border-white/30 hover:text-white">{tag}</a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <div class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_16rem]">
        <article data-pagefind-body class="min-w-0 rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-6 py-8 shadow-[var(--shadow-card)] md:px-10 md:py-10">
          <div class="prose dark:prose-invert max-w-none prose-headings:scroll-mt-24">
            <Content />
          </div>
          <AuthorBio compact />
          <NewsletterSignup variant="inline" />
        </article>

        <TableOfContents headings={headings} label="Playbook outline" />
      </div>
    </div>
  </section>

  {relatedEntries.length > 0 && (
    <section class="border-t border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="page-container py-12 md:py-16">
        <div class="mb-8" data-reveal>
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Related</p>
          <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">More for {roleLabels[entry.data.role] ?? entry.data.role}.</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {relatedEntries.map((candidate) => (
            <a
              href={`/playbooks/${candidate.id}/`}
              class="group rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-400">{candidate.data.timeToComplete}</p>
              <h3 class="mt-3 text-xl text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">{candidate.data.title}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{candidate.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <RelatedContent
    currentCollection="playbooks"
    currentId={entry.id}
    tags={entry.data.tags}
    toolsUsed={entry.data.toolsUsed}
  />

  <Footer />
</BaseLayout>
