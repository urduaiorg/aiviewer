---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import TableOfContents from '../../components/content/TableOfContents.astro';
import ArticleSchema from '../../components/seo/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';
import AuthorBio from '../../components/content/AuthorBio.astro';
import NewsletterSignup from '../../components/content/NewsletterSignup.astro';
import ReadingProgress from '../../components/content/ReadingProgress.astro';
import RelatedContent from '../../components/content/RelatedContent.astro';
import ShareButtons from '../../components/content/ShareButtons.astro';
import { formatDate } from '../../utils/formatDate';
import { getReadingTime } from '../../utils/readingTime';
import { siteConfig } from '../../data/site.config';
import { slugifyTag } from '../../utils/slugifyTag';
import { shouldNoindexPath } from '../../utils/indexPolicy';

export async function getStaticPaths() {
  const entries = await getCollection('reports', ({ data }) => !data.draft);
  return entries.filter((entry) => !shouldNoindexPath(`/reports/${entry.id}/`)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedEntries = (await getCollection('reports', ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== entry.id)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);

// Parse FAQ headings into FAQSchema format
const faqs = [];
let inFaqSection = false;
let currentQuestion = '';

for (const heading of headings) {
  if (heading.depth === 2 && heading.text.toLowerCase().includes('frequently asked questions')) {
    inFaqSection = true;
    continue;
  }
  if (inFaqSection && heading.depth === 2) {
    break; // Hit a new H2 section, end of FAQs
  }
  if (inFaqSection && heading.depth === 3) {
    currentQuestion = heading.text;
    const questionRegex = new RegExp(`### ${currentQuestion}\\s*\\n+([^#]+)`, 'i');
    const match = entry.body?.match(questionRegex);
    if (match && match[1]) {
      faqs.push({
        question: currentQuestion,
        answer: match[1].trim()
      });
    }
  }
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  type="article"
  publishedDate={entry.data.publishedDate.toISOString()}
  updatedDate={entry.data.updatedDate?.toISOString()}
  noindex={shouldNoindexPath(Astro.url.pathname)}
>
  <ArticleSchema
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
  ogImage={entry.data.coverImage}
    image={entry.data.coverImage}
    publishedDate={entry.data.publishedDate}
    updatedDate={entry.data.updatedDate}
  />
  <BreadcrumbSchema
    slot="head"
    items={[
      { name: 'Home', url: '/' },
      { name: 'AI & Society', url: '/reports/' },
      { name: entry.data.title, url: `/reports/${entry.id}/` },
    ]}
  />
  {faqs.length > 0 && <FAQSchema slot="head" faqs={faqs} />}
  <Header />
  <ReadingProgress />

  <!-- Hero section -->
  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top,_rgba(240,199,94,0.16),_transparent_40%),linear-gradient(180deg,rgba(79,70,229,0.08),transparent_75%)] dark:bg-[radial-gradient(circle_at_top,_rgba(240,199,94,0.07),_transparent_40%),linear-gradient(180deg,rgba(79,70,229,0.05),transparent_75%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'AI & Society', href: '/reports/' }, { label: entry.data.title }]} />

      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
          <span class="rounded-full bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
            {entry.data.source} &middot; {entry.data.reportYear}
          </span>
          <span>{formatDate(entry.data.publishedDate)}</span>
          {entry.data.updatedDate && entry.data.updatedDate.getTime() !== entry.data.publishedDate.getTime() && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-900/20 px-2.5 py-0.5 text-[0.7rem] font-medium text-emerald-700 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
              Updated {formatDate(entry.data.updatedDate)}
            </span>
          )}
          <span aria-hidden="true">&middot;</span>
          <span>{getReadingTime(entry.body)}</span>
        </div>

        <h1 class="mt-5 max-w-3xl text-zinc-950 dark:text-zinc-50">{entry.data.title}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">{entry.data.description}</p>

        <div class="mt-8 flex flex-wrap gap-2">
          {entry.data.tags.map((tag) => (
            <a href={`/tags/${slugifyTag(tag)}/`} class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-3 py-1 text-sm text-zinc-600 dark:text-zinc-300 transition-colors hover:border-indigo-200 dark:hover:border-indigo-700 hover:text-indigo-600 dark:hover:text-indigo-400">{tag}</a>
          ))}
        </div>

        <div class="mt-5">
          <ShareButtons title={entry.data.title} url={`${siteConfig.url}${Astro.url.pathname}`} />
        </div>
      </div>
    </div>
  </section>

  <!-- Key Insights -->
  {entry.data.keyInsights.length > 0 && (
    <section class="border-b border-zinc-200/70 dark:border-zinc-800 bg-[linear-gradient(180deg,#fff,rgba(244,244,245,0.75))] dark:bg-[linear-gradient(180deg,var(--color-bg),rgba(24,24,27,0.75))]">
      <div class="page-container py-10 md:py-12" data-reveal>
        <div class="rounded-[1.75rem] border border-amber-200/80 dark:border-[#F0C75E]/20 bg-amber-50/60 dark:bg-[#F0C75E]/[0.06] px-6 py-7 shadow-[var(--shadow-card)] md:px-8 md:py-8">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#F0C75E]/20 dark:bg-[#F0C75E]/10">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-[#F0C75E]">
                <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" />
              </svg>
            </div>
            <h2 class="text-lg font-bold text-zinc-950 dark:text-zinc-50">Key Insights</h2>
          </div>
          <ul class="space-y-3">
            {entry.data.keyInsights.map((insight) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 block h-1.5 w-1.5 shrink-0 rounded-full bg-[#F0C75E]" aria-hidden="true"></span>
                <span class="text-[0.95rem] leading-7 text-zinc-700 dark:text-zinc-300 font-medium">{insight}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 border-t border-amber-200/50 dark:border-[#F0C75E]/10 pt-5">
            <a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400 transition-colors hover:text-indigo-700 dark:hover:text-indigo-300">
              View original source
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5z" clip-rule="evenodd" />
                <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 001.06.053L16.5 4.44v2.81a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.553l-9.056 8.194a.75.75 0 00-.053 1.06z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Article content with TOC sidebar -->
  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <div class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_16rem]">
        <article data-pagefind-body class="min-w-0 rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-6 py-8 shadow-[var(--shadow-card)] md:px-10 md:py-10">
          <div class="prose dark:prose-invert max-w-none prose-headings:scroll-mt-24">
            <Content />
          </div>
          <AuthorBio compact />
          <NewsletterSignup variant="inline" />
        </article>

        <TableOfContents headings={headings} label="Report outline" />
      </div>
    </div>
  </section>

  <!-- Related reports -->
  {relatedEntries.length > 0 && (
    <section class="border-t border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
      <div class="page-container py-12 md:py-16">
        <div class="mb-8" data-reveal>
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Continue reading</p>
          <h2 class="mt-2 text-zinc-950 dark:text-zinc-50">More research &amp; analysis.</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {relatedEntries.map((candidate) => (
            <a
              href={`/reports/${candidate.id}/`}
              class="group rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
              data-reveal
            >
              <div class="flex items-center gap-2">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-400">{candidate.data.source}</p>
                <span class="text-xs text-zinc-300 dark:text-zinc-600" aria-hidden="true">&middot;</span>
                <p class="text-xs text-zinc-400">{candidate.data.reportYear}</p>
              </div>
              <h3 class="mt-3 text-xl text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">{candidate.data.title}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{candidate.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <RelatedContent
    currentCollection="reports"
    currentId={entry.id}
    tags={entry.data.tags}
  />

  <Footer />
</BaseLayout>
