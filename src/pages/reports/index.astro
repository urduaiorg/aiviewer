---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import CollectionSchema from '../../components/seo/CollectionSchema.astro';
import { formatDateShort } from '../../utils/formatDate';
import { slugifyTag } from '../../utils/slugifyTag';

const reports = (await getCollection('reports', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const uniqueSources = [...new Set(reports.map((r) => r.data.source))];
const sources = [...new Set(reports.map((r) => r.data.source))];
---

<BaseLayout
  title="AI & Society"
  description="How AI reshapes work, education, health, and culture — research-backed analysis distilled into clear insights you can act on."
>
  <Fragment slot="head">
    <CollectionSchema
      name="AI & Society"
      description="How AI reshapes work, education, health, and culture — research-backed analysis distilled into clear insights you can act on."
      url="/reports/"
      numberOfItems={reports.length}
    />
  </Fragment>
  <Header />

  <section class="relative overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.22),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.12),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_42%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: 'AI & Society' }]} />

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end" data-reveal>
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-600 dark:text-zinc-400">
            AI & Society
          </span>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">How AI is reshaping the world around us.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
            Research-backed analysis on AI's impact across work, education, health, and culture — distilled into insights you can actually use.
          </p>
        </div>

        <div class="rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.14)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Coverage</p>
          <div class="mt-5 grid grid-cols-2 gap-4">
            <div>
              <div class="text-3xl font-bold">{reports.length}</div>
              <p class="mt-1 text-sm text-zinc-400">Analysis pieces</p>
            </div>
            <div>
              <div class="text-3xl font-bold text-[#F0C75E]">{uniqueSources.length}</div>
              <p class="mt-1 text-sm text-zinc-400">Unique sources</p>
            </div>
          </div>
        </div>
      </div>

      {sources.length > 1 && (
        <nav class="mt-10 flex flex-wrap gap-2" data-filter-controls aria-label="Source filters">
          <button class="rounded-full border border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 px-4 py-2 text-sm font-semibold text-indigo-700 dark:text-indigo-300" data-filter="all">
            All sources
          </button>
          {sources.map((source) => (
            <button class="rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-400 transition-colors hover:border-indigo-200 hover:text-indigo-600" data-filter={source}>
              {source}
            </button>
          ))}
        </nav>
      )}
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      {reports.length === 0 ? (
        <div class="rounded-[1.75rem] border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-8 py-16 text-center">
          <h2 class="text-zinc-950 dark:text-zinc-50">No reports published yet.</h2>
          <p class="mt-3 text-zinc-500 dark:text-zinc-400">Add Markdown or MDX files to `src/content/reports` and this library will populate automatically.</p>
        </div>
      ) : (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-report-grid>
          {reports.map((entry) => (
            <a
              href={`/reports/${entry.id}/`}
              class="report-card card-glow group flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)]"
              data-source={entry.data.source}
              data-reveal
            >
              {/* Report header band */}
              <div class="border-b border-zinc-200 dark:border-zinc-800 bg-gradient-to-br from-zinc-50 via-white to-zinc-50 dark:from-zinc-900 dark:via-zinc-800/50 dark:to-zinc-900 px-6 py-5">
                <div class="flex items-center justify-between gap-3">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 dark:bg-indigo-900/30 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-indigo-600 dark:text-indigo-400">
                    {entry.data.source}
                  </span>
                  <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">
                    {entry.data.reportYear}
                  </span>
                </div>
                {/* Decorative chart icon */}
                <div class="mt-4 flex items-end gap-1">
                  <div class="h-6 w-2 rounded-sm bg-[#F0C75E]/30 dark:bg-[#F0C75E]/20"></div>
                  <div class="h-10 w-2 rounded-sm bg-[#F0C75E]/50 dark:bg-[#F0C75E]/30"></div>
                  <div class="h-8 w-2 rounded-sm bg-[#F0C75E]/40 dark:bg-[#F0C75E]/25"></div>
                  <div class="h-14 w-2 rounded-sm bg-[#F0C75E]/70 dark:bg-[#F0C75E]/50"></div>
                  <div class="h-11 w-2 rounded-sm bg-[#F0C75E]/55 dark:bg-[#F0C75E]/35"></div>
                  <div class="h-16 w-2 rounded-sm bg-[#F0C75E] dark:bg-[#F0C75E]/70"></div>
                </div>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-[1.3rem] leading-snug text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {entry.data.title}
                </h3>
                <p class="mt-3 flex-1 text-[0.95rem] leading-7 text-zinc-600 dark:text-zinc-400">
                  {entry.data.description}
                </p>

                {/* Key insights preview */}
                {entry.data.keyInsights.length > 0 && (
                  <ul class="mt-5 space-y-2 border-t border-zinc-100 dark:border-zinc-800 pt-5">
                    {entry.data.keyInsights.slice(0, 2).map((insight) => (
                      <li class="flex items-start gap-2.5 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                        <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-[#F0C75E]" aria-hidden="true"></span>
                        {insight}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-5 flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 pt-5">
                  <div class="flex flex-wrap gap-2">
                    {entry.data.tags.slice(0, 2).map((tag) => (
                      <span class="rounded-full border border-zinc-200 dark:border-zinc-700 px-2.5 py-1 text-xs text-zinc-500 dark:text-zinc-400">{tag}</span>
                    ))}
                  </div>
                  <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400">Read summary</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <script>
    const controls = document.querySelector('[data-filter-controls]');
    const grid = document.querySelector('[data-report-grid]');
    if (controls && grid) {
      const buttons = Array.from(controls.querySelectorAll('button[data-filter]'));
      const cards = Array.from(grid.querySelectorAll('.report-card'));

      const setFilter = (value: string) => {
        buttons.forEach((button) => {
          const active = (button as HTMLElement).dataset.filter === value;
          if (active) {
            button.className = 'rounded-full border border-indigo-200 dark:border-indigo-700 bg-indigo-50 dark:bg-indigo-900/30 px-4 py-2 text-sm font-semibold text-indigo-700 dark:text-indigo-300';
          } else {
            button.className = 'rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-400 transition-colors hover:border-indigo-200 hover:text-indigo-600';
          }
        });

        cards.forEach((card) => {
          const matches = value === 'all' || (card as HTMLElement).dataset.source === value;
          card.toggleAttribute('hidden', !matches);
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => setFilter((button as HTMLElement).dataset.filter ?? 'all'));
      });
    }
  </script>

  <Footer />
</BaseLayout>
