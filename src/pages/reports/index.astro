---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const reports = await getCollection('reports', ({ data }) => !data.draft);

// Sort by date descending
reports.sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
---

<BaseLayout 
  title="AI Industry Reports & Insights | AIViewer"
  description="Deep-dive reports, statistics, and trends in the artificial intelligence industry."
>
  <div class="page-container py-12 lg:py-20">
    <header class="max-w-3xl mb-12">
      <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-zinc-900 dark:text-white mb-4">Industry Reports</h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400">Data-driven insights and deep dives into how AI is transforming every sector.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {reports.map((report) => (
        <a href={`/reports/${report.id}/`} class="group flex flex-col h-full bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden hover:shadow-lg transition-all duration-300">
          <div class="aspect-video w-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden relative">
            <div class="absolute inset-0 flex items-center justify-center text-zinc-400 dark:text-zinc-600 group-hover:scale-105 transition-transform duration-500">
               {/* Fallback image placeholder since we don't have actual images yet */}
               <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
               </svg>
            </div>
            <div class="absolute top-4 right-4 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-zinc-900 dark:text-white">
              {report.data.reportYear}
            </div>
          </div>
          
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">{report.data.source}</span>
            </div>
            <h2 class="text-xl font-bold text-zinc-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {report.data.title}
            </h2>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-3 mb-6 flex-grow">
              {report.data.description}
            </p>
            <div class="mt-auto flex items-center text-sm font-medium text-indigo-600 dark:text-indigo-400">
              Read Report <span aria-hidden="true" class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
