---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout
  title="404: Page Not Found"
  description="The page you're looking for doesn't exist or has been moved."
  noindex={true}
>
  <Header slot="header" />

  <section class="relative overflow-hidden bg-white dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top,_rgba(240,199,94,0.12),_transparent_50%)] dark:bg-[radial-gradient(circle_at_top,_rgba(240,199,94,0.06),_transparent_50%)]"></div>
    <div class="page-container relative min-h-[65vh] flex flex-col items-center justify-center text-center py-20">

      <!-- Decorative 404 glyph -->
      <div class="relative mb-8 w-full max-w-md overflow-hidden" data-reveal>
        <div class="text-[10rem] md:text-[14rem] font-extrabold leading-none tracking-tighter text-zinc-100 dark:text-zinc-800/60 select-none text-center" aria-hidden="true">404</div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="flex h-20 w-20 items-center justify-center rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-[var(--shadow-card)]">
            <svg class="h-10 w-10 text-[#F0C75E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 16.318A4.486 4.486 0 0012.016 15a4.486 4.486 0 00-3.198 1.318M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />
            </svg>
          </div>
        </div>
      </div>

      <div data-reveal>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 mb-4">This page wandered off.</h1>
        <p class="text-lg leading-8 text-zinc-600 dark:text-zinc-400 max-w-lg mx-auto mb-10">
          The URL might be incorrect, or the page may have been moved. Let's get you back to useful AI content.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4" data-reveal>
        <a href="/" class="inline-flex items-center justify-center gap-2 rounded-full bg-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-indigo-600/20 transition-colors hover:bg-indigo-700 active:scale-[0.97]">
          Back to homepage
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="/tools/" class="inline-flex items-center justify-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-6 py-3 text-base font-semibold text-zinc-700 dark:text-zinc-300 transition-colors hover:border-indigo-200 hover:text-indigo-600 dark:hover:text-indigo-400">
          Browse AI tools
        </a>
      </div>

      <!-- Quick nav cards -->
      <div class="mt-16 grid gap-4 sm:grid-cols-3 max-w-2xl w-full" data-reveal>
        <a href="/playbooks/" class="group rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)] text-left">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-zinc-400">Playbooks</p>
          <p class="mt-2 text-sm font-medium text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">Role-based workflows</p>
        </a>
        <a href="/guides/" class="group rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)] text-left">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-zinc-400">Guides</p>
          <p class="mt-2 text-sm font-medium text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">AI explainers</p>
        </a>
        <a href="/prompts/" class="group rounded-[var(--radius-lg)] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)] text-left">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-zinc-400">Prompts</p>
          <p class="mt-2 text-sm font-medium text-zinc-950 dark:text-zinc-50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400">Copy-paste library</p>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
