---
interface Props {
  youtubeId: string;
  title: string;
  creatorName: string;
  creatorUrl?: string;
  poster?: string;
}

const { youtubeId, title, creatorName, creatorUrl, poster } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=0&playsinline=1&rel=0`;
const localPoster = poster?.startsWith('/') ? poster : undefined;
---

<section class="not-prose mb-9" aria-labelledby={`video-title-${youtubeId}`}>
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id={`video-title-${youtubeId}`} class="text-xl font-semibold text-zinc-950 dark:text-zinc-50">
        Source video
      </h2>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
        By{' '}
        {creatorUrl ? (
          <a
            href={creatorUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-indigo-700 hover:text-indigo-900 dark:text-indigo-300 dark:hover:text-indigo-100"
          >
            {creatorName}
          </a>
        ) : (
          <span class="font-medium text-zinc-800 dark:text-zinc-200">{creatorName}</span>
        )}
      </p>
    </div>
    <a
      href={watchUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-indigo-700 underline decoration-indigo-300 underline-offset-4 hover:text-indigo-900 dark:text-indigo-300 dark:decoration-indigo-700 dark:hover:text-indigo-100"
    >
      Watch on YouTube
    </a>
  </div>

  <div
    class="relative aspect-video overflow-hidden rounded-[1.25rem] border border-zinc-200 bg-zinc-950 shadow-[var(--shadow-card)] dark:border-zinc-800"
    data-privacy-video
    data-embed-url={embedUrl}
    data-video-title={title}
  >
    {localPoster && (
      <img
        src={localPoster}
        alt=""
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover opacity-35"
      />
    )}
    <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(9,9,11,0.5),rgba(9,9,11,0.9))]" aria-hidden="true"></div>
    <div class="relative flex h-full items-center justify-center p-6 text-center">
      <button
        type="button"
        data-load-video
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-zinc-950 shadow-lg transition-transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-4 focus:ring-offset-zinc-950"
      >
        Load video player
      </button>
    </div>
    <noscript>
      <p class="absolute inset-x-4 bottom-4 rounded-lg bg-zinc-950/90 p-3 text-center text-sm text-white">
        JavaScript is required for the privacy-enhanced player. <a href={watchUrl} class="underline">Watch on YouTube</a>.
      </p>
    </noscript>
  </div>

  <p class="mt-3 text-xs leading-5 text-zinc-500 dark:text-zinc-400">
    The YouTube player is not contacted until you load it. Loading the player shares data with YouTube.
    The creator owns the source video; AIViewer provides the surrounding lesson and does not claim ownership.
    Playback never starts automatically.
  </p>
</section>

<script>
  function initializePrivacyVideoEmbeds() {
    document.querySelectorAll<HTMLElement>('[data-privacy-video]').forEach((container) => {
      const button = container.querySelector<HTMLButtonElement>('[data-load-video]');
      if (!button || button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';

      button.addEventListener('click', () => {
        const embedUrl = container.dataset.embedUrl;
        if (!embedUrl) return;

        const iframe = document.createElement('iframe');
        iframe.src = embedUrl;
        iframe.title = container.dataset.videoTitle ?? 'YouTube video player';
        iframe.className = 'absolute inset-0 h-full w-full';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allow = 'accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;

        container.replaceChildren(iframe);
      }, { once: true });
    });
  }

  initializePrivacyVideoEmbeds();
  document.addEventListener('astro:page-load', initializePrivacyVideoEmbeds);
</script>
