---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import type { UseCase } from '../../data/useCases';
import { shouldNoindexPath } from '../../utils/indexPolicy';

interface Props {
  useCase: UseCase;
}

const { useCase } = Astro.props;
const pageTitle = useCase.title;
const featuredLinks = useCase.featuredLinks.filter((link) => !shouldNoindexPath(link.href));
const toolLinks = useCase.toolLinks.filter((link) => !shouldNoindexPath(link.href));
const fallbackPrimary = featuredLinks[0]
  ? { label: `Start with ${featuredLinks[0].label}`, href: featuredLinks[0].href }
  : { label: 'Browse editorial guides', href: '/guides/' };
const primaryCta = shouldNoindexPath(useCase.primaryCta.href) ? fallbackPrimary : useCase.primaryCta;
const secondaryCta = shouldNoindexPath(useCase.secondaryCta.href)
  ? { label: 'Browse evaluated tools', href: '/tools/' }
  : useCase.secondaryCta;
---

<BaseLayout title={pageTitle} description={useCase.description} noindex={shouldNoindexPath(Astro.url.pathname)}>
  <Header />

  <section class="relative overflow-hidden border-b border-zinc-200/70 bg-white dark:border-zinc-800 dark:bg-[var(--color-bg)]">
    <div class="absolute inset-x-0 top-0 h-80 bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.22),_transparent_38%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.12),_transparent_38%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(240,199,94,0.08),_transparent_38%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.06),_transparent_38%)]"></div>
    <div class="page-container relative py-12 md:py-16">
      <Breadcrumbs items={[{ label: useCase.navLabel }]} />

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end" data-reveal>
        <div class="max-w-3xl">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Use AI for real work</p>
          <h1 class="mt-5 text-zinc-950 dark:text-zinc-50">{useCase.title}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">{useCase.description}</p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={primaryCta.href} class="inline-flex items-center justify-center rounded-xl bg-zinc-950 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-100">
              {primaryCta.label}
            </a>
            <a href={secondaryCta.href} class="inline-flex items-center justify-center rounded-xl border border-zinc-200 bg-white px-5 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:border-indigo-200 hover:text-indigo-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-indigo-700">
              {secondaryCta.label}
            </a>
          </div>
        </div>

        <aside class="rounded-[var(--radius-lg)] border border-zinc-200 bg-zinc-950 p-6 text-white shadow-[0_24px_80px_rgba(9,9,11,0.16)] dark:border-zinc-800">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400">Plain-English promise</p>
          <p class="mt-4 text-xl font-semibold leading-8 text-white">{useCase.promise}</p>
          <div class="mt-6 border-t border-white/10 pt-5">
            <p class="text-sm font-semibold text-[#F0C75E]">Built for</p>
            <p class="mt-2 text-sm leading-6 text-zinc-300">{useCase.audience}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)]">
    <div class="page-container grid gap-6 py-12 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:py-16">
      <div class="rounded-[var(--radius-lg)] border border-zinc-200 bg-white p-6 shadow-[var(--shadow-card)] dark:border-zinc-800 dark:bg-zinc-900" data-reveal>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-400">Quick wins</p>
        <h2 class="mt-3 text-zinc-950 dark:text-zinc-50">Start with one useful task.</h2>
        <ul class="mt-5 space-y-3">
          {useCase.quickWins.map((win) => (
            <li class="flex gap-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
              <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-emerald-500"></span>
              <span>{win}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-[var(--radius-lg)] border border-zinc-200 bg-white p-6 shadow-[var(--shadow-card)] dark:border-zinc-800 dark:bg-zinc-900" data-reveal data-reveal-delay="80">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-amber-600 dark:text-amber-400">Copy-paste prompts</p>
        <h2 class="mt-3 text-zinc-950 dark:text-zinc-50">Use these as your first test.</h2>
        <div class="mt-5 space-y-3">
          {useCase.starterPrompts.map((prompt) => (
            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 text-sm leading-6 text-zinc-700 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-300">
              "{prompt}"
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-zinc-200/70 bg-white dark:border-zinc-800 dark:bg-[var(--color-bg)]">
    <div class="page-container py-12 md:py-16">
      <div class="max-w-2xl" data-reveal>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Recommended path</p>
        <h2 class="mt-3 text-zinc-950 dark:text-zinc-50">Read this first, then pick a tool.</h2>
        <p class="mt-3 text-zinc-600 dark:text-zinc-400">These pages are curated for this use case so new visitors do not have to search the whole site.</p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {featuredLinks.map((link) => (
          <a href={link.href} class="group flex h-full flex-col rounded-[var(--radius-lg)] border border-zinc-200 bg-zinc-50 p-5 transition-colors hover:border-indigo-200 hover:bg-indigo-50 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-indigo-700 dark:hover:bg-indigo-900/20" data-reveal>
            <span class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">{link.type}</span>
            <h3 class="mt-3 text-[1.05rem] text-zinc-950 group-hover:text-indigo-600 dark:text-zinc-50 dark:group-hover:text-indigo-400">{link.label}</h3>
            <p class="mt-3 flex-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{link.summary}</p>
            <span class="mt-5 text-sm font-semibold text-indigo-600 dark:text-indigo-400">Open page</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-zinc-200/70 bg-[var(--color-bg)] dark:border-zinc-800">
    <div class="page-container py-12 md:py-16">
      <div class="max-w-2xl" data-reveal>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">Tool shortlist</p>
        <h2 class="mt-3 text-zinc-950 dark:text-zinc-50">Good tools to compare for this job.</h2>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {toolLinks.map((link) => (
          <a href={link.href} class="group rounded-[var(--radius-lg)] border border-zinc-200 bg-white p-5 shadow-[var(--shadow-card)] transition-card hover:border-indigo-200 hover:shadow-[var(--shadow-card-hover)] dark:border-zinc-800 dark:bg-zinc-900" data-reveal>
            <span class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-zinc-400">{link.type}</span>
            <h3 class="mt-3 text-[1.1rem] text-zinc-950 group-hover:text-indigo-600 dark:text-zinc-50 dark:group-hover:text-indigo-400">{link.label}</h3>
            <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{link.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="page-container py-12 md:py-16">
    <NewsletterSignup variant="inline" />
  </section>

  <Footer />
</BaseLayout>
