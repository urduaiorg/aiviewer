---
/**
 * EditorialCover — Parametric SVG Cover System
 *
 * Zero photos. Pure geometry. Every cover deterministically unique.
 * Inspired by Anthropic, OpenAI, and Apple editorial aesthetics.
 *
 * Architecture (5 layers):
 *   1. Rich dark gradient (category-tinted)
 *   2. Atmospheric glow spots (soft radials)
 *   3. Geometric shapes (variant-specific collection DNA)
 *   4. Bottom vignette (text readability)
 *   5. Badge + title panel (communication)
 *
 * Collection DNA:
 *   Tools     → Dashboard panels (floating rounded rects, gauge circles)
 *   Playbooks → Workflow paths (bezier curves, connected nodes)
 *   Guides    → Editorial rules (horizontal lines, decorative circles)
 *
 * Every title produces a unique composition via deterministic hashing.
 * Same title → same cover. Different title → different cover.
 */

interface Props {
  title: string;
  subtitle?: string;
  category?: string;
  image?: string;
  variant?: 'playbook' | 'tool' | 'guide';
  badge?: string;
  compact?: boolean;
  layout?: 'panel' | 'frame' | 'split' | 'hero';
  showTitle?: boolean;
}

const {
  title,
  subtitle = '',
  category = 'general',
  image: _coverImage, // Backward compat — no longer rendered
  variant = 'guide',
  badge = 'AIViewer.ai',
  compact = false,
  layout = 'panel',
  showTitle = true,
} = Astro.props;

/* ── Deterministic hash from title string ──────────── */
function hash(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}

const H = hash(title);
const pick = (bit: number, range: number) => ((H >>> bit) % range);

/* ── Category color palette ────────────────────────── */
/* Every category gets a rich, deep gradient + accent.  */
/* All backgrounds are dark — works in both themes.     */
const palettes: Record<string, { from: string; to: string; accent: string }> = {
  writing:      { from: '#1e1b4b', to: '#0c0a1e', accent: '#818CF8' },
  design:       { from: '#3b1030', to: '#1a0815', accent: '#F472B6' },
  research:     { from: '#0a3049', to: '#051a29', accent: '#22D3EE' },
  coding:       { from: '#06301a', to: '#021a0c', accent: '#34D399' },
  video:        { from: '#2e1065', to: '#180838', accent: '#A78BFA' },
  audio:        { from: '#451a1a', to: '#200d0d', accent: '#FB7185' },
  productivity: { from: '#422006', to: '#261304', accent: '#FBBF24' },
  education:    { from: '#0c2c4f', to: '#061729', accent: '#38BDF8' },
  data:         { from: '#0f3d3d', to: '#072020', accent: '#2DD4BF' },
  business:     { from: '#1e293b', to: '#0f172a', accent: '#94A3B8' },
  translation:  { from: '#172554', to: '#0c1437', accent: '#60A5FA' },
  presentation: { from: '#3b0764', to: '#1e0538', accent: '#C084FC' },
  agriculture:  { from: '#14532d', to: '#0a2e18', accent: '#4ADE80' },
  healthcare:   { from: '#134e4a', to: '#0a2f2c', accent: '#2DD4BF' },
  government:   { from: '#1e293b', to: '#0f172a', accent: '#94A3B8' },
  language:     { from: '#1e3a5f', to: '#0c1e33', accent: '#60A5FA' },
  technology:   { from: '#1e1b4b', to: '#0c2d3e', accent: '#818CF8' },
  general:      { from: '#1c1836', to: '#09090b', accent: '#818CF8' },
};

const C = palettes[category] ?? palettes.general;
const GOLD = '#F0C75E';

/* ── Seeded composition parameters ─────────────────── */
const angle = 125 + pick(0, 40);        // Gradient angle: 125°–165°
const g1x = 10 + pick(3, 25);           // Glow spot 1 X%
const g1y = 8 + pick(5, 22);            // Glow spot 1 Y%
const g2x = 58 + pick(7, 30);           // Glow spot 2 X%
const g2y = 52 + pick(9, 35);           // Glow spot 2 Y%

/* ── TOOLS — Dashboard panel geometry ──────────────── */
/* Large floating panel + smaller panel + gauge circle  */
const t = {
  // Large panel — top-right area, partially bleeds off edge
  px: 660 + pick(2, 280),  py: -40 + pick(4, 100),
  pw: 300 + pick(6, 120),  ph: 320 + pick(8, 110),
  pr: 26 + pick(10, 12),
  // Smaller panel — left-center area
  sx: 50 + pick(12, 150),  sy: 170 + pick(14, 130),
  sw: 145 + pick(16, 85),  sh: 175 + pick(18, 80),
  // Accent circles — center area
  cx: 440 + pick(20, 260),  cy: 210 + pick(22, 190),
  cr: 55 + pick(24, 50),
  // Bottom accent line
  lx: 280 + pick(26, 220),  ly: 555 + pick(28, 35),
};

/* ── PLAYBOOKS — Workflow path geometry ────────────── */
/* Flowing bezier curve with connected step nodes       */
const pb = {
  // Main curve control points
  sx: 50 + pick(2, 60),    sy: 360 + pick(4, 90),
  c1x: 300 + pick(6, 130), c1y: 100 + pick(8, 110),
  c2x: 700 + pick(10, 140),c2y: 310 + pick(12, 90),
  ex: 1120 + pick(14, 60),  ey: 140 + pick(16, 110),
  // Node radii
  n1: 10 + pick(18, 5),  n2: 8 + pick(20, 4),
  n3: 10 + pick(22, 5),  n4: 12 + pick(24, 6),
  // Secondary path vertical offset
  dy: 85 + pick(26, 60),
};
const pbPath = `M${pb.sx} ${pb.sy} C${pb.c1x} ${pb.c1y}, ${pb.c2x} ${pb.c2y}, ${pb.ex} ${pb.ey}`;
const pbM1x = (pb.sx + pb.c1x) / 2;
const pbM1y = (pb.sy + pb.c1y) / 2;
const pbM2x = (pb.c1x + pb.c2x) / 2;
const pbM2y = (pb.c1y + pb.c2y) / 2;

/* ── GUIDES — Editorial typography geometry ────────── */
/* Horizontal rules + large decorative circle           */
const g = {
  lx: 100 + pick(2, 50),
  l1y: 140 + pick(4, 30),   l1w: 500 + pick(6, 280),
  l2y: 220 + pick(8, 20),   l2w: 340 + pick(10, 240),
  l3y: 300 + pick(12, 20),  l3w: 600 + pick(14, 280),
  l4y: 380 + pick(16, 20),  l4w: 250 + pick(18, 210),
  // Large decorative circle — right side
  cx: 890 + pick(20, 180),  cy: 230 + pick(22, 110),
  cr: 100 + pick(24, 60),   ir: 38 + pick(26, 22),
};

/* ── Layout sizing ─────────────────────────────────── */
const heightClass = compact ? 'aspect-[16/10]' : 'aspect-[16/8]';
const titleSize = compact
  ? 'text-[1rem] sm:text-[1.15rem]'
  : 'text-[1.2rem] sm:text-[1.5rem]';
const copyWidth = compact ? 'max-w-[14rem]' : 'max-w-[21rem]';
---

<div class:list={['editorial-cover relative isolate overflow-hidden select-none', heightClass]}>

  {/* ── Layer 1: Background gradient ─────────────── */}
  <div
    class="absolute inset-0"
    style={`background: linear-gradient(${angle}deg, ${C.from} 0%, ${C.to} 100%);`}
  ></div>

  {/* ── Layer 2: Atmospheric glow spots ──────────── */}
  <div
    class="absolute inset-0"
    style={`background: radial-gradient(ellipse at ${g1x}% ${g1y}%, ${C.accent}28, transparent 50%), radial-gradient(ellipse at ${g2x}% ${g2y}%, ${GOLD}1a, transparent 45%);`}
  ></div>

  {/* ── Layer 3: Geometric shapes (collection DNA) ── */}
  <svg
    viewBox="0 0 1200 630"
    aria-hidden="true"
    class="absolute inset-0 h-full w-full"
    preserveAspectRatio="none"
  >
    {/* ─── Tools: Dashboard panels ─── */}
    {variant === 'tool' && (
      <>
        {/* Large floating panel */}
        <rect
          x={t.px} y={t.py} width={t.pw} height={t.ph} rx={t.pr}
          fill="white" fill-opacity="0.07"
        />
        {/* Panel toolbar line */}
        <rect
          x={t.px + 24} y={t.py + 28} width={t.pw - 48} height="2.5" rx="1.25"
          fill="white" fill-opacity="0.1"
        />
        {/* Smaller secondary panel */}
        <rect
          x={t.sx} y={t.sy} width={t.sw} height={t.sh} rx={t.pr - 6}
          fill={C.accent} fill-opacity="0.09"
        />
        {/* Gauge circle — outer */}
        <circle
          cx={t.cx} cy={t.cy} r={t.cr}
          fill={GOLD} fill-opacity="0.1"
        />
        {/* Gauge circle — inner */}
        <circle
          cx={t.cx} cy={t.cy} r={t.cr * 0.42}
          fill={C.accent} fill-opacity="0.14"
        />
        {/* Bottom accent line */}
        <line
          x1="80" y1={t.ly} x2={t.lx} y2={t.ly}
          stroke="white" stroke-opacity="0.07" stroke-width="1.5"
        />
      </>
    )}

    {/* ─── Playbooks: Workflow paths ─── */}
    {variant === 'playbook' && (
      <>
        {/* Main flow path */}
        <path
          d={pbPath}
          fill="none" stroke={GOLD} stroke-opacity="0.24"
          stroke-width="2.5" stroke-linecap="round"
        />
        {/* Secondary dashed path */}
        <path
          d={`M${pb.sx + 20} ${pb.sy + pb.dy} C${pb.c1x + 30} ${pb.c1y + pb.dy}, ${pb.c2x - 20} ${pb.c2y + pb.dy * 0.6}, ${pb.ex - 30} ${pb.ey + pb.dy}`}
          fill="none" stroke="white" stroke-opacity="0.06"
          stroke-width="1.5" stroke-dasharray="8 14" stroke-linecap="round"
        />
        {/* Start node */}
        <circle cx={pb.sx} cy={pb.sy} r={pb.n1} fill={GOLD} fill-opacity="0.32" />
        {/* Mid nodes */}
        <circle cx={pbM1x} cy={pbM1y} r={pb.n2} fill="white" fill-opacity="0.18" />
        <circle cx={pbM2x} cy={pbM2y} r={pb.n3} fill={C.accent} fill-opacity="0.22" />
        {/* End node */}
        <circle cx={pb.ex} cy={pb.ey} r={pb.n4} fill={GOLD} fill-opacity="0.3" />
      </>
    )}

    {/* ─── Guides: Editorial rules ─── */}
    {variant === 'guide' && (
      <>
        {/* Rule 1 — strongest */}
        <line
          x1={g.lx} y1={g.l1y} x2={g.lx + g.l1w} y2={g.l1y}
          stroke="white" stroke-opacity="0.1" stroke-width="2"
        />
        {/* Rule 2 — dashed accent */}
        <line
          x1={g.lx} y1={g.l2y} x2={g.lx + g.l2w} y2={g.l2y}
          stroke={C.accent} stroke-opacity="0.14" stroke-width="1.5"
          stroke-dasharray="10 16"
        />
        {/* Rule 3 — medium */}
        <line
          x1={g.lx} y1={g.l3y} x2={g.lx + g.l3w} y2={g.l3y}
          stroke="white" stroke-opacity="0.08" stroke-width="1.5"
        />
        {/* Rule 4 — lightest */}
        <line
          x1={g.lx} y1={g.l4y} x2={g.lx + g.l4w} y2={g.l4y}
          stroke="white" stroke-opacity="0.06" stroke-width="1"
        />
        {/* Large decorative circle */}
        <circle
          cx={g.cx} cy={g.cy} r={g.cr}
          fill={GOLD} fill-opacity="0.08"
        />
        {/* Inner concentric circle */}
        <circle
          cx={g.cx} cy={g.cy} r={g.ir}
          fill={C.accent} fill-opacity="0.12"
        />
      </>
    )}
  </svg>

  {/* ── Layer 4: Bottom vignette for text readability ─ */}
  <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_35%,rgba(0,0,0,0.24))]"></div>

  {/* ── Layer 5: Noise grain texture ─────────────── */}
  <div class="cover-grain absolute inset-0"></div>

  {/* ── Badge ────────────────────────────────────── */}
  <div class="absolute left-4 top-4 sm:left-5 sm:top-5">
    <span class="inline-flex items-center rounded-full border border-white/15 bg-black/25 px-3 py-1 text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-white/80 backdrop-blur-md">
      {badge}
    </span>
  </div>

  {/* ── Title: Panel layout (bottom-left card) ───── */}
  {showTitle && layout === 'panel' && (
    <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
      <div class:list={[
        'rounded-[1.1rem] border border-white/10 bg-black/30 px-4 py-4 backdrop-blur-lg sm:px-5',
        copyWidth,
      ]}>
        {subtitle && (
          <p class="text-[0.64rem] font-semibold uppercase tracking-[0.16em] text-white/55">
            {subtitle}
          </p>
        )}
        <h3 class:list={['mt-2 text-balance font-[650] leading-[1.02] text-white', titleSize]}>
          {title}
        </h3>
      </div>
    </div>
  )}

  {/* ── Title: Frame layout (top-right card) ─────── */}
  {showTitle && layout === 'frame' && (
    <div class="absolute right-4 top-16 sm:right-6 sm:top-18">
      <div class:list={[
        'rounded-[1.5rem] border border-white/10 bg-black/25 p-5 backdrop-blur-lg',
        compact ? 'w-[12.5rem] sm:w-[13.5rem]' : 'w-[15rem] sm:w-[18rem]',
      ]}>
        {subtitle && (
          <p class="text-[0.64rem] font-semibold uppercase tracking-[0.16em] text-white/55">
            {subtitle}
          </p>
        )}
        <h3 class:list={['mt-3 text-balance font-[650] leading-[1.02] text-white', titleSize]}>
          {title}
        </h3>
      </div>
    </div>
  )}

  {/* ── Title: Split layout (bottom with accent) ─── */}
  {showTitle && layout === 'split' && (
    <div class="absolute inset-x-0 bottom-0 grid grid-cols-[minmax(0,1fr)_5rem] items-end px-4 pb-4 sm:px-6 sm:pb-6">
      <div class:list={[
        'rounded-[1rem] border border-white/10 bg-black/28 px-4 py-4 backdrop-blur-lg sm:px-5',
        copyWidth,
      ]}>
        {subtitle && (
          <p class="text-[0.64rem] font-semibold uppercase tracking-[0.16em] text-white/55">
            {subtitle}
          </p>
        )}
        <h3 class:list={['mt-2 text-balance font-[650] leading-[1.02] text-white', titleSize]}>
          {title}
        </h3>
      </div>
      <div class="justify-self-end">
        <div class="h-14 w-14 rounded-[1.1rem] border border-white/10 bg-white/5 backdrop-blur-lg sm:h-18 sm:w-18"></div>
      </div>
    </div>
  )}

  {/* ── Title: Hero layout (full-width bottom) ───── */}
  {showTitle && layout === 'hero' && (
    <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6">
      <div class="flex items-end justify-between gap-6">
        <div class={copyWidth}>
          {subtitle && (
            <p class="text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-white/58">
              {subtitle}
            </p>
          )}
          <h3 class:list={[
            'mt-2 text-balance font-[700] leading-[0.98] text-white',
            compact ? 'text-[1.2rem] sm:text-[1.35rem]' : 'text-[1.55rem] sm:text-[2rem]',
          ]}>
            {title}
          </h3>
        </div>
        <div class="hidden sm:block">
          <div class="h-24 w-24 rounded-[1.75rem] border border-white/10 bg-white/5 backdrop-blur-md"></div>
        </div>
      </div>
    </div>
  )}

  {/* ── Subtitle-only mode (no title panel) ──────── */}
  {!showTitle && subtitle && (
    <div class="absolute left-4 bottom-4 sm:left-5 sm:bottom-5">
      <p class="text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-white/58">
        {subtitle}
      </p>
    </div>
  )}
</div>

<style>
  /* Subtle grain texture — adds premium tactile depth */
  .cover-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='256' height='256' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px 200px;
    mix-blend-mode: overlay;
    opacity: 0.4;
    pointer-events: none;
  }
</style>
