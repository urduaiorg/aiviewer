---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import LegacyEditorialCover from './LegacyEditorialCover.astro';
import provenance from '../../data/editorial-image-provenance.json';
interface Props {
  title: string;
  subtitle?: string;
  category?: string;
  image?: string;
  variant?: 'playbook' | 'tool' | 'guide' | 'opportunity';
  badge?: string;
  compact?: boolean;
  layout?: 'panel' | 'frame' | 'split' | 'hero';
  showTitle?: boolean;
}
const { image, title, subtitle, compact = false, showTitle = true } = Astro.props;
const localImage = image?.startsWith('/') && !image.startsWith('//') && !image.includes('..');
const hasImage = Boolean(image && (localImage
  ? existsSync(join(process.cwd(), 'public', image.slice(1)))
  : /^https:\/\//.test(image)));
const credit = provenance.find((item) => item.asset === image);
const thumbnail = image?.replace(/\.webp$/, '-800.webp');
const hasThumbnail = localImage && thumbnail !== image && existsSync(join(process.cwd(), 'public', thumbnail.slice(1)));
---
{hasImage ? (
  <div class:list={['editorial-cover actual-cover', { 'actual-cover--compact': compact }]}>
    <img src={image} srcset={hasThumbnail ? `${thumbnail} 800w, ${image} ${credit?.width ?? 1600}w` : undefined} sizes={hasThumbnail ? '(max-width: 700px) 100vw, 50vw' : undefined} alt={credit?.altText ?? ''} width={credit?.width ?? 1600} height={credit?.height ?? 900} loading="lazy" decoding="async" />
    {showTitle && <div class="actual-cover__caption">{subtitle && <p>{subtitle}</p>}<h3>{title}</h3></div>}
  </div>
) : <LegacyEditorialCover {...Astro.props} />}
<style>
  .actual-cover{position:relative;overflow:hidden;aspect-ratio:2/1;background:#f2eee6}
  .actual-cover--compact{aspect-ratio:16/10}
  .actual-cover img{width:100%;height:100%;object-fit:cover;display:block}
  .actual-cover__caption{position:absolute;bottom:0;left:0;right:0;background:rgb(17 17 15 / .9);color:#fff;padding:14px 18px}
  .actual-cover__caption p{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:#f0c75e;margin:0 0 6px}
  .actual-cover__caption h3{font-size:1.1rem;line-height:1.3;margin:0;color:white}
</style>
