---
/**
 * Content-freshness label. This describes recency only; it does not imply
 * hands-on verification or a product recommendation.
 */
interface Props {
  lastVerifiedDate: string | Date;
  toolName: string;
}

const { lastVerifiedDate } = Astro.props;
const dateObj = typeof lastVerifiedDate === 'string' ? new Date(lastVerifiedDate) : lastVerifiedDate;
const formatted = dateObj.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<div class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m5-2a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  <span>Editorial snapshot</span>
  <span class="opacity-60">· Updated {formatted}</span>
</div>
