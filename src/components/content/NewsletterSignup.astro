---
/**
 * NewsletterSignup — Live email capture via Beehiiv (AI for Education Briefing)
 *
 * Premium AIViewer design wrapper around the Beehiiv subscription form.
 * Feeds subscribers into the aiforedu.ai Beehiiv publication list.
 * Section variant: full-width hero CTA with Beehiiv embed
 * Inline variant: compact card for use inside articles
 */
interface Props {
  /** Heading text */
  heading?: string;
  /** Subtitle / description */
  subtitle?: string;
  /** Visual variant */
  variant?: 'section' | 'inline';
}

const {
  heading = 'Stay ahead of the AI curve.',
  subtitle = 'One email per week. No spam, no hype — just the most useful AI developments, tools, and tactics.',
  variant = 'section',
} = Astro.props;

const beehiivSrc = 'https://subscribe-forms.beehiiv.com/df762eb2-5183-49d6-bb1e-fafb3683f2e0';
---

{variant === 'section' ? (
  <section class="relative overflow-hidden rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-[var(--shadow-card)]">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(240,199,94,0.12),_transparent_50%),radial-gradient(circle_at_bottom_left,_rgba(79,70,229,0.08),_transparent_50%)] dark:bg-[radial-gradient(circle_at_top_right,_rgba(240,199,94,0.08),_transparent_50%),radial-gradient(circle_at_bottom_left,_rgba(79,70,229,0.06),_transparent_50%)]"></div>
    <div class="relative px-4 py-4 md:px-6 md:py-6">
      <div class="overflow-hidden rounded-xl">
        <iframe
          src={beehiivSrc}
          title="Subscribe to the AI Briefing newsletter"
          class="beehiiv-embed w-full"
          frameborder="0"
          scrolling="no"
          style="margin:0;border-radius:0!important;background-color:transparent;box-shadow:0 0 #0000;max-width:100%;height:340px;"
        ></iframe>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-zinc-400 dark:text-zinc-500">
        <span>Free forever</span>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <span>Unsubscribe anytime</span>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <a href="https://updates.aiforedu.ai/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-zinc-600 dark:hover:text-zinc-300">View archive</a>
      </div>
    </div>
  </section>
) : (
  <div class="not-prose my-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-gradient-to-br from-zinc-50 to-white dark:from-zinc-900 dark:to-zinc-900 p-5">
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Newsletter</p>
    <p class="mt-2 text-base font-semibold text-zinc-900 dark:text-zinc-50">{heading}</p>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{subtitle}</p>

    <div class="mt-4 overflow-hidden rounded-lg">
      <iframe
        src={beehiivSrc}
        title="Subscribe to the AI Briefing newsletter"
        class="beehiiv-embed w-full"
        frameborder="0"
        scrolling="no"
        style="margin:0;border-radius:0!important;background-color:transparent;box-shadow:0 0 #0000;max-width:100%;height:340px;"
      ></iframe>
    </div>
  </div>
)}

<script>
  // Auto-resize Beehiiv iframes to fit content
  window.addEventListener('message', (event) => {
    if (event.origin !== 'https://subscribe-forms.beehiiv.com') return;
    if (typeof event.data === 'object' && event.data.type === 'beehiiv:resize') {
      document.querySelectorAll<HTMLIFrameElement>('.beehiiv-embed').forEach((iframe) => {
        if (iframe.contentWindow === event.source) {
          iframe.style.height = `${event.data.height}px`;
        }
      });
    }
  });
</script>
