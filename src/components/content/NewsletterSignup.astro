---
/**
 * NewsletterSignup — Native email capture form, posts to Beehiiv API
 *
 * Replaced broken Beehiiv iframe embed with a native form that POSTs
 * directly to Beehiiv's subscribe endpoint via hidden iframe target.
 * Full design control, no third-party rendering dependency.
 *
 * Section variant: full-width hero CTA
 * Inline variant: compact card for use inside articles
 */
interface Props {
  /** Heading text */
  heading?: string;
  /** Subtitle / description */
  subtitle?: string;
  /** Visual variant */
  variant?: 'section' | 'inline';
}

const {
  heading = 'Stay ahead of the AI curve.',
  subtitle = 'One email per week. No spam, no hype — just the most useful AI developments, tools, and tactics.',
  variant = 'section',
} = Astro.props;

// Form ID used in the client-side script below
// POST target: https://subscribe-forms.beehiiv.com/{FORM_ID}
const BEEHIIV_FORM_ID = 'df762eb2-5183-49d6-bb1e-fafb3683f2e0';
---

{variant === 'section' ? (
  <section class="newsletter-signup relative overflow-hidden rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-[var(--shadow-card)]">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(240,199,94,0.12),_transparent_50%),radial-gradient(circle_at_bottom_left,_rgba(79,70,229,0.08),_transparent_50%)] dark:bg-[radial-gradient(circle_at_top_right,_rgba(240,199,94,0.08),_transparent_50%),radial-gradient(circle_at_bottom_left,_rgba(79,70,229,0.06),_transparent_50%)]"></div>
    <div class="relative px-6 py-10 md:px-10 md:py-12 text-center">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">The AI Briefing</p>
      <h2 class="mt-3 text-2xl font-bold text-zinc-900 dark:text-zinc-50 md:text-3xl">{heading}</h2>
      <p class="mt-3 mx-auto max-w-lg text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 md:text-base">{subtitle}</p>

      <form class="newsletter-form mt-6 mx-auto flex max-w-md flex-col gap-3 sm:flex-row sm:gap-2" method="POST" action={`https://subscribe-forms.beehiiv.com/${BEEHIIV_FORM_ID}`} target="_blank" data-beehiiv-form>
        <label class="sr-only" for="newsletter-email-section">Email address</label>
        <input
          id="newsletter-email-section"
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          autocomplete="email"
          class="flex-1 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-3 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-colors"
        />
        <input type="hidden" name="utm_source" value="aiviewer" />
        <button
          type="submit"
          class="newsletter-btn shrink-0 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow-md active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Get the Briefing
        </button>
      </form>

      <p class="mt-4 text-xs text-zinc-400 dark:text-zinc-500">Submission opens Beehiiv in a new tab so you can see confirmation or any error directly.</p>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-zinc-400 dark:text-zinc-500">
        <span>Free forever</span>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <span>Unsubscribe anytime</span>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <a href="https://updates.aiforedu.ai/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-zinc-600 dark:hover:text-zinc-300">View archive</a>
      </div>
    </div>
  </section>
) : (
  <div class="newsletter-signup not-prose my-8 -mx-6 rounded-none border-x-0 border-y border-zinc-200 dark:border-zinc-800 bg-gradient-to-br from-zinc-50 to-white dark:from-zinc-900 dark:to-zinc-900 px-3 py-4 sm:mx-0 sm:rounded-2xl sm:border sm:p-5">
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-400">Newsletter</p>
    <p class="mt-2 text-base font-semibold text-zinc-900 dark:text-zinc-50">{heading}</p>
    <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{subtitle}</p>

    <form class="newsletter-form mt-4 flex flex-col gap-3 sm:flex-row sm:gap-2" method="POST" action={`https://subscribe-forms.beehiiv.com/${BEEHIIV_FORM_ID}`} target="_blank" data-beehiiv-form>
      <label class="sr-only" for="newsletter-email-inline">Email address</label>
      <input
        id="newsletter-email-inline"
        type="email"
        name="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
        class="flex-1 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-4 py-3 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-colors"
      />
      <input type="hidden" name="utm_source" value="aiviewer" />
      <button
        type="submit"
        class="newsletter-btn shrink-0 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow-md active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Subscribe
      </button>
    </form>

    <p class="mt-3 text-xs text-zinc-400 dark:text-zinc-500">Beehiiv opens in a new tab to confirm the submission.</p>
  </div>
)}

<script>
  function initNewsletterForms() {
    document.querySelectorAll<HTMLFormElement>('[data-beehiiv-form]').forEach((form) => {
      if (form.dataset.initialized) return;
      form.dataset.initialized = 'true';

      form.addEventListener('submit', () => {
        (window as any).aiViewerTrack?.('newsletter_submit_attempt', {
          placement: form.closest('.not-prose') ? 'article_inline' : 'section',
          path: window.location.pathname,
        });
      });
    });
  }

  initNewsletterForms();
  document.addEventListener('astro:page-load', initNewsletterForms);
</script>
