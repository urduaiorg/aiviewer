---
// Kept as a shared learning CTA while email delivery is unverified.
interface Props { heading?: string; subtitle?: string; variant?: 'section' | 'inline'; }
const { variant = 'section' } = Astro.props;
---
<aside class:list={['rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-700 dark:bg-zinc-800', variant === 'inline' && 'mt-8']} aria-label="Keep learning">
  <h2 class="text-xl font-semibold text-zinc-950 dark:text-zinc-50">Put the lesson into practice</h2>
  <p class="mt-3 text-zinc-600 dark:text-zinc-300">Choose another practical guide or follow new lessons in your RSS reader.</p>
  <div class="mt-4 flex flex-wrap gap-4">
    <a class="font-semibold text-indigo-700 underline underline-offset-4 dark:text-indigo-300" href="/practical-guides/">Explore practical guides</a>
    <a class="font-semibold text-indigo-700 underline underline-offset-4 dark:text-indigo-300" href="/rss.xml">Follow via RSS</a>
  </div>
</aside>
