---
/**
 * FreshnessIndicator — Shows how fresh data is with a colored dot
 *
 * Thresholds: green (< 7 days), yellow (< 30 days), red (> 30 days)
 */
interface Props {
  date: string;
  label?: string;
  thresholds?: { fresh: number; stale: number };
}

const {
  date,
  label = 'Updated',
  thresholds = { fresh: 7, stale: 30 },
} = Astro.props;

const dateObj = new Date(date);
const now = new Date();
const daysAgo = Math.floor((now.getTime() - dateObj.getTime()) / (1000 * 60 * 60 * 24));

const status = daysAgo <= thresholds.fresh ? 'fresh' : daysAgo <= thresholds.stale ? 'recent' : 'stale';

const colors = {
  fresh: 'bg-emerald-500',
  recent: 'bg-amber-500',
  stale: 'bg-red-500',
};

const formatted = dateObj.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<span class="inline-flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400">
  <span class={`h-1.5 w-1.5 rounded-full ${colors[status]}`} aria-hidden="true"></span>
  {label} {formatted}
</span>
