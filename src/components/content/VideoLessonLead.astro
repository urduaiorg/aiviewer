---
interface Props {
  summary: string;
  learningOutcome?: string;
}

const { summary, learningOutcome } = Astro.props;
---

<section
  class="not-prose mb-7 overflow-hidden rounded-[1.5rem] border border-indigo-200/80 bg-indigo-50/50 dark:border-indigo-900/70 dark:bg-indigo-950/20"
  aria-labelledby="video-lesson-lead-title"
>
  <div class="px-6 py-5 md:px-7">
    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-indigo-700 dark:text-indigo-300">
      AIViewer Lens
    </p>
    <h2 id="video-lesson-lead-title" class="mt-2 text-xl font-semibold text-zinc-950 dark:text-zinc-50">
      The lesson in brief
    </h2>
    <p class="mt-3 max-w-3xl text-[0.95rem] leading-7 text-zinc-700 dark:text-zinc-300">
      {summary}
    </p>
  </div>

  {learningOutcome && (
    <div class="border-t border-indigo-200/70 bg-white/45 px-6 py-5 dark:border-indigo-900/60 dark:bg-zinc-950/15 md:px-7">
      <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">
        Learning outcome
      </h3>
      <p class="mt-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
        {learningOutcome}
      </p>
    </div>
  )}
</section>
