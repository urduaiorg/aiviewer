---
/**
 * AnswerBox — AEO (Answer Engine Optimization) Component
 *
 * Provides a highlighted, extractable answer for AI answer engines
 * (Google AI Overviews, Perplexity, ChatGPT). Renders a visually
 * distinct callout that search engines can identify as a direct answer.
 *
 * Usage in MDX:
 * <AnswerBox question="Is ChatGPT free?" answer="Yes, ChatGPT offers a free tier..." />
 */

interface Props {
  /** The question being answered (used for accessibility + schema context) */
  question?: string;
  /** The direct, concise answer (1-3 sentences ideal) */
  answer: string;
  /** Optional label above the answer (defaults to "Quick Answer") */
  label?: string;
}

const { question, answer, label = 'Quick Answer' } = Astro.props;
---

<aside
  class="not-prose my-8 rounded-2xl border border-amber-200/80 bg-gradient-to-br from-amber-50/80 to-white p-6 shadow-sm"
  role="note"
  aria-label={label}
  data-answer-box
>
  <p class="mb-1 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-amber-700/70">
    {label}
  </p>
  {question && (
    <p class="mb-3 text-base font-semibold text-zinc-900" data-answer-question>
      {question}
    </p>
  )}
  <p class="text-[0.95rem] leading-7 text-zinc-700" data-answer-text>
    {answer}
  </p>
</aside>
