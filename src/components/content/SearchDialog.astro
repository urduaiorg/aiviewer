---
/**
 * SearchDialog — Premium site-wide search powered by Pagefind
 *
 * A refined modal dialog for searching all AIViewer content.
 * Triggered by Cmd+K (Mac) / Ctrl+K (Windows), or clicking the search button.
 * Pagefind JS is lazy-loaded on first open for performance.
 *
 * Features:
 * - Category badges (Playbook, Tool, Guide, Report, Prompt)
 * - Keyboard navigation (arrows, enter, escape)
 * - Debounced search input
 * - Dark mode, reduced-motion, View Transitions support
 */
---

<!-- Search dialog backdrop + container -->
<div
  id="search-dialog-backdrop"
  class="fixed inset-0 z-[70] hidden"
  role="presentation"
>
  <!-- Overlay -->
  <div class="search-overlay absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

  <!-- Dialog -->
  <div class="relative flex items-start justify-center pt-[12vh] sm:pt-[16vh] px-4">
    <div
      id="search-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="Search AIViewer"
      class="search-dialog-panel w-full max-w-[38rem] bg-white dark:bg-zinc-900 rounded-[1.75rem] border border-zinc-200 dark:border-zinc-800 shadow-2xl overflow-hidden flex flex-col max-h-[min(70vh,32rem)]"
    >
      <!-- Search input bar -->
      <div class="flex items-center gap-3 px-5 py-4 border-b border-zinc-100 dark:border-zinc-800">
        <!-- Magnifying glass -->
        <svg class="w-[1.15rem] h-[1.15rem] text-zinc-400 dark:text-zinc-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="search-dialog-input"
          type="text"
          placeholder="Search articles, tools, guides..."
          autocomplete="off"
          spellcheck="false"
          class="flex-1 bg-transparent text-[0.95rem] text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 outline-none border-none"
        />
        <!-- Loading spinner (hidden by default) -->
        <div id="search-spinner" class="hidden shrink-0">
          <svg class="animate-spin h-4 w-4 text-indigo-500" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </div>
        <!-- ESC badge -->
        <button
          id="search-dialog-close"
          class="shrink-0 px-2 py-0.5 text-[0.7rem] font-medium text-zinc-400 dark:text-zinc-500 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-md hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors"
          aria-label="Close search"
        >
          ESC
        </button>
      </div>

      <!-- Results area -->
      <div id="search-dialog-results" class="overflow-y-auto overscroll-contain flex-1">
        <!-- Default state -->
        <div class="search-empty-state flex flex-col items-center justify-center py-14 px-6 text-center">
          <!-- Subtle search illustration -->
          <svg class="w-10 h-10 text-zinc-300 dark:text-zinc-600 mb-4" viewBox="0 0 48 48" fill="none">
            <circle cx="22" cy="22" r="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <path d="M32 32l10 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <path d="M16 19h12M16 25h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5" />
          </svg>
          <p class="text-[0.82rem] text-zinc-400 dark:text-zinc-500">
            Search playbooks, tools, guides, and more
          </p>
          <p class="text-[0.72rem] text-zinc-300 dark:text-zinc-600 mt-1.5">
            Start typing or try: "ChatGPT", "writing", "image generation"
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div class="flex items-center justify-between px-5 py-2.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-800/40">
        <div class="flex items-center gap-3 text-[0.68rem] text-zinc-400 dark:text-zinc-500">
          <span class="flex items-center gap-1">
            <kbd class="inline-flex items-center justify-center w-5 h-5 bg-zinc-100 dark:bg-zinc-700 border border-zinc-200 dark:border-zinc-600 rounded text-[0.6rem] font-mono">&#8593;</kbd>
            <kbd class="inline-flex items-center justify-center w-5 h-5 bg-zinc-100 dark:bg-zinc-700 border border-zinc-200 dark:border-zinc-600 rounded text-[0.6rem] font-mono">&#8595;</kbd>
            navigate
          </span>
          <span class="flex items-center gap-1">
            <kbd class="inline-flex items-center justify-center h-5 px-1.5 bg-zinc-100 dark:bg-zinc-700 border border-zinc-200 dark:border-zinc-600 rounded text-[0.6rem] font-mono">&#9166;</kbd>
            open
          </span>
          <span class="flex items-center gap-1">
            <kbd class="inline-flex items-center justify-center h-5 px-1.5 bg-zinc-100 dark:bg-zinc-700 border border-zinc-200 dark:border-zinc-600 rounded text-[0.6rem] font-mono">esc</kbd>
            close
          </span>
        </div>
        <span class="text-[0.65rem] text-zinc-300 dark:text-zinc-600">
          Powered by Pagefind
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Dialog entrance animation ── */
  .search-overlay {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .search-dialog-panel {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(#search-dialog-backdrop.is-open) .search-overlay {
    opacity: 1;
  }
  :global(#search-dialog-backdrop.is-open) .search-dialog-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* ── Keyboard-navigated result highlight ── */
  :global(.search-result-item) {
    transition: background-color 0.12s ease;
  }
  :global(.search-result-item.is-active) {
    background-color: rgba(79, 70, 229, 0.06);
  }
  :global([data-theme="dark"] .search-result-item.is-active) {
    background-color: rgba(99, 102, 241, 0.12);
  }

  /* ── Category badge colors ── */
  :global(.search-badge) {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.5rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-radius: 9999px;
    white-space: nowrap;
  }
  :global(.search-badge-playbook) {
    background: rgba(79, 70, 229, 0.1);
    color: #4F46E5;
  }
  :global([data-theme="dark"] .search-badge-playbook) {
    background: rgba(99, 102, 241, 0.15);
    color: #A5B4FC;
  }
  :global(.search-badge-tool) {
    background: rgba(5, 150, 105, 0.1);
    color: #059669;
  }
  :global([data-theme="dark"] .search-badge-tool) {
    background: rgba(16, 185, 129, 0.15);
    color: #6EE7B7;
  }
  :global(.search-badge-guide) {
    background: rgba(217, 119, 6, 0.1);
    color: #B45309;
  }
  :global([data-theme="dark"] .search-badge-guide) {
    background: rgba(245, 158, 11, 0.15);
    color: #FCD34D;
  }
  :global(.search-badge-report) {
    background: rgba(220, 38, 38, 0.08);
    color: #DC2626;
  }
  :global([data-theme="dark"] .search-badge-report) {
    background: rgba(239, 68, 68, 0.12);
    color: #FCA5A5;
  }
  :global(.search-badge-prompt) {
    background: rgba(124, 58, 237, 0.08);
    color: #7C3AED;
  }
  :global([data-theme="dark"] .search-badge-prompt) {
    background: rgba(139, 92, 246, 0.15);
    color: #C4B5FD;
  }
  :global(.search-badge-default) {
    background: rgba(113, 113, 122, 0.1);
    color: #71717A;
  }
  :global([data-theme="dark"] .search-badge-default) {
    background: rgba(161, 161, 170, 0.12);
    color: #A1A1AA;
  }

  /* ── Excerpt highlight ── */
  :global(.search-result-excerpt mark) {
    background: rgba(79, 70, 229, 0.12);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
  :global([data-theme="dark"] .search-result-excerpt mark) {
    background: rgba(99, 102, 241, 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .search-overlay,
    .search-dialog-panel {
      transition: none;
    }
    :global(.search-result-item) {
      transition: none;
    }
  }
</style>

<script>
  /**
   * SearchDialog controller
   * Manages open/close, Pagefind lazy-loading, search, keyboard nav
   */
  function initSearchDialog() {
    const backdrop = document.getElementById('search-dialog-backdrop');
    const input = document.getElementById('search-dialog-input') as HTMLInputElement | null;
    const results = document.getElementById('search-dialog-results');
    const closeBtn = document.getElementById('search-dialog-close');
    const spinner = document.getElementById('search-spinner');

    if (!backdrop || !input || !results || !closeBtn) return;
    // Guard against double-binding on View Transitions
    if (backdrop.dataset.bound === 'true') return;
    backdrop.dataset.bound = 'true';

    let pagefind: any = null;
    let pagefindLoading = false;
    let searchTimeout: ReturnType<typeof setTimeout>;
    let activeIndex = -1;
    let triggerElement: HTMLElement | null = null;
    let destroyFocusTrap: (() => void) | null = null;

    // ── Pagefind lazy loader ──
    async function loadPagefind() {
      if (pagefind || pagefindLoading) return;
      pagefindLoading = true;
      try {
        // Runtime variable prevents Rollup static analysis of the import path.
        // Pagefind generates its JS bundle into /pagefind/ at build time —
        // it only exists in the final dist output, not during Vite's module graph.
        const pfPath = '/pagefind/pagefind.js';
        pagefind = await import(/* @vite-ignore */ pfPath);
        await pagefind.init();
      } catch (err) {
        console.warn('Pagefind not available. Search requires a production build.');
        pagefind = null;
      }
      pagefindLoading = false;
    }

    // ── Open / close ──
    function openDialog() {
      // WCAG 2.4.3 — Remember which element triggered the dialog so we can return focus
      triggerElement = document.activeElement as HTMLElement | null;

      backdrop.classList.remove('hidden');
      // Force reflow so transition plays
      void backdrop.offsetWidth;
      backdrop.classList.add('is-open');
      input.focus();
      document.body.style.overflow = 'hidden';
      loadPagefind();

      // WCAG 2.4.3 — Activate focus trap within the dialog panel
      const dialog = document.getElementById('search-dialog');
      if (dialog && typeof (window as any).__createFocusTrap === 'function') {
        destroyFocusTrap = (window as any).__createFocusTrap(dialog);
      }
    }

    function closeDialog() {
      backdrop.classList.remove('is-open');
      document.body.style.overflow = '';

      // WCAG 2.4.3 — Tear down focus trap
      if (destroyFocusTrap) {
        destroyFocusTrap();
        destroyFocusTrap = null;
      }

      // WCAG 2.4.3 — Return focus to the element that triggered the dialog
      if (triggerElement && typeof triggerElement.focus === 'function') {
        triggerElement.focus();
        triggerElement = null;
      }

      // Wait for exit animation then hide
      const onEnd = () => {
        backdrop.classList.add('hidden');
        input.value = '';
        resetResults();
        backdrop.removeEventListener('transitionend', onEnd);
      };
      // If reduced motion, hide immediately
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        backdrop.classList.add('hidden');
        input.value = '';
        resetResults();
      } else {
        backdrop.addEventListener('transitionend', onEnd, { once: true });
        // Fallback in case transitionend doesn't fire
        setTimeout(() => {
          if (!backdrop.classList.contains('hidden')) {
            backdrop.classList.add('hidden');
            input.value = '';
            resetResults();
          }
        }, 400);
      }
    }

    // ── Expose open function globally for Header button ──
    (window as any).__openSearchDialog = openDialog;

    function resetResults() {
      activeIndex = -1;
      results.innerHTML = `
        <div class="search-empty-state flex flex-col items-center justify-center py-14 px-6 text-center">
          <svg class="w-10 h-10 text-zinc-300 dark:text-zinc-600 mb-4" viewBox="0 0 48 48" fill="none">
            <circle cx="22" cy="22" r="14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <path d="M32 32l10 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <path d="M16 19h12M16 25h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5" />
          </svg>
          <p class="text-[0.82rem] text-zinc-400 dark:text-zinc-500">
            Search playbooks, tools, guides, and more
          </p>
          <p class="text-[0.72rem] text-zinc-300 dark:text-zinc-600 mt-1.5">
            Start typing or try: "ChatGPT", "writing", "image generation"
          </p>
        </div>
      `;
    }

    // ── Detect category from URL path ──
    function detectCategory(url: string): string {
      if (url.includes('/playbooks/')) return 'playbook';
      if (url.includes('/tools/'))     return 'tool';
      if (url.includes('/guides/'))    return 'guide';
      if (url.includes('/reports/'))   return 'report';
      if (url.includes('/prompts/'))   return 'prompt';
      return 'default';
    }

    function categoryLabel(cat: string): string {
      const labels: Record<string, string> = {
        playbook: 'Playbook',
        tool: 'Tool',
        guide: 'Guide',
        report: 'Report',
        prompt: 'Prompt',
        default: 'Page',
      };
      return labels[cat] || 'Page';
    }

    // ── Render search results ──
    function renderResults(items: any[]) {
      if (items.length === 0) {
        const q = input.value.trim();
        results.innerHTML = `
          <div class="flex flex-col items-center justify-center py-14 px-6 text-center">
            <svg class="w-9 h-9 text-zinc-300 dark:text-zinc-600 mb-3" viewBox="0 0 48 48" fill="none">
              <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2.5" opacity="0.5" />
              <path d="M18 18l12 12M30 18L18 30" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.6" />
            </svg>
            <p class="text-[0.85rem] font-medium text-zinc-500 dark:text-zinc-400">
              No results for "${q}"
            </p>
            <p class="text-[0.75rem] text-zinc-400 dark:text-zinc-500 mt-1.5 max-w-[260px]">
              Try different keywords or check for typos
            </p>
          </div>
        `;
        return;
      }

      activeIndex = -1;
      const listHTML = items.map((data, i) => {
        const cat = detectCategory(data.url);
        return `
          <a
            href="${data.url}"
            class="search-result-item flex items-start gap-3 px-5 py-3 cursor-pointer"
            data-index="${i}"
          >
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-0.5">
                <span class="search-badge search-badge-${cat}">${categoryLabel(cat)}</span>
                <span class="text-[0.82rem] font-semibold text-zinc-900 dark:text-zinc-100 truncate">${data.meta?.title || data.url}</span>
              </div>
              <p class="search-result-excerpt text-[0.75rem] text-zinc-500 dark:text-zinc-400 line-clamp-2 leading-relaxed">${data.excerpt || ''}</p>
            </div>
            <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-600 shrink-0 mt-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </a>
        `;
      }).join('');

      results.innerHTML = `<div class="py-1">${listHTML}</div>`;
    }

    // ── Keyboard navigation within results ──
    function navigateResults(direction: number) {
      const items = results.querySelectorAll('.search-result-item');
      if (items.length === 0) return;

      // Remove current active
      items.forEach(el => el.classList.remove('is-active'));

      activeIndex += direction;
      if (activeIndex < 0) activeIndex = items.length - 1;
      if (activeIndex >= items.length) activeIndex = 0;

      const activeEl = items[activeIndex] as HTMLElement;
      activeEl.classList.add('is-active');
      activeEl.scrollIntoView({ block: 'nearest' });
    }

    function selectActiveResult() {
      const items = results.querySelectorAll('.search-result-item');
      if (activeIndex >= 0 && activeIndex < items.length) {
        const link = items[activeIndex] as HTMLAnchorElement;
        closeDialog();
        window.location.href = link.href;
      }
    }

    // ── Search execution ──
    async function performSearch(query: string) {
      if (query.length < 2) {
        resetResults();
        return;
      }

      spinner?.classList.remove('hidden');

      if (!pagefind) {
        spinner?.classList.add('hidden');
        results.innerHTML = `
          <div class="flex flex-col items-center justify-center py-14 px-6 text-center">
            <p class="text-[0.82rem] text-zinc-400 dark:text-zinc-500">
              Search index not available
            </p>
            <p class="text-[0.72rem] text-zinc-300 dark:text-zinc-600 mt-1.5">
              Run a production build to enable search
            </p>
          </div>
        `;
        return;
      }

      try {
        const search = await pagefind.search(query);
        const topResults = search.results.slice(0, 8);
        const data = await Promise.all(topResults.map((r: any) => r.data()));
        renderResults(data);
      } catch (err) {
        results.innerHTML = `
          <div class="flex items-center justify-center py-14 px-6">
            <p class="text-[0.82rem] text-zinc-400 dark:text-zinc-500">Search encountered an error. Please try again.</p>
          </div>
        `;
      }

      spinner?.classList.add('hidden');
    }

    // ── Event listeners ──
    // Close button
    closeBtn.addEventListener('click', closeDialog);

    // Backdrop click
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop || (e.target as Element)?.classList.contains('search-overlay')) {
        closeDialog();
      }
    });

    // Input handler with debounce
    input.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      const q = input.value.trim();
      searchTimeout = setTimeout(() => performSearch(q), 180);
    });

    // Keyboard shortcuts (global)
    document.addEventListener('keydown', (e) => {
      const isOpen = backdrop.classList.contains('is-open');

      // Cmd+K / Ctrl+K to open
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (isOpen) {
          closeDialog();
        } else {
          openDialog();
        }
        return;
      }

      if (!isOpen) return;

      // Escape to close
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDialog();
        return;
      }

      // Arrow navigation
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        navigateResults(1);
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        navigateResults(-1);
        return;
      }

      // Enter to select
      if (e.key === 'Enter') {
        if (activeIndex >= 0) {
          e.preventDefault();
          selectActiveResult();
        }
      }
    });

    // Hover sets active index
    results.addEventListener('mousemove', (e) => {
      const item = (e.target as Element)?.closest('.search-result-item') as HTMLElement | null;
      if (!item) return;
      const items = results.querySelectorAll('.search-result-item');
      items.forEach(el => el.classList.remove('is-active'));
      item.classList.add('is-active');
      activeIndex = parseInt(item.dataset.index || '-1', 10);
    });
  }

  // Init on first load and on View Transitions navigation
  initSearchDialog();
  document.addEventListener('astro:page-load', initSearchDialog);
</script>
