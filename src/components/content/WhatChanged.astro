---
/**
 * WhatChanged — Compact timeline showing recent changes for a model.
 *
 * Shows pricing changes, capability updates, and release events
 * with type-colored indicators.
 */
interface ChangeItem {
  type: 'launch' | 'price' | 'capability' | 'release';
  description: string;
  date?: string | null;
  detail?: string | null;
}

interface Props {
  changes: ChangeItem[];
  limit?: number;
}

const { changes, limit = 3 } = Astro.props;
const displayChanges = changes.slice(0, limit);

const typeConfig: Record<string, { color: string; label: string }> = {
  launch: { color: 'bg-indigo-500', label: 'Launch' },
  price: { color: 'bg-emerald-500', label: 'Pricing' },
  capability: { color: 'bg-amber-500', label: 'Capability' },
  release: { color: 'bg-blue-500', label: 'Release' },
};
---

{displayChanges.length > 0 && (
  <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-950/50 p-5">
    <h3 class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-zinc-400 dark:text-zinc-500">
      Recent changes
    </h3>
    <div class="mt-4 space-y-3">
      {displayChanges.map((change) => {
        const config = typeConfig[change.type] || typeConfig.release;
        const formatted = change.date
          ? new Date(change.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })
          : null;
        return (
          <div class="flex items-start gap-3">
            <div class="mt-1.5 flex flex-col items-center">
              <div class={`w-2 h-2 rounded-full ${config.color} flex-shrink-0`}></div>
              <div class="w-px h-full bg-zinc-200 dark:bg-zinc-800 mt-1"></div>
            </div>
            <div class="flex-1 min-w-0 pb-3">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[0.65rem] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                  {config.label}
                </span>
                {formatted && (
                  <span class="text-[0.65rem] text-zinc-400 dark:text-zinc-600">
                    {formatted}
                  </span>
                )}
              </div>
              <p class="mt-0.5 text-sm text-zinc-700 dark:text-zinc-300">
                {change.description}
              </p>
              {change.detail && (
                <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                  {change.detail}
                </p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}
