---
/**
 * AffiliateLink — A trusted, SEO-compliant text link component
 * 
 * Renders an inline link with proper FTC/Google attributes (sponsored noopener)
 * and an optional subtle external link icon. Looks like a native text link
 * but handles tracking and compliance safely.
 */
interface Props {
  href: string;
  class?: string;
  showIcon?: boolean;
}

const { href, class: className, showIcon = true } = Astro.props;
---

<a 
  href={href} 
  target="_blank" 
  rel="sponsored noopener" 
  class:list={[
    "inline-flex items-baseline gap-0.5 text-indigo-600 dark:text-indigo-400 font-medium hover:text-indigo-800 dark:hover:text-indigo-300 underline decoration-indigo-200 dark:decoration-indigo-900/50 underline-offset-2 transition-colors", 
    className
  ]}
>
  <slot />
  {showIcon && (
    <svg class="w-3 h-3 text-zinc-400 dark:text-zinc-500 translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  )}
</a>
