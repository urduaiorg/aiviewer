---
/**
 * PromptBlock — Copyable prompt display with terminal-inspired design
 * Features: one-click copy, visual feedback, subtle syntax highlighting feel,
 * and a branded "ready to paste" indicator. Not a boring code block.
 */
interface Props {
  prompt: string;
  tool?: string;
  label?: string;
  variant?: 'default' | 'dark';
}

const { prompt, tool, label = 'Prompt', variant = 'default' } = Astro.props;
const blockId = `prompt-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={[
    'prompt-wrap not-prose group relative rounded-xl overflow-hidden transition-shadow duration-300',
    variant === 'dark'
      ? 'bg-zinc-900 text-zinc-100 shadow-lg'
      : 'bg-gradient-to-br from-slate-50 to-zinc-50 dark:from-zinc-900 dark:to-zinc-800/80 border border-zinc-200/80 dark:border-zinc-700/60 shadow-sm hover:shadow-md dark:shadow-lg',
  ]}
>
  {/* Header bar */}
  <div
    class:list={[
      'flex items-center justify-between px-4 py-2.5 border-b',
      variant === 'dark'
        ? 'border-zinc-800 bg-zinc-900/60'
        : 'border-zinc-200/60 dark:border-zinc-700/60 bg-white/50 dark:bg-zinc-900/60',
    ]}
  >
    <div class="flex items-center gap-2.5">
      {/* Prompt indicator — three dots like a terminal */}
      <div class="flex items-center gap-1" aria-hidden="true">
        <span class:list={['w-[7px] h-[7px] rounded-full', variant === 'dark' ? 'bg-red-500/60' : 'bg-zinc-300 dark:bg-red-500/60']}></span>
        <span class:list={['w-[7px] h-[7px] rounded-full', variant === 'dark' ? 'bg-yellow-500/60' : 'bg-zinc-300 dark:bg-yellow-500/60']}></span>
        <span class:list={['w-[7px] h-[7px] rounded-full', variant === 'dark' ? 'bg-green-500/60' : 'bg-zinc-300 dark:bg-green-500/60']}></span>
      </div>
      <span
        class:list={[
          'text-[0.65rem] font-semibold uppercase tracking-widest',
          variant === 'dark' ? 'text-zinc-400' : 'text-zinc-400 dark:text-zinc-400',
        ]}
      >
        {label}
      </span>
      {tool && (
        <span
          class:list={[
            'text-[0.6rem] font-medium px-1.5 py-0.5 rounded',
            variant === 'dark'
              ? 'bg-indigo-500/20 text-indigo-300'
              : 'bg-indigo-50 dark:bg-indigo-500/20 text-indigo-500 dark:text-indigo-300',
          ]}
        >
          {tool}
        </span>
      )}
    </div>

    {/* Copy button */}
    <button
      data-copy-btn={blockId}
      class:list={[
        'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[0.7rem] font-medium transition-all duration-200',
        variant === 'dark'
          ? 'text-zinc-400 hover:text-white hover:bg-zinc-800'
          : 'text-zinc-400 hover:text-zinc-700 dark:text-zinc-300 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800',
      ]}
      aria-label="Copy prompt to clipboard"
    >
      {/* Copy icon */}
      <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
      </svg>
      {/* Check icon (hidden initially) */}
      <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12" />
      </svg>
      <span class="copy-label">Copy</span>
    </button>
  </div>

  {/* Prompt content */}
  <div class="px-5 py-4 relative">
    {/* Left accent bar */}
    <div
      class:list={[
        'absolute left-0 top-3 bottom-3 w-[3px] rounded-full',
        variant === 'dark'
          ? 'bg-gradient-to-b from-indigo-500 to-violet-500'
          : 'bg-gradient-to-b from-indigo-400 to-indigo-200 dark:from-indigo-500 dark:to-violet-500',
      ]}
      aria-hidden="true"
    ></div>

    <pre
      id={blockId}
      class:list={[
        'bg-transparent! text-[0.82rem] leading-[1.7] whitespace-pre-wrap break-words font-sans m-0! p-0!',
        variant === 'dark' ? 'text-zinc-100' : 'text-zinc-700 dark:text-zinc-100',
      ]}
      tabindex="0"
    >{prompt}</pre>
  </div>
</div>

<script>
  function initPromptBlocks() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const blockId = btn.dataset.copyBtn!;
        const pre = document.getElementById(blockId);
        if (!pre) return;

        try {
          await navigator.clipboard.writeText(pre.textContent || '');

          // Visual feedback
          const copyIcon = btn.querySelector('.copy-icon') as HTMLElement;
          const checkIcon = btn.querySelector('.check-icon') as HTMLElement;
          const label = btn.querySelector('.copy-label') as HTMLElement;

          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (label) label.textContent = 'Copied!';

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (label) label.textContent = 'Copy';
          }, 2000);
        } catch {
          // Fallback for older browsers
          const range = document.createRange();
          range.selectNodeContents(pre);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      });
    });
  }

  initPromptBlocks();
  document.addEventListener('astro:after-swap', initPromptBlocks);
</script>
