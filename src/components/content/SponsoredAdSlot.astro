---
/**
 * SponsoredAdSlot — Native-feeling sponsorship placement
 * 
 * Designed to look like a high-value editorial recommendation rather than a banner ad.
 * Features a clear "Partner" or "Sponsored" badge for FTC compliance, but uses our
 * premium dark-mode UI system (card-glow, gradients) to maintain site aesthetics.
 */
interface Props {
  title: string;
  description: string;
  ctaText: string;
  url: string;
  image?: string;
  badgeText?: string;
}

const { 
  title, 
  description, 
  ctaText, 
  url, 
  image, 
  badgeText = "Partner" 
} = Astro.props;
---

<div class="not-prose my-10 relative overflow-hidden bg-white dark:bg-zinc-900 rounded-[var(--radius-lg)] border border-zinc-200/80 dark:border-zinc-800 shadow-[var(--shadow-card)] transition-shadow hover:shadow-[var(--shadow-card-hover)]">
  {/* Subtle gradient overlay to make it feel special */}
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 to-transparent dark:from-indigo-900/10 pointer-events-none" aria-hidden="true"></div>
  
  <div class="relative p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8">
    
    {/* Optional Image / Logo Area */}
    {image && (
      <div class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 bg-zinc-50 dark:bg-zinc-950 rounded-2xl border border-zinc-100 dark:border-zinc-800 flex items-center justify-center p-3 shadow-inner">
        <img src={image} alt={`${title} logo`} width="80" height="80" class="w-full h-full object-contain" loading="lazy" decoding="async" />
      </div>
    )}

    {/* Content */}
    <div class="flex-1">
      <div class="flex items-center gap-3 mb-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[0.65rem] font-bold uppercase tracking-wider bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
          {badgeText}
        </span>
      </div>
      <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-50 leading-tight mb-2">
        {title}
      </h3>
      <p class="text-[0.9rem] text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
        {description}
      </p>
    </div>

    {/* CTA Button */}
    <div class="shrink-0 w-full sm:w-auto mt-2 sm:mt-0">
      <a 
        href={url}
        target="_blank"
        rel="sponsored noopener"
        class="group flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-[0.9rem] font-semibold rounded-xl hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-all duration-200 shadow-md active:scale-[0.98]"
      >
        {ctaText}
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <p class="text-center mt-2 text-[0.65rem] text-zinc-400 dark:text-zinc-500 italic">
        Supported via affiliate link
      </p>
    </div>
  </div>
</div>
