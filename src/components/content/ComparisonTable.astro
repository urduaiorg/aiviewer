---
/**
 * ComparisonTable — Side-by-side tool comparison with visual differentiation
 * Features: highlighted winner column, feature checkmarks with weighted scoring,
 * responsive horizontal scroll, and a verdict row. Not a plain HTML table.
 */
interface Tool {
  name: string;
  logo?: string;
  isWinner?: boolean;
}

interface Feature {
  name: string;
  description?: string;
  /** Values per tool: true/false for yes/no, string for text, number for score 1-5 */
  values: (boolean | string | number)[];
}

interface Props {
  tools: Tool[];
  features: Feature[];
  verdict?: string;
  title?: string;
}

const { tools = [], features = [], verdict, title = 'Comparison' } = Astro.props;

function renderValue(val: boolean | string | number) {
  if (typeof val === 'boolean') return val;
  if (typeof val === 'number') return val;
  return val;
}
---

<div class="comparison-table-wrap my-8">
  {/* Title */}
  <div class="flex items-center gap-2 mb-4">
    <svg class="w-5 h-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
    </svg>
    <h4 class="text-sm font-bold text-zinc-900">{title}</h4>
  </div>

  <div class="overflow-x-auto -mx-1 px-1">
    <table class="w-full border-collapse text-[0.82rem]">
      {/* Header — tool names */}
      <thead>
        <tr>
          <th class="text-left py-3 px-4 text-[0.7rem] font-semibold text-zinc-400 uppercase tracking-wider w-[180px] min-w-[160px]">
            Feature
          </th>
          {tools.map((tool) => (
            <th
              class:list={[
                'text-center py-3 px-4 min-w-[140px]',
                tool.isWinner
                  ? 'bg-indigo-50/60 rounded-t-xl'
                  : '',
              ]}
            >
              <div class="flex flex-col items-center gap-1.5">
                {tool.isWinner && (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.55rem] font-bold uppercase tracking-wider bg-indigo-600 text-white -mt-1 mb-1">
                    <svg class="w-2.5 h-2.5" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                    Winner
                  </span>
                )}
                <span class="font-bold text-zinc-900 text-[0.85rem]">{tool.name}</span>
              </div>
            </th>
          ))}
        </tr>
      </thead>

      {/* Features */}
      <tbody>
        {features.map((feature, fi) => (
          <tr class:list={[fi % 2 === 0 ? 'bg-zinc-50/50' : '']}>
            <td class="py-3 px-4">
              <span class="font-medium text-zinc-700">{feature.name}</span>
              {feature.description && (
                <span class="block text-[0.7rem] text-zinc-400 mt-0.5">{feature.description}</span>
              )}
            </td>
            {feature.values.map((val, vi) => (
              <td
                class:list={[
                  'text-center py-3 px-4',
                  tools[vi]?.isWinner ? 'bg-indigo-50/40' : '',
                ]}
              >
                {typeof val === 'boolean' ? (
                  val ? (
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-50">
                      <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  ) : (
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-zinc-100">
                      <svg class="w-4 h-4 text-zinc-300" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  )
                ) : typeof val === 'number' ? (
                  <div class="flex items-center justify-center gap-0.5">
                    {Array(5).fill(0).map((_, i) => (
                      <div
                        class:list={[
                          'w-2 h-2 rounded-full',
                          i < val ? 'bg-indigo-500' : 'bg-zinc-200',
                        ]}
                      ></div>
                    ))}
                  </div>
                ) : (
                  <span class="text-zinc-600">{val}</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {/* Verdict */}
  {verdict && (
    <div class="mt-4 px-4 py-3 bg-indigo-50 rounded-xl border border-indigo-100">
      <p class="text-[0.8rem] text-indigo-800 leading-relaxed">
        <span class="font-bold">Verdict:</span>{' '}
        {verdict}
      </p>
    </div>
  )}
</div>
