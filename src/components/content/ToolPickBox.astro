---
/**
 * ToolPickBox — Editorial "Our Pick" tool recommendation card
 * Inspired by Wirecutter's pick cards. Features a verdict badge,
 * key stats grid, and a distinctive call-to-action. Not a generic card.
 */
interface Props {
  name: string;
  verdict: string;
  description: string;
  rating: number;
  pricing: 'free' | 'freemium' | 'paid' | 'enterprise';
  bestFor: string[];
  website: string;
  affiliateUrl?: string;
  category?: string;
  badge?: string;
  showRating?: boolean;
}

const {
  name,
  verdict,
  description,
  rating,
  pricing,
  bestFor,
  website,
  affiliateUrl,
  category,
  badge = 'Our Pick',
  showRating = false,
} = Astro.props;

const pricingColors: Record<string, { bg: string; text: string }> = {
  free: { bg: 'bg-emerald-50 dark:bg-emerald-900/30', text: 'text-emerald-700 dark:text-emerald-300' },
  freemium: { bg: 'bg-blue-50 dark:bg-blue-900/30', text: 'text-blue-700 dark:text-blue-300' },
  paid: { bg: 'bg-amber-50 dark:bg-amber-900/30', text: 'text-amber-700 dark:text-amber-300' },
  enterprise: { bg: 'bg-violet-50 dark:bg-violet-900/30', text: 'text-violet-700 dark:text-violet-300' },
};

const pColor = pricingColors[pricing] || pricingColors.freemium;

// Star rating
const fullStars = Math.floor(rating);
const hasHalf = rating % 1 >= 0.5;
const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
---

<div class="tool-pick not-prose relative bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 shadow-sm overflow-hidden hover:shadow-lg transition-shadow duration-300">
  {/* Top accent gradient */}
  <div class="h-[3px] bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-400" aria-hidden="true"></div>

  <div class="p-6 sm:p-7">
    {/* Badge + Category */}
    <div class="flex items-center justify-between mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[0.65rem] font-bold uppercase tracking-wider bg-indigo-600 text-white shadow-sm">
        <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        {badge}
      </span>

      {category && (
        <span class="text-[0.65rem] font-medium text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">
          {category}
        </span>
      )}
    </div>

    {/* Tool name + rating */}
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-50 leading-tight">{name}</h3>
        <p class="mt-1.5 text-[0.82rem] text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-md">
          {verdict}
        </p>
      </div>

      {/* Ratings remain hidden unless a page has an auditable test record. */}
      {showRating && <div class="shrink-0 text-right">
        <div class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-50 leading-none">
          {rating.toFixed(1)}
        </div>
        <div class="mt-1 flex items-center gap-px" aria-label={`${rating} out of 5 stars`}>
          {Array(fullStars).fill(0).map(() => (
            <svg class="w-3 h-3 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
          {hasHalf && (
            <svg class="w-3 h-3 text-amber-400" viewBox="0 0 20 20">
              <defs>
                <linearGradient id="half-star">
                  <stop offset="50%" stop-color="currentColor" />
                  <stop offset="50%" stop-color="#E4E4E7" />
                </linearGradient>
              </defs>
              <path fill="url(#half-star)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          )}
          {Array(emptyStars).fill(0).map(() => (
            <svg class="w-3 h-3 text-zinc-200 dark:text-zinc-700" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
      </div>}
    </div>

    {/* Divider */}
    <div class="my-5 border-t border-dashed border-zinc-200 dark:border-zinc-700"></div>

    {/* Stats row */}
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-[0.6rem] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1">Pricing</p>
        <span class:list={['inline-flex px-2 py-0.5 rounded-md text-[0.72rem] font-semibold capitalize', pColor.bg, pColor.text]}>
          {pricing}
        </span>
      </div>
      <div>
        <p class="text-[0.6rem] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1">Best for</p>
        <div class="flex flex-wrap gap-1">
          {bestFor.slice(0, 3).map((b) => (
            <span class="text-[0.7rem] text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">
              {b}
            </span>
          ))}
        </div>
      </div>
    </div>

    {/* Description */}
    <p class="mt-5 text-[0.82rem] text-zinc-500 dark:text-zinc-400 leading-relaxed">{description}</p>

    {affiliateUrl && (
      <p class="mt-5 text-xs font-medium text-zinc-500 dark:text-zinc-400">
        Paid link: AIViewer may earn a commission at no extra cost to you.
      </p>
    )}

    {/* CTAs */}
    <div class="mt-5 flex items-center gap-3">
      <a
        href={affiliateUrl || website}
        target="_blank"
        rel={affiliateUrl ? 'sponsored noopener' : 'noopener'}
        data-track-event={affiliateUrl ? 'affiliate_click' : 'outbound_tool_click'}
        data-track-label={name}
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 text-white text-[0.82rem] font-semibold rounded-xl hover:bg-indigo-700 transition-colors shadow-sm"
      >
        Try {name}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <a
        href={website}
        target="_blank"
        rel="noopener"
        class="text-[0.8rem] font-medium text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
      >
        Visit website
      </a>
    </div>

  </div>
</div>
