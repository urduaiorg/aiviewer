---
/**
 * ComparisonSchema — WebPage with two SoftwareApplication entities
 * for AI model comparison pages
 */
interface Model {
  name: string;
  slug: string;
  providerLabel: string;
  description?: string;
}

interface Props {
  modelA: Model;
  modelB: Model;
  url: string;
}

const { modelA, modelB, url } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `${modelA.name} vs ${modelB.name} — AI Model Comparison`,
  "description": `Side-by-side comparison of ${modelA.name} and ${modelB.name}. Compare pricing, context window, capabilities, and find the right model for your workflow.`,
  "url": url,
  "about": [
    {
      "@type": "SoftwareApplication",
      "name": modelA.name,
      "applicationCategory": "AI Model",
      "operatingSystem": "Cloud",
      "creator": { "@type": "Organization", "name": modelA.providerLabel },
    },
    {
      "@type": "SoftwareApplication",
      "name": modelB.name,
      "applicationCategory": "AI Model",
      "operatingSystem": "Cloud",
      "creator": { "@type": "Organization", "name": modelB.providerLabel },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
