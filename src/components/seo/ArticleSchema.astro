---
import { siteConfig } from '../../data/site.config';

export interface Props {
  title: string;
  description: string;
  image?: string;
  publishedDate: Date;
  updatedDate?: Date;
  authorName?: string;
  authorUrl?: string;
  canonicalUrl?: string;
}

const {
  title,
  description,
  image,
  publishedDate,
  updatedDate,
  authorName = siteConfig.author.name,
  authorUrl = siteConfig.author.linkedin,
  canonicalUrl,
} = Astro.props;

const siteUrl = siteConfig.url;
const pageUrl = canonicalUrl || Astro.url.href;
const imageUrl = image ? new URL(image, siteUrl).toString() : new URL(siteConfig.seo.ogImage, siteUrl).toString();

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": imageUrl,
  "datePublished": publishedDate.toISOString(),
  "dateModified": (updatedDate ?? publishedDate).toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": authorUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/logo.png', siteUrl).toString(),
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
