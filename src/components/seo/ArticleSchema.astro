---
import { siteConfig } from '../../data/site.config';
import type { GuideFormat } from '../editorial/model';

interface EvidenceSource {
  title: string;
  url: string;
}

interface EmbeddedVideo {
  youtubeId: string;
  title: string;
  description?: string;
  creatorName: string;
  creatorType: 'Person' | 'Organization';
  creatorUrl?: string;
  publishedAt?: Date;
  durationSeconds?: number;
}

export interface Props {
  title: string;
  description: string;
  image?: string;
  publishedDate: Date;
  updatedDate?: Date;
  authorName?: string;
  authorUrl?: string;
  authorType?: 'Person' | 'Organization';
  canonicalUrl?: string;
  format?: GuideFormat;
  learningOutcome?: string;
  evidenceSources?: EvidenceSource[];
  video?: EmbeddedVideo;
}

const {
  title,
  description,
  image,
  publishedDate,
  updatedDate,
  authorName = 'AIViewer',
  authorUrl = siteConfig.url,
  authorType = 'Organization',
  canonicalUrl,
  format,
  learningOutcome,
  evidenceSources = [],
  video,
} = Astro.props;

const siteUrl = siteConfig.url;
const pageUrl = canonicalUrl || Astro.url.href;
const imageUrl = image ? new URL(image, siteUrl).toString() : new URL(siteConfig.seo.ogImage, siteUrl).toString();
const articleId = `${pageUrl}#article`;
const videoId = `${pageUrl}#source-video`;

function secondsToIsoDuration(totalSeconds: number): string {
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;

  return `PT${hours ? `${hours}H` : ''}${minutes ? `${minutes}M` : ''}${seconds || (!hours && !minutes) ? `${seconds}S` : ''}`;
}

const isLearningResource = Boolean(format && format !== 'ai-signal');
const schemaType =
  format === 'ai-signal'
    ? 'NewsArticle'
    : isLearningResource
      ? ['Article', 'LearningResource']
      : 'Article';

const articleSchema = {
  "@type": schemaType,
  "@id": articleId,
  "headline": title,
  "name": title,
  "description": description,
  "image": imageUrl,
  "datePublished": publishedDate.toISOString(),
  "dateModified": (updatedDate ?? publishedDate).toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  "author": {
    "@type": authorType,
    "name": authorName,
    "url": authorUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": "AIViewer",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', siteUrl).toString(),
    },
  },
  ...(isLearningResource && {
    "learningResourceType":
      format === 'video-lesson'
        ? 'Video lesson'
        : format === 'practical-workflow'
          ? 'Practical guide'
          : 'Foundation guide',
    "educationalUse": format === 'practical-workflow' ? 'Practice' : 'Instruction',
    ...(learningOutcome ? { "teaches": learningOutcome } : {}),
  }),
  ...(evidenceSources.length > 0 && {
    "citation": evidenceSources.map((source) => ({
      "@type": "CreativeWork",
      "name": source.title,
      "url": source.url,
    })),
  }),
  ...(video ? {
    "video": { "@id": videoId },
    "isBasedOn": `https://www.youtube.com/watch?v=${video.youtubeId}`,
  } : {}),
};

const videoSchema = video ? {
  "@type": "VideoObject",
  "@id": videoId,
  "name": video.title,
  "description": video.description ?? `Source video for ${title}`,
  "url": `https://www.youtube.com/watch?v=${video.youtubeId}`,
  "embedUrl": `https://www.youtube-nocookie.com/embed/${video.youtubeId}?autoplay=0`,
  "creator": {
    "@type": video.creatorType,
    "name": video.creatorName,
    ...(video.creatorUrl ? { "url": video.creatorUrl } : {}),
  },
  "provider": {
    "@type": "Organization",
    "name": "YouTube",
    "url": "https://www.youtube.com/",
  },
  ...(video.publishedAt ? { "uploadDate": video.publishedAt.toISOString() } : {}),
  ...(video.durationSeconds ? { "duration": secondsToIsoDuration(video.durationSeconds) } : {}),
} : undefined;

const schema = {
  "@context": "https://schema.org",
  "@graph": videoSchema ? [articleSchema, videoSchema] : [articleSchema],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
