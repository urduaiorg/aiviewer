---
import { siteConfig } from '../../data/site.config';

export interface Props {
  itemName: string;
  itemImage?: string;
  description: string;
  reviewBody?: string;
  ratingValue: number;
  bestRating?: number;
  worstRating?: number;
  authorName?: string;
  authorUrl?: string;
  datePublished: Date;
  dateModified?: Date;
  aggregateRatingValue?: number;
  aggregateReviewCount?: number;
}

const {
  itemName,
  itemImage,
  description,
  reviewBody,
  ratingValue,
  bestRating = 5,
  worstRating = 1,
  authorName = siteConfig.author.name,
  authorUrl = siteConfig.author.linkedin,
  datePublished,
  dateModified,
  aggregateRatingValue,
  aggregateReviewCount = 1,
} = Astro.props;

const siteUrl = siteConfig.url;
const imageUrl = itemImage ? new URL(itemImage, siteUrl).toString() : new URL(siteConfig.seo.ogImage, siteUrl).toString();

const schema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "SoftwareApplication",
    "name": itemName,
    "image": imageUrl,
    "description": description,
    "applicationCategory": "BusinessApplication",
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": ratingValue.toString(),
    "bestRating": bestRating.toString(),
    "worstRating": worstRating.toString(),
  },
  "name": `Review of ${itemName}`,
  ...(reviewBody && { "reviewBody": reviewBody }),
  ...(aggregateRatingValue && {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": aggregateRatingValue.toString(),
      "bestRating": bestRating.toString(),
      "worstRating": worstRating.toString(),
      "reviewCount": aggregateReviewCount.toString(),
    },
  }),
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": authorUrl,
  },
  "datePublished": datePublished.toISOString(),
  "dateModified": (dateModified ?? datePublished).toISOString(),
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "url": siteUrl,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
