---
/**
 * Search — Trigger button for the SearchDialog modal
 *
 * Renders a search icon button with a Cmd+K hint on desktop.
 * Clicking opens the SearchDialog via the global __openSearchDialog().
 * The SearchDialog component must be rendered once separately
 * (in Header.astro or BaseLayout.astro) to avoid duplicate IDs.
 */
---

<!-- Search trigger button -->
<div class="search-trigger-wrap flex items-center">
  <button
    class="search-trigger-btn flex items-center gap-2 p-2 rounded-full text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors"
    aria-label="Search (Cmd+K)"
    type="button"
  >
    <svg class="w-[1.15rem] h-[1.15rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <!-- Cmd+K hint — desktop only -->
    <span class="hidden lg:inline-flex items-center gap-0.5 text-[0.65rem] font-medium text-zinc-400 dark:text-zinc-500 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-md px-1.5 py-0.5 leading-none">
      <span class="search-shortcut-symbol">&#8984;</span>K
    </span>
  </button>
</div>

<script>
  function initSearchTrigger() {
    const triggers = document.querySelectorAll('.search-trigger-btn');
    triggers.forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.searchBound === 'true') return;
      el.dataset.searchBound = 'true';

      el.addEventListener('click', () => {
        if (typeof (window as any).__openSearchDialog === 'function') {
          (window as any).__openSearchDialog();
        }
      });
    });

    // Detect Mac vs Windows for shortcut symbol
    const isMac = navigator.platform?.toUpperCase().includes('MAC') ||
                  (navigator as any).userAgentData?.platform?.toUpperCase().includes('MAC');
    document.querySelectorAll('.search-shortcut-symbol').forEach((el) => {
      (el as HTMLElement).textContent = isMac ? '\u2318' : 'Ctrl+';
    });
  }

  initSearchTrigger();
  document.addEventListener('astro:page-load', initSearchTrigger);
</script>
