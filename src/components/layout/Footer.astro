---
import { siteConfig } from '../../data/site.config';

const year = new Date().getFullYear();
const contentLinks = siteConfig.nav.footer.content;
const resourceLinks = siteConfig.nav.footer.resources;
const socialLinks = siteConfig.nav.footer.social;

/**
 * Map social platform labels to inline SVG paths.
 * Each icon is a 20x20 viewBox for consistent sizing.
 */
const socialIcons: Record<string, string> = {
  LinkedIn:
    '<path fill="currentColor" d="M4.94 2.5A1.75 1.75 0 0 0 3.19 4.25 1.75 1.75 0 0 0 4.94 6a1.75 1.75 0 0 0 1.75-1.75A1.75 1.75 0 0 0 4.94 2.5ZM3.25 7.5h3.38v10H3.25v-10Zm5.62 0h3.24v1.37h.05A3.55 3.55 0 0 1 15.36 7.3c3.41 0 4.04 2.24 4.04 5.16v5.94h-3.37v-5.27c0-1.26-.02-2.87-1.75-2.87-1.75 0-2.02 1.37-2.02 2.78v5.36H8.87V7.5Z"/>',
  'X / Twitter':
    '<path fill="currentColor" d="M12.6 9.2 18.49 2.5h-1.4l-5.1 5.82L7.55 2.5H2.5l6.17 8.8L2.5 18.5h1.4l5.39-6.15 4.3 6.15h5.06L12.6 9.2Zm-1.91 2.18-.62-.88L4.4 3.56h2.14l4 5.62.63.88 5.26 7.38h-2.14l-4.29-6.06Z"/>',
  Facebook:
    '<path fill="currentColor" d="M18 2H2v16h8.5v-6.2H8.34V9.69h2.16V8a3.08 3.08 0 0 1 3.29-3.38c.94 0 1.74.07 1.97.1v2.25h-1.35c-1.06 0-1.27.5-1.27 1.25v1.47h2.54l-.33 2.12h-2.21V18H18V2Z"/>',
};
---

<footer class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[var(--color-bg)]" slot="footer">
  <div class="page-container py-14">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="inline-flex items-baseline" style="font-family: 'Montserrat', sans-serif;">
          <span class="text-[1.2rem] font-extrabold" style="color: #F0C75E; letter-spacing: -0.02em;">AI</span>
          <span class="text-[1.2rem] font-extrabold text-zinc-900 dark:text-white" style="letter-spacing: -0.02em;">Viewer</span>
        </a>
        <p class="mt-3 text-[0.8rem] text-zinc-400 leading-relaxed max-w-[220px]">
          {siteConfig.tagline} No jargon, no hype.
        </p>
        <!-- Social icons row -->
        <div class="mt-4 flex items-center gap-3">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors duration-200"
              aria-label={link.label}
            >
              <svg class="w-[1.1rem] h-[1.1rem]" viewBox="0 0 20 20" fill="none" set:html={socialIcons[link.label] || ''} />
            </a>
          ))}
          <a
            href="/rss.xml"
            class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors duration-200"
            aria-label="RSS Feed"
          >
            <svg class="w-[1.1rem] h-[1.1rem]" viewBox="0 0 20 20" fill="none">
              <path fill="currentColor" d="M3.5 14.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM2 2v2.5a13.5 13.5 0 0 1 13.5 13.5H18A16 16 0 0 0 2 2Zm0 5v2.5a8.5 8.5 0 0 1 8.5 8.5H13A11 11 0 0 0 2 7Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Content -->
      <div>
        <h4 class="text-[0.7rem] font-semibold text-zinc-400 uppercase tracking-wider mb-4">Content</h4>
        <nav class="flex flex-col gap-2.5">
          {contentLinks.map((link) => (
            <a
              href={link.href}
              class="text-[0.84rem] text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:translate-x-0.5 transition-[color,transform] duration-200"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-[0.7rem] font-semibold text-zinc-400 uppercase tracking-wider mb-4">Resources</h4>
        <nav class="flex flex-col gap-2.5">
          {resourceLinks.map((link) => (
            <a
              href={link.href}
              class="text-[0.84rem] text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:translate-x-0.5 transition-[color,transform] duration-200"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Connect -->
      <div>
        <h4 class="text-[0.7rem] font-semibold text-zinc-400 uppercase tracking-wider mb-4">Connect</h4>
        <nav class="flex flex-col gap-2.5">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-[0.84rem] text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:translate-x-0.5 transition-[color,transform] duration-200"
            >
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="none" set:html={socialIcons[link.label] || ''} />
              {link.label}
            </a>
          ))}
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-2 text-[0.84rem] text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:translate-x-0.5 transition-[color,transform] duration-200"
          >
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="none">
              <path fill="currentColor" d="M3.5 14.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM2 2v2.5a13.5 13.5 0 0 1 13.5 13.5H18A16 16 0 0 0 2 2Zm0 5v2.5a8.5 8.5 0 0 1 8.5 8.5H13A11 11 0 0 0 2 7Z"/>
            </svg>
            RSS Feed
          </a>
        </nav>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-6 border-t border-zinc-100 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-[0.75rem] text-zinc-400">
        &copy; {year} {siteConfig.name} &middot; Part of the <a href={siteConfig.network.url} target="_blank" rel="noopener" class="inline-flex items-baseline" style="font-family: 'Montserrat', sans-serif;"><span class="font-bold text-zinc-600 dark:text-zinc-300">{siteConfig.network.name.replace('AI', '')}</span><span class="font-bold" style="color: #F0C75E;">AI</span></a> network
      </p>
      <p class="text-[0.75rem] text-zinc-300 dark:text-zinc-600">
        {siteConfig.network.communitySize} community &middot; AI literacy for everyone
      </p>
    </div>
  </div>
</footer>
