---
import Search from './Search.astro';
import SearchDialog from '../content/SearchDialog.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../../data/site.config';

const navItems = siteConfig.nav.main;
const currentPath = Astro.url.pathname;
---

<header class="editorial-header" slot="header">
  <div class="editorial-header__inner">
    <a href="/" class="editorial-logo" aria-label="AIViewer home">
      <span class="editorial-logo__ai">AI</span><span class="editorial-logo__viewer">Viewer</span>
    </a>

    <nav class="editorial-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
          class="editorial-nav__link"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="editorial-header__actions">
      <Search />
      <ThemeToggle />
      <a
        href={siteConfig.nav.cta.href}
        class="editorial-header__cta"
        aria-current={currentPath.startsWith(siteConfig.nav.cta.href) ? 'page' : undefined}
      >
        {siteConfig.nav.cta.label}
      </a>
    </div>

    <div class="editorial-header__mobile-actions">
      <Search />
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="editorial-menu-button"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path class="hamburger-top" d="M4 7h16" />
          <path class="hamburger-mid" d="M4 12h16" />
          <path class="hamburger-bot" d="M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu-container" aria-hidden="true">
  <div id="mobile-menu-backdrop" class="mobile-menu-backdrop"></div>
  <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Site navigation">
    <div class="mobile-menu-panel__top">
      <a href="/" class="editorial-logo" aria-label="AIViewer home">
        <span class="editorial-logo__ai">AI</span><span class="editorial-logo__viewer">Viewer</span>
      </a>
      <button id="mobile-menu-close" class="editorial-menu-close" type="button" aria-label="Close menu">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <nav class="mobile-menu-nav" aria-label="Mobile navigation">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
          class="mobile-menu-nav__link"
        >
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))}
      <a
        href={siteConfig.nav.cta.href}
        class="mobile-menu-nav__cta"
        aria-current={currentPath.startsWith(siteConfig.nav.cta.href) ? 'page' : undefined}
      >
        {siteConfig.nav.cta.label}
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 10h11M11 6l4 4-4 4" />
        </svg>
      </a>
    </nav>
  </div>
</div>

<SearchDialog />

<style>
  .editorial-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid #e7e5e2;
    background: rgb(255 255 255 / 0.96);
    color: #11110f;
    backdrop-filter: blur(14px);
  }

  .editorial-header__inner {
    display: flex;
    align-items: center;
    width: min(100% - 3rem, 1200px);
    height: 4rem;
    margin-inline: auto;
  }

  .editorial-logo {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: baseline;
    color: inherit;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.55rem;
    font-weight: 780;
    letter-spacing: -0.055em;
    line-height: 1;
    text-decoration: none;
  }

  .editorial-logo__ai {
    color: #d88a00;
  }

  .editorial-logo__viewer {
    color: #11110f;
  }

  .editorial-nav {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: clamp(0.15rem, 0.8vw, 0.85rem);
    margin-inline: auto;
    align-self: stretch;
  }

  .editorial-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-inline: clamp(0.42rem, 0.75vw, 0.75rem);
    color: #383733;
    font-size: 0.78rem;
    font-weight: 530;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .editorial-nav__link::after {
    position: absolute;
    right: 0.5rem;
    bottom: -1px;
    left: 0.5rem;
    height: 2px;
    background: #d88a00;
    content: '';
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .editorial-nav__link:hover,
  .editorial-nav__link[aria-current='page'] {
    color: #11110f;
  }

  .editorial-nav__link:hover::after,
  .editorial-nav__link[aria-current='page']::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .editorial-header__actions,
  .editorial-header__mobile-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.1rem;
  }

  .editorial-header__mobile-actions {
    display: none;
  }

  .editorial-header__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    margin-left: 0.65rem;
    padding: 0.68rem 1.05rem;
    border: 1px solid #11110f;
    border-radius: 2px;
    background: #11110f;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }

  .editorial-header__cta:hover {
    border-color: #34332f;
    background: #34332f;
    transform: translateY(-1px);
  }

  .editorial-header :global(.search-trigger-btn > span) {
    display: none;
  }

  .editorial-header :global(.search-trigger-btn),
  .editorial-header :global(.theme-toggle-btn) {
    border-radius: 2px;
  }

  .editorial-menu-button,
  .editorial-menu-close {
    display: inline-grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .editorial-menu-button svg,
  .editorial-menu-close svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  .mobile-menu-container {
    position: fixed;
    inset: 0;
    z-index: 60;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-menu-container.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0);
    backdrop-filter: blur(0);
    transition: background 240ms ease, backdrop-filter 240ms ease;
  }

  .mobile-menu-container.is-open .mobile-menu-backdrop {
    background: rgb(0 0 0 / 0.28);
    backdrop-filter: blur(3px);
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(88vw, 22rem);
    height: 100%;
    border-left: 1px solid #dedbd6;
    background: #fff;
    color: #11110f;
    box-shadow: -18px 0 50px rgb(0 0 0 / 0.1);
    transform: translateX(100%);
    transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .mobile-menu-container.is-open .mobile-menu-panel {
    transform: translateX(0);
  }

  .mobile-menu-panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding-inline: 1.25rem;
    border-bottom: 1px solid #e7e5e2;
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }

  .mobile-menu-nav__link {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    min-height: 3.65rem;
    border-bottom: 1px solid #eceae7;
    color: #171714;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .mobile-menu-nav__link > span {
    color: #c17800;
    font-family: 'Inter', sans-serif;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .mobile-menu-nav__link[aria-current='page'] {
    color: #312e81;
  }

  .mobile-menu-nav__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid #11110f;
    border-radius: 2px;
    background: #11110f;
    color: #fff;
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
  }

  .mobile-menu-nav__cta svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  :global([data-theme='dark']) .editorial-header {
    border-color: #2c2c2b;
    background: rgb(10 10 10 / 0.96);
    color: #f5f4ef;
  }

  :global([data-theme='dark']) .editorial-logo__viewer {
    color: #f5f4ef;
  }

  :global([data-theme='dark']) .editorial-logo__ai {
    color: #f0b84b;
  }

  :global([data-theme='dark']) .editorial-nav__link {
    color: #b8b6af;
  }

  :global([data-theme='dark']) .editorial-nav__link:hover,
  :global([data-theme='dark']) .editorial-nav__link[aria-current='page'] {
    color: #fff;
  }

  :global([data-theme='dark']) .editorial-header__cta {
    border-color: #f4f2ec;
    background: #f4f2ec;
    color: #11110f;
  }

  :global([data-theme='dark']) .mobile-menu-panel {
    border-color: #2c2c2b;
    background: #0d0d0d;
    color: #f5f4ef;
  }

  :global([data-theme='dark']) .mobile-menu-panel__top,
  :global([data-theme='dark']) .mobile-menu-nav__link {
    border-color: #292927;
  }

  :global([data-theme='dark']) .mobile-menu-nav__link {
    color: #f5f4ef;
  }

  :global([data-theme='dark']) .mobile-menu-nav__link[aria-current='page'] {
    color: #c7d2fe;
  }

  .editorial-logo:focus-visible,
  .editorial-nav__link:focus-visible,
  .editorial-header__cta:focus-visible,
  .editorial-menu-button:focus-visible,
  .editorial-menu-close:focus-visible,
  .mobile-menu-nav__link:focus-visible,
  .mobile-menu-nav__cta:focus-visible {
    outline: 3px solid #e6a01d;
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .editorial-header__inner {
      width: min(100% - 2rem, 1200px);
    }

    .editorial-nav {
      gap: 0;
    }

    .editorial-nav__link {
      padding-inline: 0.45rem;
      font-size: 0.72rem;
    }

    .editorial-header__cta {
      margin-left: 0.35rem;
      padding-inline: 0.75rem;
      font-size: 0.72rem;
    }
  }

  @media (max-width: 760px) {
    .editorial-header__inner {
      width: min(100% - 1.5rem, 1200px);
      height: 4rem;
    }

    .editorial-logo {
      font-size: 1.35rem;
    }

    .editorial-nav,
    .editorial-header__actions {
      display: none;
    }

    .editorial-header__mobile-actions {
      display: flex;
      margin-left: auto;
    }

    .mobile-menu-panel__top {
      height: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-nav__link::after,
    .editorial-header__cta,
    .mobile-menu-backdrop,
    .mobile-menu-panel {
      transition: none;
    }
  }
</style>

<script>
  function createFocusTrap(container: HTMLElement): () => void {
    const selector = 'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

    function handleKeydown(event: KeyboardEvent) {
      if (event.key !== 'Tab') return;

      const focusable = Array.from(container.querySelectorAll<HTMLElement>(selector))
        .filter((element) => element.offsetParent !== null);
      if (!focusable.length) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    document.addEventListener('keydown', handleKeydown);
    return () => document.removeEventListener('keydown', handleKeydown);
  }

  (window as any).__createFocusTrap = createFocusTrap;

  function initMobileMenu() {
    const button = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const closeButton = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const panel = menu?.querySelector<HTMLElement>('.mobile-menu-panel');

    if (!button || !menu || !panel || button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';

    let releaseFocusTrap: (() => void) | null = null;

    function openMenu() {
      menu?.classList.add('is-open');
      menu?.setAttribute('aria-hidden', 'false');
      button?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      releaseFocusTrap = createFocusTrap(panel!);
      closeButton?.focus();
    }

    function closeMenu({ returnFocus = true } = {}) {
      menu?.classList.remove('is-open');
      menu?.setAttribute('aria-hidden', 'true');
      button?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      releaseFocusTrap?.();
      releaseFocusTrap = null;
      if (returnFocus) button?.focus();
    }

    button.addEventListener('click', openMenu);
    closeButton?.addEventListener('click', () => closeMenu());
    backdrop?.addEventListener('click', () => closeMenu());
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu({ returnFocus: false }));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        closeMenu();
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
