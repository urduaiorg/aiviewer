---
import '../styles/global.css';
import '../styles/print.css';
import { ViewTransitions } from 'astro:transitions';
import ScrollReveal from '../components/layout/ScrollReveal.astro';
import WebVitals from '../components/layout/WebVitals.astro';
import EngagementTracker from '../components/layout/EngagementTracker.astro';
import { siteConfig } from '../data/site.config';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  updatedDate?: string;
  articleSection?: string;
  noindex?: boolean;
  monetize?: boolean;
}

const {
  title,
  description,
  ogImage = siteConfig.seo.ogImage,
  canonicalUrl,
  type = 'website',
  publishedDate,
  updatedDate,
  articleSection,
  noindex = false,
  monetize = false,
} = Astro.props;

const fullTitle = title === siteConfig.name ? title : `${title} — ${siteConfig.name}`;
const canonical = canonicalUrl || Astro.url.href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en" data-pagefind-ignore={noindex ? 'all' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href="/rss.xml" />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    }
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#F0C75E" />
    <script is:inline>
      // Early inline script to prevent flash of wrong theme (runs on initial page load)
      (function() {
        var isDark = localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        if (isDark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      })();
      // Also run on View Transitions swap to maintain theme across navigation
      document.addEventListener('astro:after-swap', function() {
        var isDark = localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        if (isDark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      });
    </script>

    <!-- Favicon & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- DNS-prefetch for analytics CDN -->
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

    <!-- Fonts: Self-hosted Inter (body) + Inter Tight (headings) + Montserrat (logo) -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter Tight';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-tight-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Montserrat';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/montserrat-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>

    <!-- OpenGraph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={siteConfig.seo.ogImageWidth.toString()} />
    <meta property="og:image:height" content={siteConfig.seo.ogImageHeight.toString()} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content={siteConfig.seo.twitterCard} />
    <meta name="twitter:site" content="@QRoonjha" />
    <meta name="twitter:creator" content="@QRoonjha" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Article metadata (if article) -->
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
    {articleSection && <meta property="article:section" content={articleSection} />}

    <!-- Google Search Console -->
    {siteConfig.analytics.googleSiteVerification && <meta name="google-site-verification" content={siteConfig.analytics.googleSiteVerification} />}

    <!-- Google AdSense site verification and ad serving -->
    {siteConfig.monetization.adsenseClient && monetize && !noindex && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.monetization.adsenseClient}`} crossorigin="anonymous"></script>
    )}

    <!-- Schema: Website (homepage) or overridden by page-level components -->
    <slot name="head" />

    <!-- View Transitions for smooth page navigation -->
    <ViewTransitions />

    <!-- Cloudflare Web Analytics -->
    {siteConfig.analytics.cloudflareToken && (
      <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon={`{"token": "${siteConfig.analytics.cloudflareToken}"}`} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-indigo-600 focus:text-white focus:rounded-lg focus:text-sm focus:font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2">Skip to content</a>
    <slot name="header" />
    <div id="main-content" class="flex-1" transition:animate="fade">
      <slot />
    </div>
    <slot name="footer" />
    <ScrollReveal />
    <WebVitals />
    <EngagementTracker />
    <script>
      // Card glow — cursor-tracking radial highlight
      function initCardGlow() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll('.card-glow').forEach((card) => {
          card.addEventListener('mousemove', (e: Event) => {
            const el = card as HTMLElement;
            const rect = el.getBoundingClientRect();
            const me = e as MouseEvent;
            el.style.setProperty('--glow-x', `${me.clientX - rect.left}px`);
            el.style.setProperty('--glow-y', `${me.clientY - rect.top}px`);
          });
        });
      }
      initCardGlow();
      document.addEventListener('astro:page-load', initCardGlow);
    </script>
  </body>
</html>
